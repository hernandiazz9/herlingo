  "voice": "ru-RU-DmitryNeural",
  "sentences": [
    { "id": "s1", "text": "А́ня живёт в це́нтре Петербу́рга.", "es": "Ania vive en el centro de San Petersburgo." },
    { "id": "s2", "text": "У неё ма́ленькая кварти́ра в ста́ром до́ме.", "es": "Tiene un piso pequeño en un edificio antiguo." },
    { "id": "s3", "text": "Кварти́ра на тре́тьем этаже́, а ли́фта нет.", "es": "El piso está en la tercera planta y no hay ascensor." },
    { "id": "s4", "text": "Ди́ма несёт наве́рх большо́й чемода́н Луси́и.", "es": "Dima sube la maleta grande de Lucía." },
    { "id": "s5", "text": "«Проходи́, Луси́я! Чу́вствуй себя́ как до́ма!»", "es": "«¡Pasa, Lucía! ¡Siéntete como en casa!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s6", "text": "«Вот ку́хня, а вот ва́нная.»", "es": "«Aquí está la cocina, y aquí el cuarto de baño.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s7", "text": "«А э́то твоя́ ко́мната.»", "es": "«Y esta es tu habitación.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s8", "text": "В ко́мнате есть крова́ть, стол и большо́е окно́.", "es": "En la habitación hay una cama, una mesa y una ventana grande." },
    { "id": "s9", "text": "Из окна́ видна́ река́.", "es": "Desde la ventana se ve el río." },
    { "id": "s10", "text": "«Как краси́во! Спаси́бо, А́ня!»", "es": "«¡Qué bonito! ¡Gracias, Ania!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s11", "text": "Пото́м кто́-то звони́т в дверь.", "es": "Luego alguien llama a la puerta." },
    { "id": "s12", "text": "Э́то сосе́дка, Ве́ра Петро́вна.", "es": "Es la vecina, Vera Petrovna." },
    { "id": "s13", "text": "Она́ учи́тельница на пе́нсии и живёт одна́.", "es": "Es profesora jubilada y vive sola." },
    { "id": "s14", "text": "«Здра́вствуйте! Вы Луси́я? О́чень прия́тно!»", "es": "«¡Buenas! ¿Usted es Lucía? ¡Encantada!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s15", "text": "«Мне то́же, Ве́ра Петро́вна!»", "es": "«¡Igualmente, Vera Petrovna!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s16", "text": "В рука́х у Ве́ры Петро́вны большо́й пиро́г.", "es": "Vera Petrovna lleva en las manos una tarta grande." },
    { "id": "s17", "text": "«Э́то вам. Пиро́г с я́блоками!»", "es": "«Es para vosotras. ¡Tarta de manzana!»", "voice": "ru-RU-SvetlanaNeural" }
