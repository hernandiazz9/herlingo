  "sentences": [
    { "id": "s1", "text": "У́тро. Луси́я встаёт в во́семь часо́в.", "es": "Es por la mañana. Lucía se levanta a las ocho." },
    { "id": "s2", "text": "На ку́хне А́ня уже́ гото́вит за́втрак.", "es": "En la cocina, Ania ya está preparando el desayuno." },
    { "id": "s3", "text": "На столе́ хлеб, сыр, мёд и блины́.", "es": "En la mesa hay pan, queso, miel y blinis." },
    { "id": "s4", "text": "«До́брое у́тро! Ты пьёшь ко́фе и́ли чай?»", "es": "«¡Buenos días! ¿Tomas café o té?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s5", "text": "«Ко́фе с молоко́м, пожа́луйста. Без са́хара.»", "es": "«Café con leche, por favor. Sin azúcar.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s6", "text": "Пото́м на ку́хню прихо́дит Ди́ма.", "es": "Luego Dima entra en la cocina." },
    { "id": "s7", "text": "«О, блины́! Я о́чень люблю́ блины́!»", "es": "«¡Anda, blinis! ¡Me encantan los blinis!»" },
    { "id": "s8", "text": "Ди́ма ест блины́ со сме́таной.", "es": "Dima come blinis con nata agria." },
    { "id": "s9", "text": "Луси́я про́бует блин с мёдом.", "es": "Lucía prueba un blini con miel." },
    { "id": "s10", "text": "«О́чень вку́сно! В Испа́нии мы обы́чно еди́м тост с тома́том.»", "es": "«¡Está muy rico! En España solemos comer tostada con tomate.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s11", "text": "«Что вы де́лаете сего́дня?»", "es": "«¿Qué hacéis hoy?»" },
    { "id": "s12", "text": "«Мы е́дем в центр на метро́.»", "es": "«Vamos al centro en metro.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "«А я рабо́таю. Сего́дня суббо́та, и в такси́ мно́го рабо́ты.»", "es": "«Pues yo trabajo. Hoy es sábado y en el taxi hay mucho trabajo.»" },
    { "id": "s14", "text": "Ди́ма пьёт чай и бы́стро ухо́дит.", "es": "Dima se toma un té y se va enseguida." },
    { "id": "s15", "text": "«Пока́, де́вочки! Хоро́шего дня!»", "es": "«¡Hasta luego, chicas! ¡Que tengáis un buen día!»" }
