  "sentences": [
    { "id": "s1", "text": "В воскресе́нье Ве́ра Петро́вна идёт на ры́нок.", "es": "El domingo, Vera Petrovna va al mercado." },
    { "id": "s2", "text": "Луси́я идёт с ней, потому́ что она́ лю́бит ры́нки.", "es": "Lucía va con ella porque le encantan los mercados." },
    { "id": "s3", "text": "На ры́нке мно́го фру́ктов и овоще́й.", "es": "En el mercado hay mucha fruta y verdura." },
    { "id": "s4", "text": "Там продаю́т мёд, сыр, ры́бу и цветы́.", "es": "Allí venden miel, queso, pescado y flores." },
    { "id": "s5", "text": "Ве́ра Петро́вна покупа́ет помидо́ры и огурцы́.", "es": "Vera Petrovna compra tomates y pepinos." },
    { "id": "s6", "text": "«Огурцы́ све́жие?»", "es": "«¿Los pepinos son frescos?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s7", "text": "«Коне́чно! Всё све́жее, всё с да́чи!»", "es": "«¡Claro! ¡Todo fresco, todo de la casa de campo!»" },
    { "id": "s8", "text": "Пото́м Луси́я ви́дит кра́сную клубни́ку.", "es": "Luego Lucía ve unas fresas rojas." },
    { "id": "s9", "text": "«Извини́те, почём клубни́ка?»", "es": "«Perdone, ¿a cuánto están las fresas?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s10", "text": "«Пятьсо́т рубле́й килогра́мм.»", "es": "«A quinientos rublos el kilo.»" },
    { "id": "s11", "text": "«Мо́жно попро́бовать?»", "es": "«¿Puedo probarlas?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s12", "text": "«Коне́чно, пожа́луйста!»", "es": "«¡Claro, adelante!»" },
    { "id": "s13", "text": "Клубни́ка о́чень сла́дкая и вку́сная.", "es": "Las fresas están muy dulces y ricas." },
    { "id": "s14", "text": "«Полкило́ клубни́ки, пожа́луйста.»", "es": "«Medio kilo de fresas, por favor.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s15", "text": "«Что́-нибудь ещё?»", "es": "«¿Algo más?»" },
    { "id": "s16", "text": "«Нет, э́то всё. Спаси́бо!»", "es": "«No, eso es todo. ¡Gracias!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s17", "text": "Ве́ра Петро́вна смо́трит на Луси́ю и улыба́ется.", "es": "Vera Petrovna mira a Lucía y sonríe." },
    { "id": "s18", "text": "«Молоде́ц, Луси́я! Ты уже́ хорошо́ говори́шь по-ру́сски!»", "es": "«¡Muy bien, Lucía! ¡Ya hablas bien ruso!»", "voice": "ru-RU-SvetlanaNeural" }
  ],
