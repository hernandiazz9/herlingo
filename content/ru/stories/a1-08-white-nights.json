  "sentences": [
    { "id": "s1", "text": "В Петербу́рге ле́том бе́лые но́чи.", "es": "En verano, en San Petersburgo hay noches blancas." },
    { "id": "s2", "text": "Да́же но́чью на у́лице светло́.", "es": "Incluso de noche, en la calle hay luz." },
    { "id": "s3", "text": "Ве́чером Ди́ма и Луси́я гуля́ют по на́бережной.", "es": "Por la noche, Dima y Lucía pasean por el paseo junto al río." },
    { "id": "s4", "text": "«Смотри́, вот Нева́! Э́то са́мая краси́вая река́ в Росси́и.»", "es": "«¡Mira, ahí está el Nevá! Es el río más bonito de Rusia.»" },
    { "id": "s5", "text": "«Како́й краси́вый го́род!»", "es": "«¡Qué ciudad tan bonita!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s6", "text": "На на́бережной мно́го люде́й: тури́сты, студе́нты, музыка́нты.", "es": "En el paseo hay mucha gente: turistas, estudiantes, músicos." },
    { "id": "s7", "text": "Кто́-то игра́ет на гита́ре.", "es": "Alguien toca la guitarra." },
    { "id": "s8", "text": "«Ди́ма, кото́рый час?»", "es": "«Dima, ¿qué hora es?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s9", "text": "«Уже́ час но́чи. Сейча́с бу́дет са́мое интере́сное!»", "es": "«Ya es la una de la madrugada. ¡Ahora viene lo más interesante!»" },
    { "id": "s10", "text": "Но́чью мосты́ на Неве́ разво́дят.", "es": "De noche, los puentes del Nevá se levantan." },
    { "id": "s11", "text": "Большо́й мост ме́дленно поднима́ется.", "es": "Un puente grande sube despacio." },
    { "id": "s12", "text": "По реке́ иду́т корабли́.", "es": "Por el río pasan barcos." },
    { "id": "s13", "text": "«Э́то как в ска́зке!»", "es": "«¡Es como en un cuento!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s14", "text": "«Да, но тепе́рь мы до утра́ на э́той стороне́ реки́!»", "es": "«Sí, ¡pero ahora nos quedamos en este lado del río hasta la mañana!»" },
    { "id": "s15", "text": "«Ничего́ стра́шного! Гуля́ем да́льше.»", "es": "«¡No pasa nada! Seguimos paseando.»", "voice": "ru-RU-SvetlanaNeural" }
  ],
