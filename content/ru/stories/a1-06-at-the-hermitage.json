  "sentences": [
    { "id": "s1", "text": "А́ня рабо́тает в Эрмита́же. Она́ экскурсово́д.", "es": "Ania trabaja en el Hermitage. Es guía." },
    { "id": "s2", "text": "Сего́дня Луси́я идёт к ней на рабо́ту.", "es": "Hoy Lucía va a verla al trabajo." },
    { "id": "s3", "text": "Эрмита́ж — э́то большо́й зелёный дворе́ц на Неве́.", "es": "El Hermitage es un gran palacio verde junto al Neva." },
    { "id": "s4", "text": "У вхо́да мно́го тури́стов.", "es": "En la entrada hay muchos turistas." },
    { "id": "s5", "text": "Луси́я идёт в ка́ссу.", "es": "Lucía va a la taquilla." },
    { "id": "s6", "text": "«Оди́н взро́слый биле́т, пожа́луйста.»", "es": "«Una entrada de adulto, por favor.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s7", "text": "«Вот ваш биле́т. Гардеро́б спра́ва.»", "es": "«Aquí tiene su entrada. El guardarropa está a la derecha.»" },
    { "id": "s8", "text": "Луси́я сдаёт ку́ртку в гардеро́б.", "es": "Lucía deja la chaqueta en el guardarropa." },
    { "id": "s9", "text": "Пото́м А́ня пока́зывает ей карти́ны.", "es": "Luego Ania le enseña los cuadros." },
    { "id": "s10", "text": "«Смотри́! Э́то Рембра́ндт, а э́то Леона́рдо да Ви́нчи.»", "es": "«¡Mira! Esto es un Rembrandt, y esto, un Leonardo da Vinci.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s11", "text": "В за́лах мно́го люде́й, все фотографи́руют.", "es": "En las salas hay mucha gente y todos hacen fotos." },
    { "id": "s12", "text": "«Здесь мо́жно фотографи́ровать?»", "es": "«¿Se pueden hacer fotos aquí?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "«Да, мо́жно, но без вспы́шки.»", "es": "«Sí, se puede, pero sin flash.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s14", "text": "Они́ гуля́ют по за́лам три часа́.", "es": "Pasean por las salas durante tres horas." },
    { "id": "s15", "text": "«Э́то о́чень интере́сно! Но я уже́ немно́го устаю́.»", "es": "«¡Es muy interesante! Pero ya me estoy cansando un poco.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s16", "text": "«Тогда́ пойдём в кафе́! Здесь ря́дом есть хоро́шее.»", "es": "«¡Pues vamos a una cafetería! Aquí al lado hay una buena.»", "voice": "ru-RU-SvetlanaNeural" }
