  "sentences": [
    { "id": "s1", "text": "В воскресе́нье ве́чером Луси́я звони́т ма́ме в Севи́лью.", "es": "El domingo por la noche, Lucía llama a su madre a Sevilla." },
    { "id": "s2", "text": "«Приве́т, до́чка! Как прошла́ неде́ля?»", "es": "«¡Hola, hija! ¿Qué tal ha ido la semana?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s3", "text": "«Ма́ма, неде́ля была́ о́чень интере́сная!»", "es": "«¡Mamá, ha sido una semana muy interesante!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s4", "text": "«В понеде́льник я была́ в Эрмита́же.»", "es": "«El lunes estuve en el Hermitage.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s5", "text": "«Во вто́рник мы с А́ней пи́ли ко́фе на Не́вском.»", "es": "«El martes Ania y yo tomamos café en la Nevski.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s6", "text": "«В сре́ду я заболе́ла, но Ве́ра Петро́вна мне помогла́.»", "es": "«El miércoles me puse enferma, pero Vera Petrovna me ayudó.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s7", "text": "«В четве́рг я це́лый день спала́.»", "es": "«El jueves me pasé el día entero durmiendo.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s8", "text": "«А в пя́тницу мы с Ди́мой гуля́ли но́чью и смотре́ли мосты́.»", "es": "«Y el viernes Dima y yo paseamos de noche y vimos los puentes.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s9", "text": "«В суббо́ту мы е́здили на да́чу.»", "es": "«El sábado fuimos a la dacha.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s10", "text": "«А ты говори́шь по-ру́сски?»", "es": "«¿Y hablas ruso?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s11", "text": "«Да! Я уже́ мно́го понима́ю.»", "es": "«¡Sí! Ya entiendo mucho.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s12", "text": "«Вчера́ я сама́ купи́ла биле́ты в теа́тр.»", "es": "«Ayer compré yo sola las entradas del teatro.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "«Молоде́ц! Я тобо́й горжу́сь. Когда́ ты прилета́ешь?»", "es": "«¡Muy bien! Estoy orgullosa de ti. ¿Cuándo vuelves?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s14", "text": "«За́втра. Мне здесь о́чень нра́вится, но я скуча́ю по тебе́!»", "es": "«Mañana. Aquí estoy encantada, ¡pero te echo de menos!»", "voice": "ru-RU-SvetlanaNeural" }
  ],
