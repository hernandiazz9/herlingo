  "sentences": [
    { "id": "s1", "text": "У́тром Луси́я пло́хо себя́ чу́вствует.", "es": "Por la mañana, Lucía se encuentra mal." },
    { "id": "s2", "text": "У неё боли́т голова́ и го́рло.", "es": "Le duelen la cabeza y la garganta." },
    { "id": "s3", "text": "А́ня на рабо́те, а Ди́ма в университе́те.", "es": "Ania está en el trabajo y Dima, en la universidad." },
    { "id": "s4", "text": "В дверь звони́т Ве́ра Петро́вна.", "es": "Llaman a la puerta: es Vera Petrovna." },
    { "id": "s5", "text": "«Луси́я, что с тобо́й? Ты о́чень бле́дная.»", "es": "«Lucía, ¿qué te pasa? Estás muy pálida.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s6", "text": "«Я, ка́жется, простуди́лась. У меня́ на́сморк и ка́шель.»", "es": "«Creo que me he resfriado. Tengo mocos y tos.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s7", "text": "«А температу́ра есть?»", "es": "«¿Y tienes fiebre?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s8", "text": "Ве́ра Петро́вна прино́сит гра́дусник.", "es": "Vera Petrovna trae el termómetro." },
    { "id": "s9", "text": "«Три́дцать семь и пять. Пойдём в апте́ку!»", "es": "«Treinta y siete y medio. ¡Vamos a la farmacia!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s10", "text": "Апте́ка ря́дом, на углу́.", "es": "La farmacia está cerca, en la esquina." },
    { "id": "s11", "text": "«Здра́вствуйте! Мне ну́жно что́-нибудь от ка́шля.»", "es": "«¡Hola! Necesito algo para la tos.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s12", "text": "«Вот сиро́п, а э́то табле́тки от го́рла.»", "es": "«Aquí tiene un jarabe, y estas son pastillas para la garganta.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "«Ну́жен реце́пт?»", "es": "«¿Hace falta receta?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s14", "text": "«Нет, э́то мо́жно без реце́пта.»", "es": "«No, se puede comprar sin receta.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s15", "text": "До́ма Ве́ра Петро́вна гото́вит чай с мёдом и лимо́ном.", "es": "En casa, Vera Petrovna prepara un té con miel y limón." },
    { "id": "s16", "text": "«Пей чай и спи. Выздора́вливай!»", "es": "«Tómate el té y duerme. ¡Que te mejores!»", "voice": "ru-RU-SvetlanaNeural" }
