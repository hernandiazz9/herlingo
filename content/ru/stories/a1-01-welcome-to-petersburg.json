  "sentences": [
    { "id": "s1", "text": "Луси́я — испа́нка из Севи́льи.", "es": "Lucía es una española de Sevilla." },
    { "id": "s2", "text": "Она́ у́чит ру́сский язы́к.", "es": "Está aprendiendo ruso." },
    { "id": "s3", "text": "Сего́дня её самолёт прилета́ет в Санкт-Петербу́рг.", "es": "Hoy su avión aterriza en San Petersburgo." },
    { "id": "s4", "text": "Там живёт её подру́га А́ня.", "es": "Allí vive su amiga Ania." },
    { "id": "s5", "text": "В аэропорту́ мужчи́на смо́трит её па́спорт.", "es": "En el aeropuerto, un hombre le mira el pasaporte." },
    { "id": "s6", "text": "«Цель пое́здки?»", "es": "«¿Motivo del viaje?»" },
    { "id": "s7", "text": "«Тури́зм. Я здесь на неде́лю.»", "es": "«Turismo. Estoy aquí una semana.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s8", "text": "Пото́м Луси́я ждёт свой чемода́н.", "es": "Luego Lucía espera su maleta." },
    { "id": "s9", "text": "Он о́чень большо́й и кра́сный.", "es": "Es muy grande y roja." },
    { "id": "s10", "text": "В за́ле прилёта её ждёт А́ня.", "es": "En la sala de llegadas la espera Ania." },
    { "id": "s11", "text": "«Луси́я! Приве́т! Добро́ пожа́ловать в Петербу́рг!»", "es": "«¡Lucía! ¡Hola! ¡Bienvenida a San Petersburgo!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s12", "text": "«Приве́т, А́ня! Большо́е спаси́бо!»", "es": "«¡Hola, Ania! ¡Muchas gracias!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "«Как дела́? Как полёт?»", "es": "«¿Qué tal? ¿Qué tal el vuelo?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s14", "text": "«Отли́чно, спаси́бо! Но я о́чень хочу́ спать.»", "es": "«¡Genial, gracias! Pero tengo mucho sueño.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s15", "text": "На у́лице хо́лодно, но Луси́я о́чень ра́да.", "es": "Fuera hace frío, pero Lucía está muy contenta." },
    { "id": "s16", "text": "Брат А́ни, Ди́ма, ждёт их в маши́не.", "es": "El hermano de Ania, Dima, las espera en el coche." }
