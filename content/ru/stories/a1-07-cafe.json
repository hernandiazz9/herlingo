  "sentences": [
    { "id": "s1", "text": "По́сле обе́да А́ня и Луси́я гуля́ют по Не́вскому проспе́кту.", "es": "Después de comer, Ania y Lucía pasean por la avenida Nevski." },
    { "id": "s2", "text": "На у́лице хо́лодно, и идёт дождь.", "es": "Fuera hace frío y está lloviendo." },
    { "id": "s3", "text": "«Пойдём в кафе́? Я хочу́ ко́фе.»", "es": "«¿Vamos a una cafetería? Me apetece un café.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s4", "text": "«С удово́льствием!»", "es": "«¡Encantada!»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s5", "text": "В кафе́ тепло́ и о́чень ую́тно.", "es": "En la cafetería hace calorcito y se está muy a gusto." },
    { "id": "s6", "text": "Они́ садя́тся за сто́лик у окна́.", "es": "Se sientan en una mesa junto a la ventana." },
    { "id": "s7", "text": "Официа́нтка прино́сит меню́.", "es": "La camarera les trae la carta." },
    { "id": "s8", "text": "«Что вы бу́дете пить?»", "es": "«¿Qué vais a tomar?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s9", "text": "«Я бу́ду капучи́но.»", "es": "«Yo voy a tomar un capuchino.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s10", "text": "«А мне чай с лимо́ном, пожа́луйста.»", "es": "«Y para mí, un té con limón, por favor.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s11", "text": "«У вас есть десе́рты?»", "es": "«¿Tienen postres?»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s12", "text": "«Да, есть пиро́г с ви́шней и моро́женое.»", "es": "«Sí, hay pastel de cerezas y helado.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s13", "text": "Пиро́г тёплый и о́чень вку́сный.", "es": "El pastel está calentito y muy rico." },
    { "id": "s14", "text": "«Како́й вку́сный пиро́г! А́ня, сего́дня я угоща́ю!»", "es": "«¡Qué pastel tan rico! Ania, hoy invito yo.»", "voice": "ru-RU-SvetlanaNeural" },
    { "id": "s15", "text": "Пото́м Луси́я про́сит счёт.", "es": "Luego Lucía pide la cuenta." },
    { "id": "s16", "text": "«Спаси́бо! Тогда́ в сле́дующий раз угоща́ю я.»", "es": "«¡Gracias! Pues la próxima vez invito yo.»", "voice": "ru-RU-SvetlanaNeural" }
