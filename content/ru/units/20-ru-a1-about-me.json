  "phrases": [
    {
      "id": "ru-a1-about-me.menya-zovut",
      "text": "Меня́ зову́т Эрна́н.",
      "es": "Me llamo Hernán.",
      "literal": "A mí me llaman Hernán.",
      "explanation": "Para presentarte con cualquiera; cambia el nombre por el tuyo. mi-NIÁ za-VÚT: la «е» átona suena casi «i».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-ernan",
      "text": "Я Эрна́н.",
      "es": "Soy Hernán.",
      "explanation": "La forma más corta: en ruso no hay verbo «ser» en presente. «Я» se lee «ya».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.kak-vas-zovut",
      "text": "Как вас зову́т?",
      "es": "¿Cómo se llama?",
      "explanation": "A un desconocido, en recepción o en una tienda. kak vas za-VÚT: la «о» átona suena «a».",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.kak-tebya-zovut",
      "text": "Как тебя́ зову́т?",
      "es": "¿Cómo te llamas?",
      "explanation": "A alguien joven o a un niño, de tú. ti-BIÁ: «тебя́» lleva el golpe al final.",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.a-vas",
      "text": "А вас?",
      "es": "¿Y usted? (¿cómo se llama?)",
      "explanation": "Para devolver la pregunta del nombre de usted. Corto y natural: a VAS.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.a-tebya",
      "text": "А тебя́?",
      "es": "¿Y tú? (¿cómo te llamas?)",
      "explanation": "Para devolver la pregunta del nombre de tú. a ti-BIÁ.",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.moya-familiya",
      "text": "Моя́ фами́лия Ди́ас.",
      "es": "Mi apellido es Díaz.",
      "explanation": "Cuando te piden el apellido en un hotel o un control. ma-YÁ fa-MÍ-li-ya.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.kak-vasha-familiya",
      "text": "Как ва́ша фами́лия?",
      "es": "¿Cuál es su apellido?",
      "explanation": "Lo oirás en recepción o en un mostrador. VÁ-sha: la «ш» es una «sh» dura.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.davaite-poznakomimsya",
      "text": "Дава́йте познако́мимся!",
      "es": "¿Nos presentamos?",
      "explanation": "Para romper el hielo con alguien a quien tratas de usted. da-VÁI-tie pa-zna-KÓ-mim-sia.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.poznakomtes",
      "text": "Познако́мьтесь, э́то А́ня.",
      "es": "Te presento a Ania. / Le presento a Ania.",
      "explanation": "Para presentar a una persona a otra (o a varias). La «ь» ablanda la «м»: pa-zna-KÓM'-ties'.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.skolko-vam-let",
      "text": "Ско́лько вам лет?",
      "es": "¿Cuántos años tiene?",
      "explanation": "Pregunta de confianza; entre adultos que no se conocen no es muy habitual. SKÓL'-ka vam liet.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.skolko-tebe-let",
      "text": "Ско́лько тебе́ лет?",
      "es": "¿Cuántos años tienes?",
      "explanation": "A un niño o a un amigo. ti-BIÉ: el golpe va al final.",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.mne-tridtsat-let",
      "text": "Мне три́дцать лет.",
      "es": "Tengo treinta años.",
      "literal": "A mí treinta años.",
      "explanation": "Cambia el número por tu edad. En ruso no «tienes» años: «a mí, treinta años». TRÍ-tsat' liet.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.otkuda-vy",
      "text": "Отку́да вы?",
      "es": "¿De dónde es?",
      "explanation": "La pregunta típica en un taxi o con un vecino. at-KÚ-da: la «о» inicial átona suena «a».",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.otkuda-ty",
      "text": "Отку́да ты?",
      "es": "¿De dónde eres?",
      "explanation": "Con alguien de tu edad en un bar o un hostal. at-KÚ-da ti.",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-iz-ispanii",
      "text": "Я из Испа́нии.",
      "es": "Soy de España.",
      "explanation": "«из» + el país con otra terminación: Испа́ния → из Испа́нии. is is-PÁ-ni-i.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-iz-madrida",
      "text": "Я из Мадри́да.",
      "es": "Soy de Madrid.",
      "explanation": "Para decir tu ciudad: Мадри́д → из Мадри́да. ya iz ma-DRÍ-da.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-ispanets",
      "text": "Я испа́нец.",
      "es": "Soy español.",
      "notes": "Dicho por un hombre.",
      "explanation": "Lo dice un hombre; una mujer dice «Я испа́нка». is-PÁ-niets.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-ispanka",
      "text": "Я испа́нка.",
      "es": "Soy española.",
      "notes": "Dicho por una mujer.",
      "explanation": "Lo dice una mujer; un hombre dice «Я испа́нец». is-PÁN-ka.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.gde-vy-zhivyote",
      "text": "Где вы живёте?",
      "es": "¿Dónde vive?",
      "explanation": "Para preguntar por la ciudad o el barrio. zhi-VIÓ-tie: la «ё» siempre lleva el golpe.",
      "register": "vy",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.gde-ty-zhivyosh",
      "text": "Где ты живёшь?",
      "es": "¿Dónde vives?",
      "explanation": "De tú, con amigos. zhi-VIÓSH: «ж» como una «sh» sonora.",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-zhivu-v-madride",
      "text": "Я живу́ в Мадри́де.",
      "es": "Vivo en Madrid.",
      "explanation": "«в» + lugar con «-е»: в Мадри́де. La «в» se pega a la palabra: vma-DRÍ-die.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "ru-a1-about-me.ya-zdes-v-otpuske",
      "text": "Я здесь в о́тпуске.",
      "es": "Estoy aquí de vacaciones.",
