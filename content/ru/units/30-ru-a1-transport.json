    {
      "id": "ru-a1-transport.gde-registratsiya",
      "text": "Где регистра́ция?",
      "es": "¿Dónde se factura?",
      "notes": "«регистра́ция» es la facturación (y también registrarse en un hotel).",
      "explanation": "Al entrar en la terminal, para encontrar los mostradores. -ция suena «tsi-ya»: re-guis-TRA-tsi-ya.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.vash-pasport",
      "text": "Ваш па́спорт, пожа́луйста.",
      "es": "Su pasaporte, por favor.",
      "explanation": "Te lo dicen en el mostrador, en el control y en el hotel. «пожа́луйста» se dice rápido: pa-ZHÁ-lus-ta.",
      "register": "vy",
      "situation": "viajes",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-transport.u-menya-odin-chemodan",
      "text": "У меня́ оди́н чемода́н.",
      "es": "Llevo una maleta.",
      "literal": "En mí, una maleta.",
      "explanation": "Al facturar, cuando te preguntan por el equipaje. La «o» sin acento suena «a»: cha-ma-DÁN.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.eto-ruchnaya-klad",
      "text": "Э́то ручна́я кладь.",
      "es": "Esto es equipaje de mano.",
      "explanation": "Para decir que una bolsa va contigo en cabina. «кладь» termina en «t» suave: klat'.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.gde-vykhod-na-posadku",
      "text": "Где вы́ход на поса́дку?",
      "es": "¿Dónde está la puerta de embarque?",
      "literal": "¿Dónde la salida al embarque?",
      "explanation": "Tras el control de seguridad. «ы» es una «i» con la lengua hacia atrás: VY-jad.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.reis-zaderzhivaetsya",
      "text": "Рейс заде́рживается.",
      "es": "El vuelo se retrasa.",
      "explanation": "Lo oyes por megafonía o lo lees en la pantalla. -тся al final suena «tsa»: za-DIER-zhi-va-ye-tsa.",
      "register": "neutral",
      "situation": "viajes",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-transport.posadka-nachalas",
      "text": "Поса́дка начала́сь.",
      "es": "Ha empezado el embarque.",
      "explanation": "Anuncio en la puerta: ve a la cola. pa-SÁT-ka: la «д» delante de «к» suena «t».",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.tsel-poezdki",
      "text": "Цель пое́здки?",
      "es": "¿Motivo del viaje?",
      "explanation": "Lo pregunta el agente del control de pasaportes. «ц» = «ts»: tsel' pa-YEZ-tki.",
      "register": "neutral",
      "situation": "viajes",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-transport.turizm",
      "text": "Тури́зм.",
      "es": "Turismo.",
      "explanation": "La respuesta más corta en el control de pasaportes. Acento al final: tu-RÍZM.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.ya-zdes-na-nedelyu",
      "text": "Я здесь на неде́лю.",
      "es": "Estoy aquí una semana.",
      "literal": "Yo aquí para una semana.",
      "explanation": "Si te preguntan cuánto tiempo te quedas. «здесь» acaba en «s» suave: zdies'.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.gde-poluchit-bagazh",
      "text": "Где мо́жно получи́ть бага́ж?",
      "es": "¿Dónde se recoge el equipaje?",
      "explanation": "Al bajar del avión, si no ves las cintas. «бага́ж» acaba sonando «sh»: ba-GÁSH.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.chemodan-ne-prishyol",
      "text": "Мой чемода́н не пришёл.",
      "es": "Mi maleta no ha llegado.",
      "explanation": "En el mostrador de equipajes perdidos. «ё» siempre lleva el acento: pri-SHIÓL.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.nechego-deklarirovat",
      "text": "Мне не́чего деклари́ровать.",
      "es": "No tengo nada que declarar.",
      "explanation": "En la aduana, si te paran. NIE-chi-va: la «е» sin acento suena casi «i».",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.gde-kassa",
      "text": "Где ка́сса?",
      "es": "¿Dónde está la taquilla?",
      "explanation": "En la estación, para comprar el billete en persona. La doble «сс» se alarga un poco: KÁS-sa.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.bilet-do-moskvy",
      "text": "Оди́н биле́т до Москвы́, пожа́луйста.",
      "es": "Un billete a Moscú, por favor.",
      "notes": "«до» + destino: до Москвы́, до Петербу́рга.",
      "explanation": "En la taquilla. Tras «до» el nombre cambia: Москва́ → до Москвы́ (mask-VY).",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.tuda-i-obratno",
      "text": "Туда́ и обра́тно.",
      "es": "Ida y vuelta.",
      "literal": "Allí y de vuelta.",
      "explanation": "Respuesta en la taquilla si vuelves. La «о» sin acento suena «a»: a-BRÁT-na.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.v-odin-konets",
      "text": "В оди́н коне́ц.",
      "es": "Solo ida.",
      "literal": "A un extremo.",
      "explanation": "Si no vuelves en tren. «в» se pega a la palabra siguiente: va-DÍN ka-NIETS.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.kogda-sleduyushchii-poezd",
      "text": "Когда́ сле́дующий по́езд?",
      "es": "¿Cuándo sale el próximo tren?",
      "literal": "¿Cuándo el siguiente tren?",
      "explanation": "En información o al revisor. «щ» es una «sh» larga y suave: SLIE-du-yu-shchi.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.s-kakoi-platformy",
      "text": "С како́й платфо́рмы?",
      "es": "¿De qué andén sale?",
      "explanation": "Para saber adónde ir. En las grandes estaciones también oyes «путь» (vía): s ka-KÓI plat-FÓR-my.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.gde-pyatyi-vagon",
      "text": "Где пя́тый ваго́н?",
      "es": "¿Dónde está el vagón cinco?",
      "explanation": "En el andén: en los trenes rusos cada billete tiene su vagón. «я» tras consonante la ablanda: PIA-ty.",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.eto-moyo-mesto",
      "text": "Извини́те, э́то моё ме́сто.",
      "es": "Perdone, este es mi asiento.",
      "explanation": "Si alguien está en tu plaza. «моё» acaba en «ió» acentuada: ma-YÓ MIES-ta.",
      "register": "vy",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.poezd-opazdyvaet",
      "text": "По́езд опа́здывает?",
      "es": "¿El tren viene con retraso?",
      "explanation": "Si el tren no llega a su hora. «по́езд» son dos sílabas: PO-yist (la «д» final suena «t»).",
      "register": "neutral",
      "situation": "viajes"
    },
    {
      "id": "ru-a1-transport.blizhaishaya-stantsiya",
      "text": "Где ближа́йшая ста́нция метро́?",
      "es": "¿Dónde está la estación de metro más cercana?",
      "explanation": "A cualquiera por la calle, mejor tras «Извини́те». «ж» es como la «j» francesa: bli-ZHÁI-sha-ya.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-transport.nuzhen-proezdnoi",
      "text": "Мне ну́жен проездно́й.",
      "es": "Necesito un abono de transporte.",
      "literal": "A mí necesario un abono.",
      "explanation": "En la taquilla del metro. En San Petersburgo la tarjeta se llama «Подоро́жник». pra-yiz-NÓI.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-transport.kak-doekhat-do-tsentra",
      "text": "Как дое́хать до це́нтра?",
      "es": "¿Cómo llego al centro?",
      "literal": "¿Cómo llegar (en transporte) hasta el centro?",
      "explanation": "Para ir en metro o autobús («дойти́» es a pie). «х» es una jota: da-YÉ-jat'.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-transport.gde-sdelat-peresadku",
      "text": "Где мне сде́лать переса́дку?",
      "es": "¿Dónde hago transbordo?",
      "explanation": "Cuando tu línea no llega a tu destino. pi-ri-SÁT-ku: las «е» sin acento suenan «i».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-transport.kakaya-sleduyushchaya",
      "text": "Кака́я сле́дующая ста́нция?",
      "es": "¿Cuál es la próxima estación?",
      "explanation": "Dentro del vagón, si no entiendes el anuncio. ka-KÁ-ya: la primera «а» se reduce.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-transport.ostorozhno-dveri",
      "text": "Осторо́жно, две́ри закрыва́ются!",
      "es": "¡Atención, se cierran las puertas!",
      "explanation": "El anuncio del metro antes de arrancar: no intentes entrar. as-ta-RÓZH-na: las «о» sin acento suenan «a».",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
