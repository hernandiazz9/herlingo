  "qa": [
    {
      "id": "ru-a1-shopping.qa.vam-pomoch",
      "question": "Здра́вствуйте! Вам помо́чь?",
      "questionEs": "¡Hola! ¿Le puedo ayudar?",
      "accepted": [
        {
          "text": "Спаси́бо, я про́сто смотрю́.",
          "es": "Gracias, solo estoy mirando."
        },
        {
          "text": "Да. У вас есть сувени́ры?",
          "es": "Sí. ¿Tienen recuerdos?"
        }
      ],
      "distractors": [
        {
          "text": "Нет, э́то всё.",
          "es": "No, eso es todo."
        },
        {
          "text": "Пожа́луйста!",
          "es": "¡De nada!"
        }
      ],
      "register": "vy",
      "situation": "compras",
      "notes": "«Я про`сто смотрю`» es la forma educada de decir que solo miras.",
      "voice": "ru-RU-SvetlanaNeural"
    },
