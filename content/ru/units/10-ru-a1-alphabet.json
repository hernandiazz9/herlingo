  "phrases": [
    {
      "id": "ru-a1-alphabet.kto-tam",
      "text": "Кто там?",
      "es": "¿Quién es?",
      "literal": "¿Quién allí?",
      "explanation": "Lo que se pregunta en Rusia cuando llaman a la puerta. Palabras de una sílaba, sin tilde: «kto tam».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.tam-kot",
      "text": "Там кот.",
      "es": "Ahí hay un gato.",
      "explanation": "Tu primera frase rusa, solo con letras amigas. No hay verbo «estar» ni artículo: «tam kot».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.vot-metro",
      "text": "Вот метро́.",
      "es": "Ahí está el metro.",
      "explanation": "«Вот» señala algo que ves: aquí está, ahí está. La «в» con labio y dientes: vot mi-TRÓ.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.vot-pasport",
      "text": "Вот па́спорт.",
      "es": "Aquí tiene el pasaporte.",
      "explanation": "Al dárselo al policía en el control o en la recepción del hotel. PÁS-part: la «о» átona suena casi «a».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-bank",
      "text": "Где банк?",
      "es": "¿Dónde está el banco?",
      "explanation": "«Где» = dónde: «g» de gato y una «e» que ablanda la «d», «gdie». Cambia «банк» por lo que busques.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-metro",
      "text": "Где метро́?",
      "es": "¿Dónde está el metro?",
      "explanation": "Para preguntar por la estación más cercana: gdie mi-TRÓ.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.eto-taksi",
      "text": "Э́то такси́?",
      "es": "¿Esto es un taxi?",
      "explanation": "Para comprobarlo antes de subir. «Э» es una «e» abierta: É-ta tak-SÍ.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.ya-turist",
      "text": "Я тури́ст.",
      "es": "Soy turista.",
      "explanation": "En ruso no se dice «ser» en presente: «yo turista». Si eres mujer: «Я тури́стка».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-muzei",
      "text": "Где музе́й?",
      "es": "¿Dónde está el museo?",
      "explanation": "Con un mapa en la mano, a cualquiera por la calle. La «й» es una «i» breve: mu-ZIÉI.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.chai-pozhaluista",
      "text": "Чай, пожа́луйста.",
      "es": "Un té, por favor.",
      "explanation": "Para pedir en una cafetería: lo que quieres + «пожа́луйста». Se dice rápido, «pa-ZHÁL-sta».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-tsentr",
      "text": "Где центр?",
      "es": "¿Dónde está el centro?",
      "explanation": "Para ir al centro de la ciudad. La «ц» es «ts», como al final de «pizza»: tsentr.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.vot-gostinitsa",
      "text": "Вот гости́ница.",
      "es": "Ahí está el hotel.",
      "explanation": "Al llegar con la maleta. ga-STÍ-ni-tsa: la «о» átona suena «a».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-tualet",
      "text": "Где туале́т?",
      "es": "¿Dónde está el baño?",
      "explanation": "En un museo, un bar o una estación. tu-a-LIET: la «е» ablanda la «л».",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.gde-vykhod",
      "text": "Где вы́ход?",
      "es": "¿Dónde está la salida?",
      "explanation": "En el metro, el aeropuerto o un museo. La «ы» con la lengua atrás: VY-jat.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.magazin-zakryt",
      "text": "Магази́н закры́т.",
      "es": "La tienda está cerrada.",
      "explanation": "Lo lees en la puerta o te lo dicen. ma-ga-SÍN za-KRYT: la «ы» con la lengua hacia atrás.",
      "register": "neutral",
      "situation": "alfabeto",
      "tags": [
        "lectura"
      ]
    },
    {
      "id": "ru-a1-alphabet.apteka-otkryta",
      "text": "Апте́ка откры́та?",
      "es": "¿Está abierta la farmacia?",
