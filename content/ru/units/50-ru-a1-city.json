    {
      "id": "ru-a1-city.gde-nakhoditsya",
      "text": "Где нахо́дится Эрмита́ж?",
      "es": "¿Dónde está el Hermitage?",
      "explanation": "Para preguntar por cualquier sitio con nombre. na-JÓ-di-tsa: la «о» sin acento suena «a» y -тся suena «tsa».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.gde-zdes-bankomat",
      "text": "Где здесь банкома́т?",
      "es": "¿Dónde hay un cajero por aquí?",
      "explanation": "Para encontrar un cajero en la calle o en el metro. «здесь» acaba en «s» suave: zdies' ban-ka-MAT.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.ryadom-est-kafe",
      "text": "Здесь ря́дом есть кафе́?",
      "es": "¿Hay alguna cafetería cerca?",
      "literal": "¿Aquí al lado hay café?",
      "explanation": "Cuando buscas un sitio para sentarte un rato. «ря́дом» = RIA-dam: la «о» sin acento suena «a».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.ya-ishchu-etot-adres",
      "text": "Я ищу́ э́тот а́дрес.",
      "es": "Busco esta dirección.",
      "explanation": "Mientras enseñas el móvil o un papel a un transeúnte. «щ» es una «sh» larga y suave: ya i-SHCHÚ.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.eto-tsentr-goroda",
      "text": "Э́то центр го́рода?",
      "es": "¿Esto es el centro?",
      "literal": "¿Esto es el centro de la ciudad?",
      "explanation": "Al salir del metro, para saber si ya has llegado. «ц» = «ts»: tsentr GÓ-ra-da.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.kakoi-krasivyi-gorod",
      "text": "Како́й краси́вый го́род!",
      "es": "¡Qué ciudad tan bonita!",
      "explanation": "Para piropear la ciudad a un ruso: les encanta oírlo. ka-KÓI kra-SÍ-vyi: la «ы» va con la lengua atrás.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.chto-posmotret",
      "text": "Что мо́жно посмотре́ть в го́роде?",
      "es": "¿Qué se puede ver en la ciudad?",
      "explanation": "En recepción o a un amigo ruso, para pedir ideas. «что» se dice «shto».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.kak-proiti-k-ermitazhu",
      "text": "Как пройти́ к Эрмита́жу?",
      "es": "¿Cómo se va al Hermitage?",
      "notes": "Detrás de «к» el nombre cambia: Эрмита́ж → к Эрмита́жу.",
      "explanation": "La pregunta clásica para ir andando a un sitio. «пройти́» es ir a pie; en coche dirías «прое́хать».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.kak-doiti-do-metro",
      "text": "Как дойти́ до метро́?",
      "es": "¿Cómo llego andando al metro?",
      "explanation": "Para llegar a pie a un sitio concreto. dai-TÍ da mit-RÓ: «до» sin acento suena «da».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.eto-daleko-otsyuda",
      "text": "Э́то далеко́ отсю́да?",
      "es": "¿Está lejos de aquí?",
      "explanation": "Antes de decidir si vas andando o coges el metro. da-li-KÓ at-SIÚ-da: las «о» sin acento suenan «a».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.mozhno-doiti-peshkom",
      "text": "Мо́жно дойти́ пешко́м?",
      "es": "¿Se puede ir andando?",
      "explanation": "Cuando quieres pasear en vez de coger transporte. «пешко́м» = pish-KÓM, acento al final.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.pokazhite-na-karte",
      "text": "Покажи́те, пожа́луйста, на ка́рте.",
      "es": "Enséñemelo en el mapa, por favor.",
      "explanation": "Mientras le tiendes el móvil con el mapa abierto. «ж» es como la «j» francesa: pa-ka-ZHÍ-tie.",
      "register": "vy",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.ya-zabludilsya",
      "text": "Я заблуди́лся.",
      "es": "Me he perdido.",
      "notes": "Lo dice un hombre; una mujer dice «заблуди́лась».",
      "explanation": "Para pedir ayuda cuando no sabes dónde estás. -лся suena «-lsa»: za-blu-DÍL-sa.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.ya-zabludilas",
      "text": "Я заблуди́лась.",
      "es": "Me he perdido.",
      "notes": "Lo dice una mujer; un hombre dice «заблуди́лся».",
      "explanation": "Para pedir ayuda cuando no sabes dónde estás. El femenino acaba en «-las'», con «s» suave: za-blu-DÍ-las'.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.vy-ne-podskazhete",
      "text": "Вы не подска́жете, где Не́вский проспе́кт?",
      "es": "¿Me podría decir dónde está la avenida Nevski?",
      "literal": "¿No me indicará dónde está la avenida Nevski?",
      "explanation": "La forma más educada de parar a alguien por la calle. pat-SKÁ-zhi-tie: la «д» delante de «с» suena «t».",
      "register": "vy",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.ya-ne-mestnyi",
      "text": "Извини́те, я не ме́стный.",
      "es": "Lo siento, no soy de aquí.",
      "notes": "Lo dice un hombre; una mujer dice «я не ме́стная».",
      "explanation": "Lo que te puede contestar alguien que no lo sabe. En «ме́стный» la «т» casi no se oye: MIES-nyi.",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.idite-pryamo",
      "text": "Иди́те пря́мо.",
      "es": "Siga recto.",
      "explanation": "Lo que más vas a oír al preguntar el camino. «я» al principio suena «ya»: PRIA-ma.",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.povernite-nalevo",
      "text": "Поверни́те нале́во.",
      "es": "Gire a la izquierda.",
      "explanation": "Te lo dicen al indicarte el camino. na-LIE-va: la «о» final sin acento suena «a».",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.povernite-napravo",
      "text": "Поверни́те напра́во.",
      "es": "Gire a la derecha.",
      "explanation": "Te lo dicen al indicarte el camino. pa-vir-NÍ-tie na-PRA-va: la «р» es como la de «pero».",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.na-svetofore-nalevo",
      "text": "На светофо́ре поверни́те нале́во.",
      "es": "En el semáforo, gire a la izquierda.",
      "explanation": "Indicación típica en una avenida grande. svi-ta-FÓ-rie: la «е» sin acento suena casi «i».",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.idite-do-perekryostka",
      "text": "Иди́те пря́мо до перекрёстка.",
      "es": "Siga recto hasta el cruce.",
      "explanation": "Indicación típica para llegar a una esquina. «ё» siempre lleva el acento: pi-ri-KRIÓST-ka.",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.idite-do-kontsa-ulitsy",
      "text": "Иди́те до конца́ у́лицы.",
      "es": "Siga hasta el final de la calle.",
      "explanation": "Cuando el sitio está al fondo de la calle. kan-TSÁ U-li-tsy: «ц» = «ts».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.pereidite-ulitsu",
      "text": "Перейди́те у́лицу.",
      "es": "Cruce la calle.",
      "explanation": "Si lo que buscas está en la otra acera. pi-riei-DÍ-tie: la «й» es una «i» breve.",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.eto-na-uglu",
      "text": "Э́то на углу́.",
      "es": "Está en la esquina.",
      "explanation": "Para situar una tienda o una parada. Acento al final: na u-GLÚ.",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.muzei-budet-sleva",
      "text": "Музе́й бу́дет сле́ва.",
      "es": "El museo quedará a la izquierda.",
      "literal": "El museo estará a la izquierda.",
      "explanation": "Lo dice quien te indica para que sepas qué lado mirar. «сле́ва» = a la izquierda (dónde está): SLIE-va.",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.apteka-naprotiv",
      "text": "Апте́ка напро́тив.",
      "es": "La farmacia está enfrente.",
      "explanation": "Para decir que algo está al otro lado de la calle. na-PRÓ-tif: la «в» final suena «f».",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.eto-ryadom-s-metro",
      "text": "Э́то ря́дом с метро́.",
      "es": "Está al lado del metro.",
      "explanation": "Para dar una referencia fácil: el metro siempre se ve. RIA-dam s mit-RÓ: «с» se une a la palabra siguiente.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.pyat-minut-peshkom",
      "text": "Э́то пять мину́т пешко́м.",
      "es": "Está a cinco minutos andando.",
      "literal": "Esto es cinco minutos a pie.",
      "explanation": "Así te dicen la distancia en Rusia: en minutos. «пять» acaba en «t» suave: piat'.",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.vo-skolko-otkryvaetsya",
      "text": "Во ско́лько открыва́ется музе́й?",
      "es": "¿A qué hora abre el museo?",
      "explanation": "Antes de ir, en recepción o en la taquilla. at-kry-VÁ-ye-tsa: -тся suena «tsa».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.do-skolki-rabotaet",
      "text": "До ско́льки рабо́тает музе́й?",
      "es": "¿Hasta qué hora abre el museo?",
      "explanation": "Para saber cuánto tiempo tienes dentro. da SKÓL'-ki: la «л» suave antes de la «к».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.odin-vzroslyi-bilet",
      "text": "Оди́н взро́слый биле́т, пожа́луйста.",
      "es": "Una entrada de adulto, por favor.",
      "explanation": "En la taquilla de un museo o un teatro. VZRÓS-lyi: grupo de consonantes, dilo sin vocal entre «в» y «з».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.est-skidka-dlya-studentov",
      "text": "Есть ски́дка для студе́нтов?",
      "es": "¿Hay descuento para estudiantes?",
      "explanation": "En la taquilla, enseñando el carné. SKÍT-ka: la «д» delante de «к» suena «t».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.mozhno-fotografirovat",
      "text": "Здесь мо́жно фотографи́ровать?",
      "es": "¿Se pueden hacer fotos aquí?",
      "explanation": "Antes de sacar el móvil en una sala. Palabra larga con acento en «и»: fa-ta-gra-FÍ-ra-vat'.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.gde-garderob",
      "text": "Где гардеро́б?",
      "es": "¿Dónde está el guardarropa?",
      "explanation": "En museos y teatros rusos el abrigo se deja siempre en el guardarropa. La «б» final suena «p»: gar-di-RÓP.",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.sdaite-kurtku",
      "text": "Сда́йте ку́ртку в гардеро́б, пожа́луйста.",
      "es": "Deje la chaqueta en el guardarropa, por favor.",
      "explanation": "Te lo dice el personal si entras con el abrigo puesto. ZDÁI-tie: la «с» delante de «д» suena «z».",
      "register": "vy",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
    {
      "id": "ru-a1-city.est-audiogid",
      "text": "У вас есть аудиоги́д на испа́нском?",
      "es": "¿Tienen audioguía en español?",
      "explanation": "En la entrada de los grandes museos. au-di-a-GUÍT: la «д» final suena «t».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.kogda-ekskursiya",
      "text": "Когда́ сле́дующая экску́рсия?",
      "es": "¿Cuándo es la próxima visita guiada?",
      "explanation": "En la taquilla o en el mostrador de información. iks-KÚR-si-ya: la «э» sin acento suena «i».",
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "ru-a1-city.po-ponedelnikam-zakryt",
      "text": "По понеде́льникам музе́й закры́т.",
      "es": "Los lunes el museo cierra.",
      "literal": "Los lunes el museo está cerrado.",
      "explanation": "Muchos museos rusos cierran un día a la semana: mira el horario. za-KRYT: «ы» con la lengua atrás.",
      "register": "neutral",
      "situation": "ciudad",
      "voice": "ru-RU-DmitryNeural"
    },
