  "phrases": [
    {
      "id": "es-a1-hola.hola",
      "text": "¡Hola!",
      "ru": "Привет! / Здравствуйте!",
      "explanation": {
        "ru": "Подходит всем: другу, продавцу, врачу. «h» в испанском всегда немая: «ола», а не «хола»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.buen-dia",
      "text": "¡Buen día!",
      "ru": "Доброе утро! / Добрый день!",
      "notes": {
        "ru": "Аргентинцы до обеда говорят «buen día»; «buenos días» — это скорее Испания."
      },
      "explanation": {
        "ru": "Утром — в лифте, в кафе, в киоске, всем подряд. Ударение: буэн ДИ-а."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.buenas-tardes",
      "text": "¡Buenas tardes!",
      "ru": "Добрый день!",
      "explanation": {
        "ru": "После обеда и до темноты. Каждая «о» и «а» звучит чётко, без русского «аканья»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.buenas-noches",
      "text": "¡Buenas noches!",
      "ru": "Добрый вечер! / Спокойной ночи!",
      "explanation": {
        "ru": "Вечером: и когда приходишь, и когда уходишь. «ch» — как мягкое русское «ч»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.chau",
      "text": "¡Chau!",
      "ru": "Пока!",
      "notes": {
        "ru": "Пришло из итальянского «ciao», но пишется по-испански."
      },
      "explanation": {
        "ru": "Прощаешься с кем угодно, даже с продавцом в киоске. Звучит «чау»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.nos-vemos",
      "text": "¡Nos vemos!",
      "ru": "Увидимся!",
      "explanation": {
        "ru": "Тому, кого скоро снова увидишь. «v» звучит как «б»: нос БЕ-мос."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.todo-bien",
      "text": "¿Todo bien?",
      "ru": "Как дела? Всё норм?",
      "explanation": {
        "ru": "Самое частое «как дела» в Аргентине, часто сразу после «hola». Вопрос делает интонация вверх."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.todo-bien-y-vos",
      "text": "Todo bien, ¿y vos?",
      "ru": "Всё хорошо, а ты?",
      "notes": {
        "ru": "Вместо «tú» в Аргентине говорят «vos». «Tú» поймут, но здесь так почти никто не говорит."
      },
      "explanation": {
        "ru": "Ответ другу на «¿todo bien?». «vos» звучит «бос»: «b» и «v» читаются одинаково."
      },
      "register": "tu",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.que-haces",
      "text": "¿Qué hacés?",
      "ru": "Привет, как ты?",
      "literal": {
        "ru": "Что ты делаешь?"
      },
      "notes": {
        "ru": "В Кордове Флор скажет «¿qué hacé'?» — последняя «s» пропадает. Это то же приветствие."
      },
      "explanation": {
        "ru": "Это приветствие, а не вопрос о делах: отвечай «bien, ¿y vos?». Ударение на конце: а-СЕС."
      },
      "register": "tu",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.hola-che",
      "text": "¡Hola, che!",
      "ru": "Привет, дружище!",
      "notes": {
        "ru": "«Che» — дружеское «эй, слушай»; аргентинцы вставляют его куда угодно."
      },
      "explanation": {
        "ru": "С друзьями и ровесниками, но не с врачом или полицейским. Звучит «че»."
      },
      "register": "tu",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.un-beso",
      "text": "Un beso.",
      "ru": "Целую! (на прощание)",
      "notes": {
        "ru": "При встрече здесь целуются в щёку один раз — даже друзья-мужчины."
      },
      "explanation": {
        "ru": "В конце звонка или сообщения другу. «s» между гласными — чистое «с», не «з»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.me-llamo-ivan",
      "text": "Me llamo Iván.",
      "ru": "Меня зовут Иван.",
      "literal": {
        "ru": "Я себя называю Иван."
      },
      "explanation": {
        "ru": "Когда знакомишься. «ll» в Аргентине звучит как «ш»: ме ША-мо."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.como-te-llamas",
      "text": "¿Cómo te llamás?",
      "ru": "Как тебя зовут?",
      "explanation": {
        "ru": "Ровеснику на вечеринке или в хостеле. Ударение на конце: ша-МАС."
      },
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.como-se-llama",
      "text": "¿Cómo se llama usted?",
      "ru": "Как вас зовут?",
      "explanation": {
        "ru": "Пожилому человеку или в официальной обстановке. Ударение уже в середине: ША-ма."
      },
      "register": "usted",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.vos-sos-martin",
      "text": "Vos sos Martín, ¿no?",
      "ru": "Ты ведь Мартин, да?",
      "notes": {
        "ru": "«Sos» — это «ты есть» для «vos»; «¿no?» в конце = «да?»."
      },
      "explanation": {
        "ru": "Когда уточняешь, тот ли это человек. «vos sos» звучит «бос сос»."
      },
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.soy-de-rusia",
      "text": "Soy de Rusia.",
      "ru": "Я из России.",
      "explanation": {
        "ru": "Ответ на «¿de dónde sos?». «r» в начале слова раскатистая, как в «ррраз»."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.de-donde-sos",
      "text": "¿De dónde sos?",
      "ru": "Ты откуда?",
      "explanation": {
        "ru": "Этот вопрос тебе зададут сто раз. «d» между гласными мягкая, почти как английское «th»."
      },
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.soy-ruso",
      "text": "Soy ruso.",
      "ru": "Я русский.",
      "notes": {
        "ru": "Девушка скажет «soy rusa». Национальность пишется с маленькой буквы."
      },
      "explanation": {
        "ru": "Когда спрашивают, откуда ты. Не путай: «ruso» — русский, «Rusia» — Россия."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.flor-es-de-cordoba",
      "text": "Flor es de Córdoba.",
      "ru": "Флор из Кордовы.",
      "notes": {
        "ru": "У кордовцев своя «тонада»: слог перед ударным они тянут, будто поют."
      },
      "explanation": {
        "ru": "Когда рассказываешь о друзьях. «Córdoba» — ударение на первый слог: КОР-до-ба."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.mucho-gusto",
      "text": "¡Mucho gusto!",
      "ru": "Очень приятно!",
      "explanation": {
        "ru": "Сразу после знакомства, с кем угодно. «u» всегда «у»: МУ-чо ГУС-то."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.igualmente",
      "text": "Igualmente.",
      "ru": "Взаимно.",
      "explanation": {
        "ru": "Ответ на «¡mucho gusto!» или на добрые пожелания. Ударение: и-гуаль-МЕН-те."
      },
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "es-a1-hola.gracias",
      "text": "Gracias.",
      "ru": "Спасибо.",
      "explanation": {
        "ru": "Везде и всем. Но осторожно с мате: «gracias» там значит «мне больше не наливать»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.muchas-gracias",
      "text": "¡Muchas gracias!",
      "ru": "Большое спасибо!",
      "explanation": {
        "ru": "Когда тебе реально помогли. «s» перед согласной часто звучит почти как «х»: МУ-чах."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.de-nada",
      "text": "De nada.",
      "ru": "Не за что.",
      "notes": {
        "ru": "Отвечает на «gracias». Русское «пожалуйста» в ответ на спасибо — это именно «de nada»."
      },
      "explanation": {
        "ru": "Ответ на спасибо, с кем угодно. Ударение: де НА-да."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.por-favor",
      "text": "Por favor.",
      "ru": "Пожалуйста (прошу).",
      "notes": {
        "ru": "Только когда просишь. На «gracias» отвечают не «por favor», а «de nada»!"
      },
      "explanation": {
        "ru": "В конце любой просьбы: «un café, por favor». Звучит «пор фа-БОР»."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.perdon",
      "text": "Perdón.",
      "ru": "Извини. / Извините.",
      "explanation": {
        "ru": "Наступил на ногу или перебил — говори это. Ударение на конце: пер-ДОН."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.permiso",
      "text": "Permiso.",
      "ru": "Разрешите (пройти).",
      "notes": {
        "ru": "Так говорят, когда протискиваются в колективо или заходят в чужой дом."
      },
      "explanation": {
        "ru": "Пробираешься к выходу в автобусе или входишь в гости. пер-МИ-со."
      },
      "register": "neutral",
      "situation": "saludos"
    },
    {
      "id": "es-a1-hola.disculpe",
      "text": "Disculpe.",
      "ru": "Извините.",
      "notes": {
        "ru": "Другу скажешь «disculpá» или просто «perdón»."
      },
      "explanation": {
        "ru": "Чтобы обратиться к незнакомому: водителю, полицейскому, пожилой сеньоре. дис-КУЛЬ-пе."
      },
      "register": "usted",
      "situation": "saludos"
    },
    {
