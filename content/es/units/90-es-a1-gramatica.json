          "hablar",
          "vos hablás",
          {
            "ru": "ты говоришь"
          }
        ],
        [
          "comer",
          "vos comés",
          {
            "ru": "ты ешь"
          }
        ],
        [
          "vivir",
          "vos vivís",
          {
            "ru": "ты живёшь"
          }
        ],
        [
          "ser",
          "vos sos",
          {
            "ru": "ты есть"
          }
        ],
        [
          "tener",
          "vos tenés",
          {
            "ru": "у тебя есть"
          }
        ],
        [
          "querer",
          "vos querés",
          {
            "ru": "ты хочешь"
          }
