    {
      "id": "gram.es-a1-plurales",
      "title": {
        "ru": "Множественное число и «ustedes»"
      },
      "summary": {
        "ru": "Множественное число делают окончанием «-s» или «-es», и прилагательное повторяет за существительным род и число."
      },
      "points": [
        {
          "ru": "После гласной «-s»: «medialuna» → «medialunas»."
        },
        {
          "ru": "После согласной «-es»: «celular» → «celulares»."
        },
        {
          "ru": "Прилагательное согласуется: «las facturas ricas», «los colectivos llenos»."
        },
        {
          "ru": "«Вы» для нескольких людей — всегда «ustedes», и с друзьями тоже. «Vosotros» в Аргентине нет."
        }
      ],
      "table": [
