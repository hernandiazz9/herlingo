          "las medialunas"
        ],
        [
          "el celular",
          "los celulares"
        ],
        [
          "la ciudad",
          "las ciudades"
        ]
      ],
      "examples": [
        {
          "text": "Dos medialunas, por favor.",
          "ru": "Две медиалуны, пожалуйста."
        },
        {
          "text": "¡Las empanadas están riquísimas!",
          "ru": "Эмпанадас очень вкусные!"
        },
        {
          "text": "¿Ustedes son de Córdoba?",
          "ru": "Вы из Кордовы?"
        }
      ]
    },
    {
      "id": "gram.es-a1-gustar",
      "title": {
        "ru": "Me gusta — «мне нравится»"
      },
      "summary": {
        "ru": "«Gustar» работает как русское «нравится»: то, что нравится, — подлежащее. Одна вещь — «gusta», несколько — «gustan»."
      },
      "points": [
        {
          "ru": "«Me gusta el mate» — мне нравится мате."
        },
        {
          "ru": "«Me gustan las empanadas» — мне нравятся эмпанадас."
        },
        {
          "ru": "Кому: «me» (мне), «te» (тебе, «vos»), «le» (ему, ей, вам — «usted»)."
        },
        {
          "ru": "Не говори «yo gusto»: это «я нравлюсь»."
        }
      ],
      "table": [
        [
          {
            "ru": "кому"
          },
