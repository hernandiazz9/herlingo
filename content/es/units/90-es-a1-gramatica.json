    {
      "id": "gram.es-a1-articulos",
      "title": {
        "ru": "Артикли и род: el, la, un, una"
      },
      "summary": {
        "ru": "В русском артиклей нет, а в испанском они почти перед каждым существительным. И у каждого слова есть род: мужской или женский."
      },
      "points": [
        {
          "ru": "«el» / «la» — тот самый, известный: «el colectivo», «la parada»."
        },
        {
          "ru": "«un» / «una» — какой-то, один: «un café», «una medialuna»."
        },
        {
          "ru": "На «-o» обычно мужской род, на «-a» — женский: «el mate», «la birra»."
        },
        {
          "ru": "Исключения учи с артиклем: «el día», «el mapa», «la mano», «la leche»."
        },
        {
          "ru": "Женские слова на ударное «a-» берут «el»: «el agua», хотя она всё равно «fría»."
        }
      ],
      "table": [
        [
          {
            "ru": "род"
          },
          {
            "ru": "тот самый"
          },
          {
            "ru": "какой-то"
          },
          {
            "ru": "пример"
          }
        ],
        [
          {
            "ru": "мужской"
          },
          "el",
          "un",
          "el colectivo, un café"
        ],
        [
          {
            "ru": "женский"
          },
          "la",
          "una",
          "la parada, una medialuna"
        ],
        [
          {
            "ru": "мн. ч. м."
          },
          "los",
          "unos",
          "los mates"
        ],
        [
          {
            "ru": "мн. ч. ж."
          },
          "las",
          "unas",
          "las empanadas"
        ]
      ],
      "examples": [
        {
          "text": "Quiero un café.",
          "ru": "Я хочу кофе."
        },
        {
          "text": "La leche está fría.",
          "ru": "Молоко холодное."
        },
        {
          "text": "El día está lindo.",
          "ru": "День чудесный."
        }
      ]
    },
    {
      "id": "gram.es-a1-ser-estar",
      "title": {
        "ru": "Два «быть»: ser и estar"
      },
      "summary": {
        "ru": "По-русски «быть» одно, а в испанском два. «Ser» — кто ты и откуда, «estar» — где ты и как себя чувствуешь."
      },
      "points": [
        {
          "ru": "«ser»: имя, национальность, профессия, откуда: «soy ruso», «soy de Moscú»."
        },
        {
          "ru": "«estar»: место и состояние: «estoy en Córdoba», «estoy cansado»."
        },
        {
          "ru": "Вкус блюда прямо сейчас — тоже «estar»: «¡está riquísimo!»."
        },
        {
          "ru": "Русское «я — Иван» без глагола по-испански не работает: «soy Iván»."
        }
      ],
      "table": [
        [
          {
            "ru": "кто"
          },
          "ser",
          "estar"
        ],
        [
