          },
          "me gusta",
          "me gustan"
        ],
        [
          {
            "ru": "тебе (vos)"
          },
          "te gusta",
          "te gustan"
        ],
        [
          {
            "ru": "ему / ей / вам (usted)"
          },
          "le gusta",
          "le gustan"
        ]
      ],
      "examples": [
        {
          "text": "Me gusta el fernet con coca.",
          "ru": "Мне нравится фернет с колой."
        },
