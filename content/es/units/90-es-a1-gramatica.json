        ]
      ],
      "examples": [
        {
          "text": "Soy de Rusia.",
          "ru": "Я из России."
        },
        {
          "text": "Estoy en Córdoba.",
          "ru": "Я в Кордове."
        },
        {
          "text": "Flor es cordobesa, pero está en Buenos Aires.",
