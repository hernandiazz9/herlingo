  "phrases": [
    {
      "id": "es-a1-comer.un-cafe-con-leche",
      "text": "Un café con leche, por favor.",
      "ru": "Кофе с молоком, пожалуйста.",
      "explanation": {
        "ru": "Классический аргентинский завтрак в кафе. «c» перед «a» — как «к»: ка-ФЕ."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.con-dos-medialunas",
      "text": "Con dos medialunas.",
      "ru": "И две медиалуны.",
      "notes": {
        "ru": "Медиалуна — маленький сладкий круассан; «de manteca» — на сливочном масле."
      },
      "explanation": {
        "ru": "Добавляешь к кофе. ме-дья-ЛУ-нас: «медиа луна» — «полумесяц»."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.me-traes-un-cortado",
      "text": "¿Me traés un cortado?",
      "ru": "Принесёшь мне кортадо?",
      "notes": {
        "ru": "Кортадо — эспрессо с капелькой молока."
      },
      "explanation": {
        "ru": "Молодому официанту в кафе. Ударение на конце: тра-ЭС."
      },
      "register": "tu",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.me-das-un-agua",
      "text": "¿Me das un agua sin gas?",
      "ru": "Дашь воды без газа?",
      "notes": {
        "ru": "«Agua» женского рода, но говорят «el agua», «un agua» — так легче произносить."
      },
      "explanation": {
        "ru": "Просишь в кафе или в киоске. «g» между гласными мягкая: А-гуа."
      },
      "register": "tu",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.con-gas",
      "text": "Con gas, por favor.",
      "ru": "С газом, пожалуйста.",
      "explanation": {
        "ru": "Ответ на «¿con gas o sin gas?». «g» перед «a» — как русское «г»."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.una-docena-de-facturas",
      "text": "Una docena de facturas, por favor.",
      "ru": "Дюжину выпечки, пожалуйста.",
      "notes": {
        "ru": "«Facturas» — сладкая выпечка из пекарни; по воскресеньям её берут дюжинами к мате."
      },
      "explanation": {
        "ru": "В пекарне. Не путай: «factura» здесь — булочка, а не счёт-фактура."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.que-me-recomendas",
      "text": "¿Qué me recomendás?",
      "ru": "Что посоветуешь?",
      "explanation": {
        "ru": "Когда не знаешь, что взять. Ударение на конце: ре-ко-мен-ДАС."
      },
      "register": "tu",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.para-llevar",
      "text": "Para llevar.",
      "ru": "С собой.",
      "explanation": {
        "ru": "Когда берёшь еду или кофе навынос. «ll» как «ш»: ше-БАР."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.tomamos-unos-mates",
      "text": "¿Tomamos unos mates?",
      "ru": "Попьём мате?",
      "notes": {
        "ru": "Мате не «пьют», а «toman»; и почти всегда в компании."
      },
      "explanation": {
        "ru": "Так зовут в гости и на разговор. МА-тес: ударение на первый слог."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.quien-ceba",
      "text": "¿Quién ceba?",
      "ru": "Кто разливает?",
      "notes": {
        "ru": "«Cebador» заваривает мате и передаёт его по кругу каждому по очереди."
      },
      "explanation": {
        "ru": "Спрашиваешь в начале «ронды». «c» перед «e» — «с»: СЕ-ба."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.me-pasas-el-termo",
      "text": "¿Me pasás el termo?",
      "ru": "Передашь термос?",
      "explanation": {
        "ru": "Термос с горячей водой — всегда рядом с мате. па-САС, ТЕР-мо."
      },
      "register": "tu",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.no-muevas-la-bombilla",
      "text": "No muevas la bombilla.",
      "ru": "Не крути трубочку.",
      "notes": {
        "ru": "Главное правило мате: трубочку не трогают, иначе забьётся травой."
      },
      "explanation": {
        "ru": "Так тебе скажет Мартин, когда ты начнёшь мешать мате. «ll» — «ш»: бом-БИ-ша."
      },
      "register": "tu",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.esta-muy-caliente",
      "text": "¡Está muy caliente!",
      "ru": "Очень горячо!",
      "explanation": {
        "ru": "Первый глоток мате обжигает. «caliente» — горячий: ка-ЛЬЕН-те."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.uno-mas-y-listo",
      "text": "Uno más y listo.",
      "ru": "Ещё один — и хватит.",
      "explanation": {
        "ru": "Когда хочешь последний мате. «listo» — готово, хватит: ЛИС-то."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.hay-asado",
      "text": "El domingo hay asado.",
      "ru": "В воскресенье асадо.",
      "notes": {
        "ru": "Асадо — мясо на углях и главный повод собраться с семьёй и друзьями."
      },
      "explanation": {
        "ru": "Приглашение, от которого не отказываются. «h» немая: «ай»."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.un-aplauso-para-el-asador",
      "text": "¡Un aplauso para el asador!",
      "ru": "Аплодисменты асадору!",
      "notes": {
        "ru": "После асадо все хлопают тому, кто жарил мясо: это традиция."
      },
      "explanation": {
        "ru": "Кричишь в конце обеда, все поддержат. а-ПЛАУ-со: «au» — одним слогом."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.un-choripan",
      "text": "Un choripán, por favor.",
      "ru": "Чорипан, пожалуйста.",
      "notes": {
        "ru": "Чорипан — колбаска чорисо в булке; самый быстрый перекус у стадиона."
      },
      "explanation": {
        "ru": "У уличного гриля. Ударение на конце: чо-ри-ПАН."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.de-que-son-las-empanadas",
      "text": "¿De qué son las empanadas?",
      "ru": "С чем эмпанадас?",
      "notes": {
        "ru": "Начинка — с «de»: «de carne», «de pollo», «de jamón y queso»."
      },
      "explanation": {
        "ru": "Спрашиваешь в пиццерии или на рынке. ем-па-НА-дас."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.dos-de-carne-y-una-de-pollo",
      "text": "Dos de carne y una de pollo.",
      "ru": "Две с мясом и одну с курицей.",
      "explanation": {
        "ru": "Заказываешь эмпанадас по штуке. «ll» в «pollo» — «ш»: ПО-шо."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.una-milanesa-con-papas-fritas",
      "text": "Una milanesa con papas fritas.",
      "ru": "Миланесу с картошкой фри.",
      "notes": {
        "ru": "Миланеса — отбивная в панировке, любимая еда всей страны. Картошка здесь — «papa»."
      },
      "explanation": {
        "ru": "В любом бодегоне. ми-ла-НЕ-са, ПА-пас."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.soy-vegetariano",
      "text": "Soy vegetariano.",
      "ru": "Я вегетарианец.",
      "notes": {
        "ru": "На асадо это вызовет шок, но для тебя пожарят овощи и сыр «provoleta»."
      },
      "explanation": {
        "ru": "Говоришь заранее, когда зовут на асадо. Девушка — «vegetariana»."
      },
      "register": "neutral",
      "situation": "comida"
    },
    {
      "id": "es-a1-comer.esta-riquisimo",
      "text": "¡Está riquísimo!",
      "ru": "Очень вкусно!",
      "notes": {
        "ru": "«-ísimo» усиливает: «rico» — вкусный, «riquísimo» — очень вкусный."
      },
      "explanation": {
        "ru": "Лучший комплимент хозяину. ри-КИ-си-мо."
      },
      "register": "neutral",
      "situation": "comida"
    },
