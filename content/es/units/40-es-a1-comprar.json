  "phrases": [
    {
      "id": "es-a1-comprar.cuanto-es",
      "text": "¿Cuánto es?",
      "ru": "Сколько с меня?",
      "explanation": {
        "ru": "На кассе, когда всё уже выбрал. Ударение: КУАН-то."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.son-dos-mil",
      "text": "Son dos mil pesos.",
      "ru": "С тебя две тысячи песо.",
      "explanation": {
        "ru": "Так назовут сумму. «mil» не меняется: «dos mil», «tres mil»."
      },
      "register": "neutral",
      "situation": "numeros",
      "voice": "es-AR-TomasNeural"
    },
    {
      "id": "es-a1-comprar.son-mil-quinientos",
      "text": "Son mil quinientos pesos.",
      "ru": "Тысяча пятьсот песо.",
      "notes": {
        "ru": "Цены быстро растут, так что тысячи ты будешь слышать постоянно."
      },
      "explanation": {
        "ru": "Цена альфахора в киоско. «quinientos» — ки-ньен-тос, «ñ» как «нь»."
      },
      "register": "neutral",
      "situation": "numeros"
    },
    {
      "id": "es-a1-comprar.un-alfajor-y-un-agua",
      "text": "Un alfajor y un agua, por favor.",
      "ru": "Альфахор и воду, пожалуйста.",
      "notes": {
        "ru": "«Agua» женского рода, но говорят «un agua» и «el agua» — для благозвучия."
      },
      "explanation": {
        "ru": "Классический заказ в киоско. «y» между словами — просто «и»."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.tenes-chicles",
      "text": "¿Tenés chicles?",
      "ru": "У тебя есть жвачка?",
      "explanation": {
        "ru": "Спрашиваешь киоскеро. «ch» как русское «ч»: ЧИ-клес."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-cargas-la-sube",
      "text": "¿Me cargás la SUBE?",
      "ru": "Пополнишь мне SUBE?",
      "notes": {
        "ru": "Карту SUBE пополняют прямо в киоско: даёшь карту и деньги."
      },
      "explanation": {
        "ru": "В киоско с наклейкой SUBE. Ударение на конце: кар-ГАС."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.tenes-cambio",
      "text": "¿Tenés cambio?",
      "ru": "Есть мелочь? / Сдача найдётся?",
      "notes": {
        "ru": "Мелочи вечно не хватает, поэтому спрашивают до того, как дать крупную купюру."
      },
      "explanation": {
        "ru": "Перед тем как дать крупную купюру. «b» и «v» звучат одинаково: КАМ-био."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.no-tengo-cambio",
      "text": "No tengo cambio.",
      "ru": "У меня нет мелочи.",
      "explanation": {
        "ru": "Услышишь от продавца — плати переводом или картой. тен-го КАМ-био."
      },
      "register": "neutral",
      "situation": "compras",
      "voice": "es-AR-TomasNeural"
    },
    {
      "id": "es-a1-comprar.quedate-con-el-vuelto",
      "text": "Quedate con el vuelto.",
      "ru": "Сдачи не надо.",
      "literal": {
        "ru": "Оставайся со сдачей."
      },
      "notes": {
        "ru": "«Vuelto» — сдача; в Испании сказали бы «la vuelta»."
      },
      "explanation": {
        "ru": "Таксисту или киоскеро, когда сдача мелкая. ке-ДА-те: ударение на «да»."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-das-una-bolsa",
      "text": "¿Me das una bolsa?",
      "ru": "Дашь пакет?",
      "explanation": {
        "ru": "На кассе в магазине или в киоско. «b» мягкая, почти как «в»: БОЛЬ-са."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.pago-en-efectivo",
      "text": "Pago en efectivo.",
      "ru": "Я заплачу наличными.",
      "explanation": {
        "ru": "За наличные иногда дают скидку — спроси! э-фек-ТИ-во."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.solo-efectivo",
      "text": "Solo efectivo.",
      "ru": "Только наличные.",
      "explanation": {
        "ru": "Табличка или ответ продавца на ярмарке. СО-ло: «о» всегда «о», не «а»."
      },
      "register": "neutral",
      "situation": "compras",
      "voice": "es-AR-TomasNeural"
    },
    {
      "id": "es-a1-comprar.puedo-pagar-con-tarjeta",
      "text": "¿Puedo pagar con tarjeta?",
      "ru": "Можно картой?",
      "explanation": {
        "ru": "Перед покупкой в магазине или кафе. «j» — как русское «х»: тар-ХЕ-та."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.te-pago-por-transferencia",
      "text": "¿Te pago por transferencia?",
      "ru": "Могу перевести тебе?",
      "notes": {
        "ru": "В Аргентине переводы по телефону — обычное дело даже в киоско."
      },
      "explanation": {
        "ru": "Когда нет наличных. транс-фе-РЕН-сья."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-pasas-el-alias",
      "text": "¿Me pasás el alias?",
      "ru": "Скинешь алиас?",
      "notes": {
        "ru": "«Alias» — короткое имя счёта (вроде «flor.mate.cordoba»), по нему переводят деньги."
      },
      "explanation": {
        "ru": "Перед переводом. Ударение: А-льяс, па-САС."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.hay-un-almacen-por-aca",
      "text": "¿Hay un almacén por acá?",
      "ru": "Здесь поблизости есть продуктовый?",
      "explanation": {
        "ru": "Прохожему или соседу. «h» в «hay» не читается: АЙ."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.hasta-que-hora-esta-abierto",
      "text": "¿Hasta qué hora está abierto?",
      "ru": "До скольки открыто?",
      "explanation": {
        "ru": "В магазине или аптеке. «h» немая: АС-та. а-БЬЕР-то."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.es-artesanal",
      "text": "¿Es artesanal?",
      "ru": "Это ручная работа?",
      "notes": {
        "ru": "На ремесленной ярмарке в Карлос-Пасе продают калабасы для мате, ножи и сладости."
      },
      "explanation": {
        "ru": "На ярмарке у прилавка. ар-те-са-НАЛЬ: ударение на конце."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.esta-re-caro",
      "text": "¡Está re caro!",
      "ru": "Очень дорого!",
      "notes": {
        "ru": "«Re» перед словом — «очень»: «re caro», «re lindo»."
      },
      "explanation": {
        "ru": "Тихо другу, не продавцу. «r» в начале слова раскатистая: ррре."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-haces-un-descuento",
      "text": "¿Me hacés un descuento?",
      "ru": "Сделаешь скидку?",
      "notes": {
        "ru": "На ярмарке торговаться нормально, в супермаркете — нет."
      },
      "explanation": {
        "ru": "На ярмарке или если платишь наличными. «h» немая: а-СЕС."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.te-lo-dejo-en-mil",
      "text": "Te lo dejo en mil.",
      "ru": "Отдам тебе за тысячу.",
      "literal": {
        "ru": "Оставляю тебе его в тысячу."
      },
      "explanation": {
        "ru": "Так продавец уступает в цене. «j» — как «х»: ДЕ-хо."
      },
      "register": "tu",
      "situation": "compras",
      "voice": "es-AR-TomasNeural"
    },
    {
      "id": "es-a1-comprar.tenes-algo-mas-barato",
      "text": "¿Tenés algo más barato?",
      "ru": "Есть что-нибудь подешевле?",
      "explanation": {
        "ru": "Когда цена кусается. ба-РА-то: ударение на середину."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.llevo-dos",
      "text": "Llevo dos.",
      "ru": "Возьму две.",
      "explanation": {
        "ru": "Когда решил купить. «ll» в Буэнос-Айресе — как «ш»: ШЕ-во."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.estoy-mirando",
      "text": "Solo estoy mirando, gracias.",
      "ru": "Я просто смотрю, спасибо.",
      "explanation": {
        "ru": "Когда продавец спрашивает, что ищешь. «s» перед согласной мягкая: эх-ТОЙ."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.tenes-un-talle-mas-grande",
      "text": "¿Tenés un talle más grande?",
      "ru": "Есть размер побольше?",
      "notes": {
        "ru": "Размеры тут бывают маленькие: русскому «L» часто нужен «XL»."
      },
      "explanation": {
        "ru": "В магазине одежды. ТА-ще: «ll» как «ш»."
      },
      "register": "tu",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-la-puedo-probar",
      "text": "¿Me la puedo probar?",
      "ru": "Можно примерить?",
      "literal": {
        "ru": "Могу её себе примерить?"
      },
      "notes": {
        "ru": "«La» — это «la remera» или «la campera»; для мужского рода — «me lo»."
      },
      "explanation": {
        "ru": "Держа вещь в руках. про-БАР: ударение на конце."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-queda-chica",
      "text": "Me queda chica.",
      "ru": "Мне мала.",
      "literal": {
        "ru": "Мне остаётся маленькой."
      },
      "notes": {
        "ru": "Большая — «me queda grande»; в самый раз — «me queda bien»."
      },
      "explanation": {
        "ru": "Выходя из примерочной. ке-ДА ЧИ-ка."
      },
      "register": "neutral",
      "situation": "compras"
    },
    {
      "id": "es-a1-comprar.me-la-llevo",
      "text": "Me la llevo.",
      "ru": "Беру!",
      "literal": {
        "ru": "Я её уношу себе."
      },
      "explanation": {
        "ru": "Когда решил купить вещь. ШЕ-во — по-портеньо."
      },
      "register": "neutral",
      "situation": "compras"
    }
  ],
