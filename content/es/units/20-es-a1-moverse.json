  "phrases": [
    {
      "id": "es-a1-moverse.tomo-el-colectivo",
      "text": "Tomo el colectivo.",
      "ru": "Я сажусь на автобус.",
      "notes": {
        "ru": "Никогда не говори «coger el colectivo», как в Испании: здесь «coger» — очень грубое слово. Только «tomar»!"
      },
      "explanation": {
        "ru": "Рассказываешь, как добираешься. Колективо — городской автобус; разговорно «bondi»."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.que-colectivo-va",
      "text": "¿Qué colectivo va a Palermo?",
      "ru": "Какой автобус идёт до Палермо?",
      "notes": {
        "ru": "Палермо — это район Буэнос-Айреса, где живёт Мартин, а не Сицилия."
      },
      "explanation": {
        "ru": "Спрашиваешь на остановке у людей в очереди. «v» = «б»: ке ко-лек-ТИ-бо БА."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.toma-el-sesenta",
      "text": "Tomá el sesenta.",
      "ru": "Садись на шестидесятый.",
      "notes": {
        "ru": "Автобусы называют по номеру: «el sesenta», «el ciento cincuenta y dos»."
      },
      "explanation": {
        "ru": "Так тебе подскажет друг. «Tomá» — повелительное для «vos», ударение на конце: то-МА."
      },
      "register": "tu",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.donde-esta-la-parada",
      "text": "¿Dónde está la parada?",
      "ru": "Где остановка?",
      "explanation": {
        "ru": "Ищешь остановку колективо. «Está» с ударением: эс-ТА — «находится»."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.tengo-que-cargar-la-sube",
      "text": "Tengo que cargar la SUBE.",
      "ru": "Мне надо пополнить SUBE.",
      "notes": {
        "ru": "SUBE — транспортная карта для колективо, субте и электричек; пополняют её в киоске."
      },
      "explanation": {
        "ru": "Говоришь в киоске или другу у турникета. SUBE читается «СУ-бе»."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.no-tengo-saldo",
      "text": "No tengo saldo.",
      "ru": "У меня на карте ноль.",
      "explanation": {
        "ru": "Когда турникет пищит, а денег на SUBE нет. «saldo» — баланс: САЛЬ-до."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.me-prestas-la-sube",
      "text": "¿Me prestás la SUBE?",
      "ru": "Одолжишь SUBE?",
      "explanation": {
        "ru": "Просишь у друга карту, когда твоя пустая. Ударение на конце: прес-ТАС."
      },
      "register": "tu",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.va-al-centro",
      "text": "¿Este colectivo va al centro?",
      "ru": "Этот автобус идёт в центр?",
      "explanation": {
        "ru": "Спрашиваешь водителя, входя в автобус. «a + el» сливается в «al»."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.me-avisa-donde-bajo",
      "text": "¿Me avisa dónde tengo que bajar?",
      "ru": "Скажете, где мне выходить?",
      "explanation": {
        "ru": "Просишь водителя или пожилую соседку. Ударение: а-БИ-са — «v» снова как «б»."
      },
      "register": "usted",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.bajo-en-la-proxima",
      "text": "Bajo en la próxima.",
      "ru": "Я выхожу на следующей.",
      "notes": {
        "ru": "В колективо выходят через заднюю дверь и звонят в звонок."
      },
      "explanation": {
        "ru": "Протискиваешься к двери. «x» в «próxima» звучит «кс»: ПРОК-си-ма."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.me-bajo-aca",
      "text": "Me bajo acá.",
      "ru": "Я выхожу здесь.",
      "notes": {
        "ru": "«Acá» — «здесь» по-аргентински; в Испании чаще «aquí»."
      },
      "explanation": {
        "ru": "Когда твоя остановка прямо сейчас. Ударение: а-КА."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.donde-esta-el-subte",
      "text": "¿Dónde está el subte?",
      "ru": "Где метро?",
      "notes": {
        "ru": "Метро в Буэнос-Айресе — «subte», от «subterráneo» (подземный)."
      },
      "explanation": {
        "ru": "Спрашиваешь на улице. СУБ-те: «e» на конце чёткое, не «и»."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
      "id": "es-a1-moverse.donde-queda-el-centro",
      "text": "¿Dónde queda el centro?",
      "ru": "Где находится центр?",
      "notes": {
        "ru": "«Quedar» — «находиться» для мест; в Аргентине так говорят постоянно."
      },
      "explanation": {
        "ru": "Спрашиваешь дорогу у прохожего. «qu» читается «к»: КЕ-да."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.esta-a-dos-cuadras",
      "text": "Está a dos cuadras.",
      "ru": "Это в двух кварталах.",
      "notes": {
        "ru": "«Cuadra» — квартал, примерно сто метров; аргентинцы всё меряют в куадрах."
      },
      "explanation": {
        "ru": "Так тебе ответят на «¿dónde queda?». КУА-драс: «u» после «c» звучит."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.segui-derecho",
      "text": "Seguí derecho.",
      "ru": "Иди прямо.",
      "notes": {
        "ru": "«Derecho» — прямо, а «a la derecha» — направо. Легко перепутать!"
      },
      "explanation": {
        "ru": "Объяснение дороги. «Seguí» — повелительное для «vos»: се-ГИ."
      },
      "register": "tu",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.dobla-a-la-derecha",
      "text": "Doblá a la derecha.",
      "ru": "Поверни направо.",
      "explanation": {
        "ru": "Объясняешь или слушаешь дорогу. до-БЛА: ударение на конце, как у всех команд на «vos»."
      },
      "register": "tu",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.dobla-a-la-izquierda",
      "text": "Doblá a la izquierda.",
      "ru": "Поверни налево.",
      "explanation": {
        "ru": "Пара к «a la derecha». ис-КЬЕР-да: «z» звучит как «с»."
      },
      "register": "tu",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.esta-cerca",
      "text": "¿Está cerca?",
      "ru": "Это близко?",
      "explanation": {
        "ru": "Решаешь, идти пешком или ехать. СЕР-ка: «c» перед «e» — как «с»."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.esta-re-lejos",
      "text": "Está re lejos.",
      "ru": "Это очень далеко.",
      "notes": {
        "ru": "«Re» — «очень» по-аргентински: «re lejos», «re lindo», «re caro»."
      },
      "explanation": {
        "ru": "Когда идти пешком — плохая идея. «j» — как русское «х»: ЛЕ-хос."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.se-puede-ir-caminando",
      "text": "¿Se puede ir caminando?",
      "ru": "Туда можно дойти пешком?",
      "explanation": {
        "ru": "Спрашиваешь в хостеле или у прохожего. ка-ми-НАН-до: ударение на «нан»."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.me-perdi",
      "text": "Me perdí.",
      "ru": "Я заблудился.",
      "explanation": {
        "ru": "Пишешь другу или говоришь прохожему. Ударение на конце: пер-ДИ."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.caminamos-por-la-canada",
      "text": "Caminamos por la Cañada.",
      "ru": "Гуляем вдоль Каньяды.",
      "notes": {
        "ru": "Ла-Каньяда — канал с каменными стенами и деревьями прямо в центре Кордовы."
      },
      "explanation": {
        "ru": "Флор показывает тебе свою Кордову. «ñ» звучит «нь»: ка-НЬЯ-да."
      },
      "register": "neutral",
      "situation": "ciudad"
    },
    {
      "id": "es-a1-moverse.cuanto-sale",
      "text": "¿Cuánto sale?",
      "ru": "Сколько стоит?",
      "notes": {
        "ru": "Аргентинцы чаще говорят «¿cuánto sale?», чем «¿cuánto cuesta?»."
      },
      "explanation": {
        "ru": "Спрашиваешь цену поездки или чего угодно. КУАН-то."
      },
      "register": "neutral",
      "situation": "transporte"
    },
    {
