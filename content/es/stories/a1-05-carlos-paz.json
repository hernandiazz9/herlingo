  "voice": "es-UY-ValentinaNeural",
  "sentences": [
    {
      "id": "s1",
      "text": "El finde, Iván y Flor van a Villa Carlos Paz.",
      "ru": "На выходные Иван и Флор едут в Вилья-Карлос-Пас."
    },
    {
      "id": "s2",
      "text": "Ahí vive Doña Marta, la abuela de Flor.",
      "ru": "Там живёт донья Марта, бабушка Флор."
    },
    {
      "id": "s3",
      "text": "Doña Marta le pregunta: «¿Usted es el ruso?»",
      "ru": "Донья Марта спрашивает его: «Вы и есть тот русский?»"
    },
    {
      "id": "s4",
      "text": "En la casa hay un reloj cucú.",
      "ru": "В доме висят часы с кукушкой."
    },
    {
      "id": "s5",
      "text": "A la tarde van al lago. Hay mucho sol.",
      "ru": "Днём они идут на озеро. Солнце жарит вовсю."
    },
    {
      "id": "s6",
      "text": "«¡Ponete protector, Iván!»",
      "ru": "«Намажься кремом, Иван!»",
      "voice": "es-AR-ElenaNeural"
    },
    {
      "id": "s7",
      "text": "«No, gracias. En Rusia nunca hay sol.»",
      "ru": "«Нет, спасибо. В России солнца никогда не бывает.»",
      "voice": "es-UY-MateoNeural"
    },
    {
      "id": "s8",
      "text": "A la noche, Iván está rojo como un tomate.",
      "ru": "Вечером Иван красный как помидор."
    },
    {
      "id": "s9",
      "text": "«Me quemé con el sol», dice. Le duele todo.",
      "ru": "«Я сгорел на солнце», — говорит он. У него всё болит."
    },
    {
      "id": "s10",
      "text": "Doña Marta le trae una crema y un té.",
      "ru": "Донья Марта приносит ему крем и чай."
    },
    {
      "id": "s11",
      "text": "Y toda la noche, el reloj canta: «¡Cucú!»",
      "ru": "А часы всю ночь поют: «Ку-ку!»"
    }
  ],
