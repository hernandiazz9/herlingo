  "sentences": [
    {
      "id": "s1",
      "text": "Pasan tres meses. Iván ya vive como un porteño.",
      "ru": "Проходит три месяца. Иван уже живёт как настоящий портеньо."
    },
    {
      "id": "s2",
      "text": "Hoy está en el bar de la esquina con Martín.",
      "ru": "Сегодня он с Мартином в баре на углу."
    },
    {
      "id": "s3",
      "text": "«¿Me traés un cortado y dos medialunas?»",
      "ru": "«Принесёшь мне кортадо и две медиалуны?»",
      "voice": "es-UY-MateoNeural"
    },
    {
      "id": "s4",
      "text": "El mozo entiende todo a la primera.",
      "ru": "Официант понимает всё с первого раза."
    },
    {
      "id": "s5",
      "text": "«¡Che, Iván, hablás re bien!»",
      "ru": "«Слушай, Иван, ты классно говоришь!»",
      "voice": "es-AR-TomasNeural"
    },
    {
      "id": "s6",
      "text": "«¡Re bien no! Hablo un poquito de castellano.»",
      "ru": "«Ну не классно! Я немного говорю по-испански.»",
      "voice": "es-UY-MateoNeural"
    },
    {
      "id": "s7",
      "text": "Martín se ríe. Iván ya dice «re», «dale» y «che».",
      "ru": "Мартин смеётся. Иван уже говорит «re», «dale» и «che»."
    },
    {
      "id": "s8",
      "text": "Después llama Flor desde Córdoba.",
      "ru": "Потом звонит Флор из Кордовы."
    },
    {
      "id": "s9",
      "text": "«¿Qué hacés, Iván? ¿Venís el finde?»",
      "ru": "«Как дела, Иван? Приедешь на выходные?»",
      "voice": "es-AR-ElenaNeural"
    },
    {
      "id": "s10",
      "text": "«¡Dale! Voy a ir a Córdoba el viernes.»",
      "ru": "«Давай! Я поеду в Кордову в пятницу.»",
      "voice": "es-UY-MateoNeural"
    },
    {
      "id": "s11",
      "text": "«¡Re lindo! Te espero con un fernet.»",
      "ru": "«Супер! Жду тебя с фернетом.»",
      "voice": "es-AR-ElenaNeural"
    }
