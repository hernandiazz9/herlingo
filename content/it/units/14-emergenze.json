      "distractors": [
        { "text": "Sì, ha bisogno di aiuto.", "es": "Sí, necesita ayuda." },
        { "text": "Prego, si figuri.", "es": "De nada, no hay de qué." }
      ],
      "register": "lei",
      "situation": "emergencias",
      "voice": "it-IT-DiegoNeural"
    },
