  "phrases": [
    { "id": "emer.aiuto", "text": "Aiuto!", "es": "¡Socorro! / ¡Ayuda!", "explanation": "Grítalo si tú u otra persona estáis en peligro. Tres sílabas, acento en «iu»: a-IU-to.", "register": "neutral", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.e-un-emergenza", "text": "È un'emergenza!", "es": "¡Es una emergencia!", "explanation": "Para que te atiendan ya en una farmacia, un hotel o por teléfono. «gen» suena «dyen» y la «z», «ts»: e-mer-DYEN-tsa.", "register": "neutral", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.chiami-il-112", "text": "Chiami il 112!", "es": "¡Llame al 112!", "notes": "El 112 es el número único de emergencias, como en España.", "explanation": "Pídeselo a quien tengas cerca si hay un accidente o alguien se desmaya. «chia» suena «kia»: KIA-mi.", "register": "lei", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.chiami-un-ambulanza", "text": "Chiami un'ambulanza!", "es": "¡Llame a una ambulancia!", "explanation": "Pídeselo a quien esté cerca si alguien se ha hecho daño. «chia» suena «kia» y la «z», «ts»: am-bu-LAN-tsa.", "register": "lei", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.chiami-la-polizia", "text": "Chiami la polizia!", "es": "¡Llame a la policía!", "explanation": "Si ves un robo o una pelea, pídeselo a quien tengas cerca. «zia» suena «tsia»: po-li-TSI-a.", "register": "lei", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.mi-puo-aiutare", "text": "Mi può aiutare, per favore?", "es": "¿Me puede ayudar, por favor?", "explanation": "Para pedir ayuda a un desconocido de forma educada. «può» es una sola sílaba: mi PUO a-iu-TA-re.", "register": "lei", "situation": "emergencias" },
    { "id": "emer.sto-male", "text": "Sto male.", "es": "Me encuentro mal.", "explanation": "Dilo en la farmacia, en el hotel o a quien te acompañe si te encuentras fatal. Acento en «ma»: sto MA-le.", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.dov-e-l-ospedale", "text": "Dov'è l'ospedale più vicino?", "es": "¿Dónde está el hospital más cercano?", "explanation": "Pregúntalo en la farmacia o en recepción si necesitas urgencias. Acento en «da»: lo-spe-DA-le.", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.attenzione", "text": "Attenzione!", "es": "¡Cuidado!", "explanation": "Para avisar a alguien de un peligro: una moto, un escalón. «zio» suena «tsio» y marca la doble «t»: at-ten-TSIO-ne.", "register": "neutral", "situation": "emergencias" },

    { "id": "emer.al-ladro", "text": "Al ladro!", "es": "¡Al ladrón!", "explanation": "Grítalo si ves que alguien roba un bolso o una cartera. Marca la doble «l»: al-LA-dro.", "register": "neutral", "situation": "emergencias", "tags": ["urgente"] },
    { "id": "emer.mi-hanno-rubato", "text": "Mi hanno rubato il portafoglio.", "es": "Me han robado la cartera.", "explanation": "Para contarlo a la policía, en el hotel o a quien te ayude. La «h» es muda: mi AN-no ru-BA-to, con doble «n».", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.ho-perso-il-passaporto", "text": "Ho perso il passaporto.", "es": "He perdido el pasaporte.", "explanation": "En la policía, el consulado o el hotel. La «h» es muda: o PER-so; marca la doble «s»: pas-sa-POR-to.", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.ho-perso-il-telefono", "text": "Ho perso il telefono.", "es": "He perdido el móvil.", "explanation": "Para contarlo en el hotel, en un bar o en objetos perdidos. Acento en «le»: te-LE-fo-no.", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.mi-sono-perso", "text": "Mi sono perso.", "es": "Me he perdido.", "explanation": "Para pedir ayuda por la calle; si eres mujer, «mi sono persa». Acento en «per»: mi SO-no PER-so.", "register": "neutral", "situation": "emergencias" },
    { "id": "emer.dove-denuncia", "text": "Dove posso fare una denuncia?", "es": "¿Dónde puedo poner una denuncia?", "notes": "Te mandarán a la «questura» (policía) o a los carabinieri.", "explanation": "Pregúntalo en el hotel tras un robo o una pérdida. «cia» suena «cha»: de-NUN-cha.", "register": "neutral", "situation": "emergencias" },

    { "id": "emer.non-mi-sento-bene", "text": "Non mi sento bene.", "es": "No me encuentro bien.", "explanation": "Para decir en la farmacia o al médico que algo no va bien. Acento en «sen»: non mi SEN-to BE-ne.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.ho-bisogno-di-un-medico", "text": "Ho bisogno di un medico.", "es": "Necesito un médico.", "explanation": "En la farmacia, el hotel o a quien te ayude. «gn» es una «ñ»: bi-SO-ño; acento en «me»: ME-di-ko.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.c-e-una-guardia-medica", "text": "C'è una guardia medica qui vicino?", "es": "¿Hay un médico de guardia por aquí cerca?", "notes": "En verano hay «guardia medica turistica» para visitantes.", "explanation": "Para una consulta no grave, sobre todo en verano en zonas turísticas. «c'è» suena «che»; acento en «me»: ME-di-ka.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.ho-la-febbre", "text": "Ho la febbre.", "es": "Tengo fiebre.", "explanation": "Para explicárselo al farmacéutico o al médico. La «h» es muda; marca la doble «b»: FEB-bre.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.ho-preso-troppo-sole", "text": "Ho preso troppo sole.", "es": "Me ha dado demasiado el sol.", "literal": "He cogido demasiado sol.", "explanation": "Si te has pasado de playa y te encuentras mal. Marca la doble «p»: TROP-po SO-le.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.da-quando", "text": "Da quando?", "es": "¿Desde cuándo?", "explanation": "Te lo preguntará el médico o el farmacéutico sobre tus síntomas. «qua» suena «kua»: da KUAN-do.", "register": "neutral", "situation": "emergencias", "tags": ["salud", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "emer.da-ieri", "text": "Da ieri.", "es": "Desde ayer.", "explanation": "Para responder cuándo empezó el dolor o la fiebre. «ie» se dice junto: da IE-ri.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.sono-allergico-penicillina", "text": "Sono allergico alla penicillina.", "es": "Soy alérgico a la penicilina.", "explanation": "Díselo siempre al médico o al farmacéutico. «gi» suena «dyi» y «ci» «chi»: al-LER-dyi-ko, pe-ni-chil-LI-na.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },

    { "id": "emer.dove-le-fa-male", "text": "Dove Le fa male?", "es": "¿Dónde le duele?", "explanation": "Te lo preguntará el médico o el farmacéutico: señala la zona. Acento en «ma»: DO-ve le fa MA-le.", "register": "lei", "situation": "emergencias", "tags": ["salud", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "emer.mi-fa-male-la-testa", "text": "Mi fa male la testa.", "es": "Me duele la cabeza.", "notes": "Con plural: «mi fanno male i piedi».", "explanation": "En la farmacia o para explicar por qué no te apetece salir. Acento en «ma» y en «te»: mi fa MA-le la TE-sta.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.mi-fa-male-la-pancia", "text": "Mi fa male la pancia.", "es": "Me duele la barriga.", "explanation": "Para explicar un malestar de estómago en la farmacia. «cia» suena «cha»: PAN-cha.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.ho-mal-di-gola", "text": "Ho mal di gola.", "es": "Me duele la garganta.", "literal": "Tengo mal de garganta.", "explanation": "En la farmacia, tras tanto aire acondicionado. La «h» es muda: o mal di GO-la.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.mi-sono-fatto-male", "text": "Mi sono fatto male alla caviglia.", "es": "Me he hecho daño en el tobillo.", "explanation": "Tras una torcedura en la playa o en una escalera. «glia» suena como una «ll» suave: ka-VI-lla.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },
    { "id": "emer.mi-ha-punto-una-medusa", "text": "Mi ha punto una medusa.", "es": "Me ha picado una medusa.", "explanation": "Para pedir ayuda al socorrista o en la farmacia de la playa. La «h» es muda; acento en «du»: me-DU-sa.", "register": "neutral", "situation": "emergencias", "tags": ["salud"] },

    { "id": "emer.c-e-una-farmacia", "text": "C'è una farmacia qui vicino?", "es": "¿Hay una farmacia por aquí cerca?", "explanation": "Para cualquier dolor leve: en Italia el farmacéutico aconseja mucho. Acento en «ci», que suena «chi»: far-ma-CHI-a.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.farmacia-di-turno", "text": "Qual è la farmacia di turno?", "es": "¿Cuál es la farmacia de guardia?", "notes": "La lista está colgada en la puerta de cualquier farmacia.", "explanation": "Para encontrar una abierta de noche o en festivo. «r» vibrante: di TUR-no.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.mi-dica", "text": "Buongiorno, mi dica.", "es": "Buenos días, dígame.", "explanation": "Te lo dirán al llegar al mostrador de la farmacia o de una tienda. Acento en «di»: mi DI-ka.", "register": "lei", "situation": "emergencias", "tags": ["farmacia", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "emer.ha-qualcosa-per-il-mal-di-testa", "text": "Ha qualcosa per il mal di testa?", "es": "¿Tiene algo para el dolor de cabeza?", "explanation": "En la farmacia, para pedir un analgésico. La «h» es muda: a kual-KO-sa.", "register": "lei", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.tachipirina", "text": "Una Tachipirina, per favore.", "es": "Un paracetamol, por favor.", "notes": "Tachipirina es la marca de paracetamol que todo el mundo pide.", "explanation": "En la farmacia, la forma más rápida de pedir paracetamol. «chi» suena «ki»: ta-ki-pi-RI-na.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.ci-vuole-la-ricetta", "text": "Ci vuole la ricetta?", "es": "¿Hace falta receta?", "explanation": "Pregúntalo antes de pedir un medicamento. «ci» suena «chi» y la «tt» se alarga: chi VUO-le la ri-CHET-ta.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.senza-ricetta", "text": "Senza ricetta non posso darglielo.", "es": "Sin receta no se lo puedo dar.", "explanation": "Te lo dirá el farmacéutico si pides algo que necesita receta. La «z» suena «ts»: SEN-tsa ri-CHET-ta.", "register": "lei", "situation": "emergencias", "tags": ["farmacia", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "emer.quante-volte", "text": "Quante volte al giorno?", "es": "¿Cuántas veces al día?", "explanation": "Pregúntalo al farmacéutico al comprar un medicamento. «qua» suena «kua»: KUAN-te VOL-te.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.due-volte-al-giorno", "text": "Due volte al giorno, dopo i pasti.", "es": "Dos veces al día, después de las comidas.", "explanation": "Así te explicará el farmacéutico cómo tomarlo. «gior» suena «dyor»: al DYOR-no.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia", "escuchar"], "voice": "it-IT-IsabellaNeural" },

    { "id": "emer.vorrei-crema-solare", "text": "Vorrei una crema solare con protezione alta.", "es": "Quería una crema solar de protección alta.", "explanation": "En la farmacia o el súper antes de ir a la playa. Marca la doble «r»: vor-REI.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.ho-una-scottatura", "text": "Ho una scottatura. Cosa mi consiglia?", "es": "Me he quemado con el sol. ¿Qué me recomienda?", "explanation": "En la farmacia tras demasiado sol. «sco» es «sko» y marca las dobles «t»: skot-ta-TU-ra.", "register": "lei", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.punture-di-zanzara", "text": "Mi serve qualcosa per le punture di zanzara.", "es": "Necesito algo para las picaduras de mosquito.", "explanation": "En la farmacia, tras las noches de verano con ventana abierta. La «z» suena «dz»: dzan-DZA-ra.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.vorrei-dei-cerotti", "text": "Vorrei dei cerotti, per favore.", "es": "Quería unas tiritas, por favor.", "explanation": "En la farmacia o el súper si las sandalias te hacen rozaduras. «ce» suena «che»: che-ROT-ti.", "register": "neutral", "situation": "emergencias", "tags": ["farmacia"] },
    { "id": "emer.sciroppo-per-la-tosse", "text": "Ha uno sciroppo per la tosse?", "es": "¿Tiene un jarabe para la tos?", "explanation": "En la farmacia si tienes tos. «sci» suena «shi»: shi-ROP-po.", "register": "lei", "situation": "emergencias", "tags": ["farmacia"] }
  ],
