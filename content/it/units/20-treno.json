  "phrases": [
    { "id": "move-treno.vorrei-un-biglietto-per", "text": "Vorrei un biglietto per Cefalù.", "es": "Quería un billete para Cefalù.", "literal": "Querría un billete para Cefalù.", "notes": "«Vorrei» es la forma educada de pedir; «voglio» suena brusco.", "explanation": "En la taquilla o a la máquina de billetes. «Vorrei» con «rr» vibrante y «gli» como una «ll» suave: bi-LLET-to.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.solo-andata", "text": "Solo andata, per favore.", "es": "Solo ida, por favor.", "explanation": "Respuesta rápida cuando en la taquilla te preguntan «andata o andata e ritorno?». Acento en la segunda «a»: an-DA-ta.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.andata-e-ritorno", "text": "Andata e ritorno, per favore.", "es": "Ida y vuelta, por favor.", "explanation": "En la taquilla, si vas a volver al mismo sitio. Une las palabras sin pausa: an-DA-ta-e-ri-TOR-no.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.due-biglietti-per", "text": "Due biglietti per Agrigento, per favore.", "es": "Dos billetes para Agrigento, por favor.", "explanation": "En la taquilla, cuando compras para dos. «Due» tiene dos sílabas, DU-e, y «gli» suena como una «ll» suave.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.quanto-costa-il-biglietto", "text": "Quanto costa il biglietto?", "es": "¿Cuánto cuesta el billete?", "explanation": "Antes de pagar, en la taquilla o al revisor. La doble «tt» se alarga con una mini pausa: bi-LLET-to.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.dove-si-comprano-i-biglietti", "text": "Dove si comprano i biglietti?", "es": "¿Dónde se compran los billetes?", "explanation": "En una estación pequeña sin taquilla a la vista: pregúntalo en el bar o al personal. Acento en «COM»: COM-pra-no.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.posso-pagare-con-la-carta", "text": "Posso pagare con la carta?", "es": "¿Puedo pagar con tarjeta?", "explanation": "Antes de pagar en la taquilla, un bar o una tienda. La doble «ss» de «posso» es sorda y larga: POS-so.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.a-che-ora-parte", "text": "A che ora parte il prossimo treno per Catania?", "es": "¿A qué hora sale el próximo tren para Catania?", "explanation": "En la taquilla o a alguien de la estación. «che» se dice «ke» y «prossimo» lleva «ss» larga: PROS-si-mo.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.c-e-un-treno-diretto", "text": "C'è un treno diretto?", "es": "¿Hay un tren directo?", "explanation": "Al planear un trayecto, para evitar transbordos. «C'è» suena «che», con «e» abierta; «diretto» con «tt» larga.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.devo-cambiare", "text": "Devo cambiare treno?", "es": "¿Tengo que hacer transbordo?", "literal": "¿Debo cambiar de tren?", "explanation": "Al comprar el billete o mirar la ruta, para saber si hay enlace. «cambiare» se dice cam-BIA-re, con la «i» muy breve.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.andata-o-andata-e-ritorno", "text": "Andata o andata e ritorno?", "es": "¿Ida o ida y vuelta?", "explanation": "Te lo pregunta el taquillero al pedir un billete: contesta «solo andata» o «andata e ritorno». Escucha bien la «o» del medio.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.per-che-giorno", "text": "Per che giorno?", "es": "¿Para qué día?", "explanation": "Te lo pregunta el taquillero si el billete lleva fecha. «giorno» suena «DJOR-no»: la «i» no se pronuncia.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.sono-sei-euro-e-dieci", "text": "Sono sei euro e dieci.", "es": "Son seis euros con diez.", "explanation": "Así te dice el precio el taquillero o el revisor. «euro» tiene tres sílabas, É-u-ro, y «dieci» suena «DIE-chi».", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.da-che-binario", "text": "Da che binario parte il treno per Siracusa?", "es": "¿De qué andén sale el tren para Siracusa?", "explanation": "Si no ves tu tren en el panel de salidas. «binario» lleva el acento en «NA»: bi-NA-rio.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.dov-e-il-binario-quattro", "text": "Dov'è il binario quattro?", "es": "¿Dónde está el andén cuatro?", "explanation": "Cuando sabes el andén pero no lo encuentras. «quattro» con doble «tt» larga: KUAT-tro.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.questo-treno-va-a", "text": "Questo treno va a Palermo Centrale?", "es": "¿Este tren va a Palermo Centrale?", "explanation": "Justo antes de subir, al revisor o a otro pasajero. «questo» se dice «KUES-to»; «Centrale» con acento en «TRA».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.e-questo-il-treno-per", "text": "È questo il treno per Taormina?", "es": "¿Es este el tren para Taormina?", "explanation": "En el andén, para asegurarte antes de subir. «È» es una «e» abierta; sube la entonación al final.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.a-che-ora-arriva", "text": "A che ora arriva a Siracusa?", "es": "¿A qué hora llega a Siracusa?", "explanation": "Al revisor o en la taquilla, para calcular la llegada. «arriva» con «rr» vibrante: ar-RI-va.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.quante-fermate-mancano", "text": "Quante fermate mancano per Cefalù?", "es": "¿Cuántas paradas quedan para Cefalù?", "explanation": "En el tren, a otro pasajero o al revisor. Acento en la primera sílaba: MAN-ca-no.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.mi-dice-quando-scendere", "text": "Mi può dire quando devo scendere?", "es": "¿Me puede decir cuándo me tengo que bajar?", "explanation": "Al revisor o a quien va a tu lado si no conoces la parada. «scendere» suena «SHEN-de-re».", "register": "lei", "situation": "tren" },
    { "id": "move-treno.guardi-il-tabellone", "text": "Guardi il tabellone delle partenze.", "es": "Mire el panel de salidas.", "explanation": "Te lo dicen en información si preguntas por un andén. «tabellone» lleva «ll» larga, no como nuestra «ll»: ta-bel-LO-ne.", "register": "lei", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.in-partenza", "text": "Il regionale per Agrigento Centrale è in partenza dal binario due.", "es": "El regional para Agrigento Centrale está a punto de salir del andén dos.", "notes": "Aviso por megafonía: fíjate en el destino y el «binario».", "explanation": "Lo oirás por megafonía en la estación: fíjate en el andén. «partenza» suena «par-TEN-tsa»: la «z» es «ts».", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.in-arrivo", "text": "Il treno è in arrivo al binario tre.", "es": "El tren está llegando al andén tres.", "explanation": "Aviso por megafonía: el tren está entrando en el andén. «arrivo» con «rr» fuerte: ar-RI-vo.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.allontanarsi-dalla-linea-gialla", "text": "Allontanarsi dalla linea gialla.", "es": "Aléjense de la línea amarilla.", "notes": "Aviso típico cuando pasa un tren sin parar.", "explanation": "Cuando lo oigas, da un paso atrás en el andén. «gialla» suena «DJAL-la», con «ll» larga.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.devo-convalidare", "text": "Devo convalidare il biglietto?", "es": "¿Tengo que validar el billete?", "notes": "El billete de papel se valida en la estación antes de subir; si no, multa.", "explanation": "Pregúntalo en la estación si tu billete es de papel. Acento en «DA»: con-va-li-DA-re.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.dove-si-convalida", "text": "Dove si convalida il biglietto?", "es": "¿Dónde se valida el billete?", "explanation": "Para encontrar la maquinita de validar antes de subir al andén. Acento en «VA»: con-VA-li-da.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.la-macchinetta-non-funziona", "text": "La macchinetta non funziona.", "es": "La máquina no funciona.", "explanation": "Al revisor o en la taquilla si no has podido validar. «macchinetta» suena «mak-ki-NET-ta»: «cch» es «k».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.l-ho-comprato-online", "text": "L'ho comprato online.", "es": "Lo he comprado por internet.", "explanation": "Al revisor, mientras le enseñas el billete en el móvil. «L'ho» suena «lo»: la «h» es muda.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.ecco-il-biglietto", "text": "Ecco il biglietto.", "es": "Aquí tiene el billete.", "explanation": "Al revisor, al darle el billete. «Ecco» con doble «c» larga: EK-ko.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.non-sapevo", "text": "Scusi, non sapevo di doverlo convalidare.", "es": "Perdone, no sabía que había que validarlo.", "explanation": "Si el revisor te pilla con el billete sin validar; dilo con calma y educación. «doverlo» lleva el acento en «VER».", "register": "lei", "situation": "tren" },
    { "id": "move-treno.posso-fare-il-biglietto-a-bordo", "text": "Posso fare il biglietto a bordo?", "es": "¿Puedo sacar el billete en el tren?", "notes": "A bordo suele tener recargo: mejor sácalo antes.", "explanation": "En el andén, si la taquilla está cerrada o la máquina falla. «bordo» con una sola «r» suave: BOR-do.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.biglietto-prego", "text": "Biglietto, prego.", "es": "Billete, por favor.", "notes": "Lo dice el revisor al pasar por el vagón.", "explanation": "Lo oirás del revisor al pasar por el vagón: enséñale el billete. «prego» con «e» abierta: PRE-go.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.non-e-convalidato", "text": "Il biglietto non è convalidato.", "es": "El billete no está validado.", "explanation": "Te lo dice el revisor si olvidaste validar: explícate o te multa. Acento en «DA»: con-va-li-DA-to.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.ha-fatto-il-check-in", "text": "Ha fatto il check-in?", "es": "¿Ha hecho el check-in?", "notes": "Un billete regional digital sin tren fijo se activa en la app antes de subir.", "explanation": "Te lo pregunta el revisor si tu billete digital había que activarlo. «fatto» con «tt» larga: FAT-to.", "register": "lei", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.documento-per-favore", "text": "Un documento, per favore.", "es": "Documentación, por favor.", "explanation": "Te lo pide el revisor, por ejemplo para una multa: enséñale el DNI o el pasaporte. Acento en «MEN»: do-cu-MEN-to.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.deve-pagare-una-multa", "text": "Deve pagare una multa.", "es": "Tiene que pagar una multa.", "explanation": "Te lo dice el revisor si el billete no es válido. «deve» suena «DE-ve», con la «v» entre los dientes y el labio.", "register": "lei", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.tutto-a-posto", "text": "Tutto a posto, grazie.", "es": "Todo en orden, gracias.", "explanation": "Te lo dice el revisor cuando tu billete está bien. «tutto» con «tt» larga: TUT-to.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.il-treno-e-in-ritardo", "text": "Il treno è in ritardo?", "es": "¿El tren va con retraso?", "explanation": "Al personal de la estación si tu tren no aparece. «ritardo» lleva el acento en «TAR»: ri-TAR-do.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.quanto-ritardo-ha", "text": "Quanto ritardo ha?", "es": "¿Cuánto retraso lleva?", "explanation": "Cuando ya sabes que va con retraso y quieres saber cuánto. La «h» de «ha» es muda: suena «a».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.ritardo-di-venti-minuti", "text": "Il treno viaggia con un ritardo di venti minuti.", "es": "El tren circula con veinte minutos de retraso.", "explanation": "Lo oirás por megafonía o lo verás en el panel. «viaggia» suena «VIAD-dja».", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.e-stato-cancellato", "text": "Il treno è stato cancellato?", "es": "¿Han cancelado el tren?", "explanation": "Si tu tren desaparece del panel. «cancellato» suena «kan-chel-LA-to»: «ce» es «che».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.il-treno-e-stato-soppresso", "text": "Il treno è stato soppresso.", "es": "El tren ha sido suprimido.", "explanation": "En paneles y megafonía «soppresso» significa cancelado. Doble «pp» y doble «ss»: sop-PRES-so.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.cambio-di-binario", "text": "Cambio di binario: il treno partirà dal binario sette.", "es": "Cambio de andén: el tren saldrá del andén siete.", "explanation": "Aviso por megafonía: ve rápido al nuevo andén. «partirà» lleva el acento al final: par-ti-RÀ.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.oggi-c-e-sciopero", "text": "Oggi c'è sciopero?", "es": "¿Hoy hay huelga?", "explanation": "En la estación si ves avisos raros o poca gente. «sciopero» suena «SHO-pe-ro».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.treni-garantiti", "text": "Sono garantiti i treni dalle sei alle nove.", "es": "Están garantizados los trenes de seis a nueve.", "notes": "En huelga hay franjas garantizadas: de 6 a 9 y de 18 a 21 los días laborables.", "explanation": "Lo oirás o leerás en días de huelga: solo esos trenes circulan seguro. Acento en «TI»: ga-ran-TI-ti.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.c-e-un-autobus-sostitutivo", "text": "C'è un autobus sostitutivo?", "es": "¿Hay un autobús que sustituya al tren?", "notes": "Con obras o averías, Trenitalia pone «bus sostitutivi».", "explanation": "Si hay obras o una avería en la vía. Ojo: «autobus» lleva el acento en «AU»: AU-to-bus.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.ho-perso-la-coincidenza", "text": "Ho perso la coincidenza.", "es": "He perdido el enlace.", "explanation": "En la taquilla o al revisor si tu tren llegó tarde. «coincidenza» suena «ko-in-chi-DEN-tsa».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.qual-e-il-prossimo-treno", "text": "Qual è il prossimo treno per Palermo?", "es": "¿Cuál es el próximo tren para Palermo?", "explanation": "En la taquilla o en información tras perder un tren. «Qual è» se dice todo junto: kua-LÈ.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.posso-usare-lo-stesso-biglietto", "text": "Posso usare lo stesso biglietto?", "es": "¿Puedo usar el mismo billete?", "explanation": "En la taquilla tras una cancelación o un enlace perdido. «usare» lleva «s» sonora, como un zumbido: u-ZA-re.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.e-libero-questo-posto", "text": "È libero questo posto?", "es": "¿Está libre este asiento?", "explanation": "Antes de sentarte junto a alguien. Acento en la primera sílaba: LI-be-ro.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.e-occupato", "text": "È occupato.", "es": "Está ocupado.", "explanation": "Te lo dicen si el asiento está guardado, o lo dices tú. Doble «cc» larga: ok-ku-PA-to.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.posso-sedermi-qui", "text": "Posso sedermi qui?", "es": "¿Me puedo sentar aquí?", "explanation": "En un tren, un bar o un banco con gente. «qui» suena «kui», pronunciando la «u».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.questo-e-il-mio-posto", "text": "Scusi, questo è il mio posto.", "es": "Perdone, este es mi asiento.", "explanation": "Si alguien ocupa tu asiento reservado; enséñale el billete. «Scusi» suena «SKU-si».", "register": "lei", "situation": "tren" },
    { "id": "move-treno.dove-posso-mettere-la-valigia", "text": "Dove posso mettere la valigia?", "es": "¿Dónde puedo poner la maleta?", "explanation": "Al revisor o a otro pasajero al subir con equipaje. «valigia» suena «va-LI-dja».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.mi-aiuta-con-la-valigia", "text": "Mi può aiutare con la valigia?", "es": "¿Me puede ayudar con la maleta?", "explanation": "Para subir o bajar la maleta de la rejilla. «aiutare» se dice a-iu-TA-re, cada vocal clara.", "register": "lei", "situation": "tren" },
    { "id": "move-treno.qual-e-la-prossima-fermata", "text": "Qual è la prossima fermata?", "es": "¿Cuál es la próxima parada?", "explanation": "A otro pasajero si no hay pantalla ni aviso. Acento en «PROS»: PROS-si-ma.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.prossima-fermata", "text": "Prossima fermata: Cefalù.", "es": "Próxima parada: Cefalù.", "explanation": "Lo oirás por megafonía o lo verás en la pantalla antes de cada parada. «fermata» con acento en «MA»: fer-MA-ta.", "register": "neutral", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-treno.scendo-alla-prossima", "text": "Scendo alla prossima.", "es": "Me bajo en la próxima.", "explanation": "Para avisar a quien te tapa el paso hacia la puerta. «scendo» suena «SHEN-do».", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.scende-alla-prossima", "text": "Scende alla prossima?", "es": "¿Se baja en la próxima?", "notes": "Te lo preguntan para pasar hacia la puerta.", "explanation": "Contesta «sì» o apártate un poco para dejar pasar. «scende» suena «SHEN-de».", "register": "lei", "situation": "tren", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-treno.permesso", "text": "Permesso!", "es": "¡Con permiso!", "notes": "Para abrirte paso al bajar.", "explanation": "Dilo en voz alta para pasar entre la gente del pasillo. Doble «ss» larga: per-MES-so.", "register": "neutral", "situation": "tren" },
    { "id": "move-treno.c-e-un-bagno", "text": "C'è un bagno sul treno?", "es": "¿Hay baño en el tren?", "explanation": "Al revisor o a otro pasajero en un viaje largo. «bagno» con «gn» como «ñ»: BA-ño.", "register": "neutral", "situation": "tren" }
