    {
      "id": "talk-chiacchiere.qa.diamoci-del-tu",
      "question": "Ma diamoci del tu, dai!",
      "questionEs": "¡Venga, tuteémonos!",
      "accepted": [
        { "text": "Va bene! Allora, come ti chiami?", "es": "¡Vale! Entonces, ¿cómo te llamas?" },
        { "text": "Certo! E tu di dove sei?", "es": "¡Claro! ¿Y tú de dónde eres?" }
      ],
      "distractors": [
        { "text": "Va bene! Come si chiama?", "es": "¡Vale! ¿Cómo se llama usted?" },
        { "text": "Sì, Le do del tu.", "es": "Sí, le tuteo." }
      ],
      "register": "tu",
      "situation": "presentarse",
      "notes": "Si te proponen el «tu», cambia a «tu» del todo.",
      "voice": "it-IT-DiegoNeural"
    },
    {
