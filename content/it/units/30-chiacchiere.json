  "phrases": [
    { "id": "talk-chiacchiere.come-ti-chiami", "text": "Come ti chiami?", "es": "¿Cómo te llamas?", "explanation": "A alguien de tu edad en un bar o un hostal. «chiami» suena «KIA-mi»: «chi» es «ki».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.come-si-chiama", "text": "Come si chiama?", "es": "¿Cómo se llama usted?", "explanation": "Con alguien mayor o en un trato formal. «chiama» suena «KIA-ma».", "register": "lei", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.piacere", "text": "Piacere!", "es": "¡Encantado!", "notes": "Vale para hombres y mujeres; se dice al dar la mano.", "explanation": "Al presentarte a alguien. «piacere» suena «pia-CHE-re»: «ce» es «che».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.piacere-mio", "text": "Piacere mio.", "es": "El gusto es mío.", "explanation": "Respuesta cuando alguien te dice «piacere». «mio» tiene dos sílabas: MI-o.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.e-tu", "text": "E tu?", "es": "¿Y tú?", "explanation": "Para devolver la pregunta a alguien que tuteas. Sube el tono en «tu».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.e-lei", "text": "E Lei?", "es": "¿Y usted?", "explanation": "Para devolver la pregunta en trato de usted. «Lei» es una sola sílaba: LEI.", "register": "lei", "situation": "presentarse" },
    { "id": "talk-chiacchiere.possiamo-darci-del-tu", "text": "Possiamo darci del tu?", "es": "¿Nos tuteamos?", "notes": "Entre gente joven se tutea casi siempre desde el principio.", "explanation": "Con alguien que te trata de usted y quieres más cercanía. «darci» suena «DAR-chi».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.dammi-pure-del-tu", "text": "Dammi pure del tu!", "es": "¡Tutéame, hombre!", "explanation": "Te lo dicen si hablas de usted a alguien: pasa al «tu». «dammi» con «mm» larga: DAM-mi.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.sei-qui-in-vacanza", "text": "Sei qui in vacanza?", "es": "¿Estás aquí de vacaciones?", "explanation": "Te lo preguntan en bares o playas; contesta «sì». «vacanza» suena «va-KAN-tsa».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.di-dove-sei", "text": "Di dove sei?", "es": "¿De dónde eres?", "explanation": "Para empezar a charlar con alguien de tu edad. Dilo de corrido: di-DO-ve-SEI.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.di-dov-e", "text": "Di dov'è?", "es": "¿De dónde es usted?", "explanation": "Con alguien mayor, en trato de usted. «dov'è» se une: di-do-VÈ.", "register": "lei", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.sei-spagnolo", "text": "Sei spagnolo?", "es": "¿Eres español?", "explanation": "Te lo preguntan al oír tu acento. «spagnolo» suena «spa-ÑO-lo».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.e-la-prima-volta-in-sicilia", "text": "È la prima volta in Sicilia?", "es": "¿Es la primera vez que vienes a Sicilia?", "explanation": "Te lo preguntan mucho en Sicilia. «Sicilia» suena «si-CHI-lia».", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.da-quanto-tempo-sei-qui", "text": "Da quanto tempo sei in Sicilia?", "es": "¿Cuánto tiempo llevas en Sicilia?", "explanation": "Te lo preguntan en una charla, o lo preguntas tú a otro viajero. «Sicilia» suena «si-CHI-lia».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.quanto-ti-fermi", "text": "Quanto ti fermi?", "es": "¿Cuánto tiempo te quedas?", "explanation": "A otro viajero, o te lo preguntan a ti. Acento en «fer»: FER-mi.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.che-lavoro-fai", "text": "Che lavoro fai?", "es": "¿A qué te dedicas?", "literal": "¿Qué trabajo haces?", "explanation": "En una charla informal, tras presentaros. «che» se dice «ke».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.che-lavoro-fa", "text": "Che lavoro fa?", "es": "¿A qué se dedica usted?", "explanation": "La misma pregunta de usted, a alguien mayor. «che» se dice «ke».", "register": "lei", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.dove-sei-stato-finora", "text": "Dove sei stato finora?", "es": "¿Dónde has estado hasta ahora?", "explanation": "Te lo preguntan a mitad de viaje, o tú a otro viajero. «finora» lleva el acento en «NO»: fi-NO-ra.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.dove-alloggi", "text": "Dove alloggi?", "es": "¿Dónde te alojas?", "explanation": "A otro viajero, o te lo pregunta alguien a ti. «alloggi» suena «al-LOD-dyi».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.sei-da-solo", "text": "Sei da solo?", "es": "¿Viajas solo?", "explanation": "Te lo preguntan en una charla; contesta «sì, viaggio da solo». Acento en «so»: SO-lo.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.parli-bene-l-italiano", "text": "Parli bene l'italiano!", "es": "¡Hablas bien italiano!", "explanation": "Cumplido típico: contesta «Grazie, sto imparando!». «italiano» se dice i-ta-LIA-no.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.ti-piace-la-sicilia", "text": "Ti piace la Sicilia?", "es": "¿Te gusta Sicilia?", "explanation": "Te lo preguntan en cuanto saben que eres turista. «piace» suena «PIA-che».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.che-caldo-oggi", "text": "Che caldo oggi!", "es": "¡Qué calor hace hoy!", "explanation": "Para romper el hielo en una cola o en un bar. «oggi» suena «OD-dyi».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.fa-caldo-eh", "text": "Fa caldo, eh?", "es": "Hace calor, ¿eh?", "explanation": "Para charlar con el camarero o alguien en la parada. Alarga la «eh» final, como buscando que te den la razón.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.a-ottobre-fa-ancora-caldo", "text": "Qui a ottobre fa ancora caldo.", "es": "Aquí en octubre todavía hace calor.", "explanation": "Te lo dicen los sicilianos, orgullosos de su clima. «ottobre» con «tt» larga: ot-TO-bre.", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.domani-dicono-che-piove", "text": "Domani dicono che piove.", "es": "Dicen que mañana llueve.", "explanation": "Charla sobre el tiempo, útil para planear excursiones. «dicono» lleva el acento en «DI»: DI-co-no.", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.e-bellissimo-qui", "text": "È bellissimo qui!", "es": "¡Esto es precioso!", "explanation": "Para elogiar un sitio ante alguien de allí. «bellissimo» con «ll» y «ss» largas: bel-LIS-si-mo.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.sei-di-qui", "text": "Sei di qui?", "es": "¿Eres de aquí?", "explanation": "Para charlar con alguien joven en un bar o en la playa. «qui» suena «kui».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.lei-e-di-qui", "text": "Lei è di qui?", "es": "¿Usted es de aquí?", "explanation": "Con alguien mayor, en trato de usted. «Lei è» se dice de un tirón: lei-È.", "register": "lei", "situation": "presentarse" },
    { "id": "talk-chiacchiere.cosa-mi-consigli", "text": "Cosa mi consigli di vedere?", "es": "¿Qué me recomiendas ver?", "explanation": "A alguien joven de la zona. «consigli» suena «con-SI-lli», con «gli» como una «ll» suave.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.cosa-mi-consiglia", "text": "Cosa mi consiglia di mangiare?", "es": "¿Qué me recomienda comer?", "explanation": "Al camarero, al dueño del B&B o a alguien mayor. «consiglia» suena «con-SI-lla».", "register": "lei", "situation": "presentarse" },
    { "id": "talk-chiacchiere.dove-si-mangia-bene", "text": "Dove si mangia bene qui?", "es": "¿Dónde se come bien por aquí?", "explanation": "Al dueño del alojamiento o a alguien de allí. «mangia» suena «MAN-dya».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.devi-provare-la-granita", "text": "Devi assolutamente provare la granita!", "es": "¡Tienes que probar la granita sí o sí!", "explanation": "Te lo dirán en cuanto hables de comida. «granita» lleva el acento en «NI»: gra-NI-ta.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.sei-stato-a-ortigia", "text": "Sei stato a Ortigia? È bellissima.", "es": "¿Has estado en Ortigia? Es preciosa.", "explanation": "Te lo preguntan en Siracusa y alrededores. «Ortigia» suena «or-TI-dya».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.arancina-o-arancino", "text": "Si dice arancina o arancino?", "es": "¿Se dice arancina o arancino?", "notes": "Pregunta trampa: en Palermo «arancina», en Catania «arancino». Da charla para rato.", "explanation": "Para bromear sobre la rivalidad entre Palermo y Catania. «arancina» suena «a-ran-CHI-na».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.in-spagna-si-mangia-bene-pure", "text": "In Spagna si mangia bene pure, eh!", "es": "En España también se come bien, ¿eh?", "notes": "«Pure» = también; muy usado en el sur.", "explanation": "Para defender la comida española con humor. «Spagna» suena «SPA-ña».", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.scusa-non-ho-capito", "text": "Scusa, non ho capito.", "es": "Perdona, no te he entendido.", "explanation": "Con alguien que tuteas y habla muy rápido. «ho» suena «o»: la «h» es muda.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.puoi-ripetere-piu-piano", "text": "Puoi ripetere più piano?", "es": "¿Puedes repetirlo más despacio?", "explanation": "Cuando alguien que tuteas habla rápido. «più» suena «PIU», con acento en la «u».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.puo-ripetere", "text": "Può ripetere, per favore?", "es": "¿Puede repetir, por favor?", "explanation": "Con un camarero, un revisor o alguien a quien tratas de usted. «può» acentúa la «o»: PUÒ.", "register": "lei", "situation": "presentarse" },
    { "id": "talk-chiacchiere.parlo-troppo-veloce", "text": "Parlo troppo veloce?", "es": "¿Hablo demasiado rápido?", "explanation": "Te lo preguntan al ver tu cara de duda: contesta «un po'». «troppo» con «pp» larga: TROP-po.", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.come-si-dice", "text": "Come si dice «maleta» in italiano?", "es": "¿Cómo se dice «maleta» en italiano?", "explanation": "Cuando te falta una palabra. «dice» suena «DI-che».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.cosa-vuol-dire", "text": "Cosa vuol dire «amunì»?", "es": "¿Qué significa «amunì»?", "notes": "«Amunì» es siciliano: «¡vamos!».", "explanation": "Cuando oyes una palabra que no entiendes. «vuol» es una sola sílaba: VUOL.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.me-lo-scrivi", "text": "Me lo scrivi?", "es": "¿Me lo escribes?", "explanation": "Para apuntar un nombre, una dirección o un plato. «scrivi» suena «SKRI-vi».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.parli-inglese", "text": "Parli inglese?", "es": "¿Hablas inglés?", "explanation": "Como salvavidas si te atascas. Acento en «gle», y la «s» como la nuestra: in-GLE-se.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.te-lo-dico-in-inglese", "text": "Te lo dico in inglese?", "es": "¿Te lo digo en inglés?", "explanation": "Cuando no te sale en italiano y quieres cambiar de idioma. «dico» suena «DI-ko».", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.mi-capisci-se-parlo-spagnolo", "text": "Mi capisci se parlo spagnolo?", "es": "¿Me entiendes si hablo en español?", "explanation": "Para probar a mezclar idiomas; muchas veces funciona. «capisci» suena «ka-PI-shi».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.si-somigliano", "text": "Lo spagnolo e l'italiano si somigliano molto.", "es": "El español y el italiano se parecen mucho.", "explanation": "Buena frase para charlar sobre idiomas. «somigliano» suena «so-MI-lla-no».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.non-ti-preoccupare", "text": "Non ti preoccupare, ti capisco.", "es": "No te preocupes, te entiendo.", "explanation": "Te lo dicen para tranquilizarte si te equivocas. «preoccupare» con «cc» larga: pre-ok-ku-PA-re.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.ah-ho-capito", "text": "Ah, ho capito!", "es": "¡Ah, vale, ya lo pillo!", "explanation": "Cuando por fin entiendes algo. «ho» suena «o»: a-o-ka-PI-to.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.ma-dai", "text": "Ma dai!", "es": "¡No me digas!", "notes": "Sorpresa. «Dai!» solo = ¡venga!", "explanation": "Para reaccionar a algo sorprendente en una charla. «dai» es una sola sílaba: DAI.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.davvero", "text": "Davvero?", "es": "¿De verdad?", "explanation": "Para mostrar interés o sorpresa. Doble «vv» larga: dav-VE-ro.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.che-bello", "text": "Che bello!", "es": "¡Qué bien! / ¡Qué bonito!", "explanation": "Al ver un paisaje o al oír una buena noticia. «bello» con «ll» larga, no como nuestra «ll»: BEL-lo.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.magari", "text": "Magari!", "es": "¡Ojalá!", "explanation": "Cuando te proponen algo que te encantaría. Acento en «GA»: ma-GA-ri.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.boh-non-lo-so", "text": "Boh, non lo so.", "es": "Ni idea.", "notes": "Muy coloquial, con amigos.", "explanation": "Con amigos, si no tienes ni idea. «Boh» es corto, casi con la boca cerrada.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.meno-male", "text": "Meno male!", "es": "¡Menos mal!", "explanation": "Cuando se arregla un problema, como llegar justo al tren. «meno» con «e» cerrada: ME-no.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.figurati", "text": "Figurati!", "es": "¡No hay de qué!", "notes": "Con usted: «Si figuri!».", "explanation": "Cuando alguien que tuteas te da las gracias. Acento en «FI»: FI-gu-ra-ti.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.si-figuri", "text": "Si figuri!", "es": "¡Faltaría más!", "explanation": "Para contestar a un «grazie» en trato de usted. Acento en «FI»: si FI-gu-ri.", "register": "lei", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "talk-chiacchiere.mi-dai-il-tuo-numero", "text": "Mi dai il tuo numero?", "es": "¿Me das tu número?", "explanation": "Para seguir en contacto con alguien que acabas de conocer. «numero» lleva el acento en «NU»: NU-me-ro.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.hai-instagram", "text": "Hai Instagram?", "es": "¿Tienes Instagram?", "explanation": "Para seguir en contacto con alguien joven. «hai» suena «ai»: la «h» es muda.", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.ti-scrivo-su-whatsapp", "text": "Ti scrivo su WhatsApp.", "es": "Te escribo por WhatsApp.", "explanation": "Al despedirte de alguien con quien has quedado. «scrivo» suena «SKRI-vo».", "register": "tu", "situation": "presentarse" },
    { "id": "talk-chiacchiere.e-stato-un-piacere", "text": "È stato un piacere!", "es": "¡Ha sido un placer!", "explanation": "Al despedirte tras una buena charla. «piacere» suena «pia-CHE-re».", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.ci-vediamo", "text": "Ci vediamo!", "es": "¡Nos vemos!", "explanation": "Despedida informal con alguien que volverás a ver. «ci» suena «chi»: chi-ve-DIA-mo.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.a-presto", "text": "A presto!", "es": "¡Hasta pronto!", "explanation": "Despedida amable al irte. «presto» con «e» abierta: PRES-to.", "register": "neutral", "situation": "presentarse" },
    { "id": "talk-chiacchiere.buon-viaggio", "text": "Buon viaggio!", "es": "¡Buen viaje!", "explanation": "Te lo dicen al despedirse si saben que viajas; contesta «grazie». «viaggio» suena «VIAD-dyo».", "register": "neutral", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "talk-chiacchiere.divertiti", "text": "Divertiti!", "es": "¡Pásalo bien!", "explanation": "Para desearle a alguien que lo pase bien. Acento en «VER»: di-VER-ti-ti.", "register": "tu", "situation": "presentarse", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" }
  ],
