      "question": "Quanto ti fermi?",
      "questionEs": "¿Cuánto tiempo te quedas?",
      "accepted": [
        { "text": "Ancora una settimana.", "es": "Una semana más." },
        { "text": "Fino a domenica.", "es": "Hasta el domingo." }
      ],
      "distractors": [
        { "text": "Mi fermo alla prossima.", "es": "Me bajo en la próxima." },
        { "text": "Da una settimana.", "es": "Desde hace una semana." }
