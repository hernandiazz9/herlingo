      "register": "tu",
      "situation": "presentarse",
      "voice": "it-IT-IsabellaNeural"
    },
    {
      "id": "talk-chiacchiere.qa.da-quanto-tempo",
      "question": "Da quanto tempo sei in Sicilia?",
      "questionEs": "¿Cuánto tiempo llevas en Sicilia?",
      "accepted": [
        { "text": "Da tre giorni.", "es": "Desde hace tres días." },
        { "text": "Sono arrivato ieri.", "es": "Llegué ayer." }
      ],
      "distractors": [
        { "text": "Per tre giorni.", "es": "Durante tres días." },
        { "text": "Tre giorni fa.", "es": "Hace tres días." }
      ],
      "register": "tu",
      "situation": "presentarse",
      "notes": "«Da» + tiempo = desde hace; es lo que se responde a «Da quanto tempo…?».",
      "voice": "it-IT-IsabellaNeural"
    },
