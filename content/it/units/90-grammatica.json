  "qa": [
    {
      "id": "gram.qa.in-vacanza",
      "question": "Ciao! Sei qui in vacanza?",
      "questionEs": "¡Hola! ¿Estás aquí de vacaciones?",
      "accepted": [
        { "text": "Sì, sono in vacanza. E tu?", "es": "Sí, estoy de vacaciones. ¿Y tú?" },
        { "text": "Sì, per una settimana.", "es": "Sí, una semana." }
      ],
      "distractors": [
        { "text": "Sì, sei in vacanza.", "es": "Sí, estás de vacaciones." },
        { "text": "Sì, è in vacanza.", "es": "Sí, está de vacaciones." }
      ],
      "register": "tu",
      "situation": "presentarse",
      "notes": "Te pregunta con «sei» (tú); tú respondes con «sono» (yo).",
      "voice": "it-IT-IsabellaNeural"
    },
    {
      "id": "gram.qa.vuole-acqua",
      "question": "Vuole anche dell'acqua?",
      "questionEs": "¿Quiere también agua?",
      "accepted": [
        { "text": "Sì, grazie, vorrei un'acqua naturale.", "es": "Sí, gracias, quería un agua sin gas." },
        { "text": "No, grazie.", "es": "No, gracias." }
      ],
      "distractors": [
        { "text": "Sì, vuole.", "es": "Sí, quiere." },
        { "text": "No, non vuole.", "es": "No, no quiere." }
      ],
      "register": "lei",
      "situation": "restaurante",
      "notes": "Te pregunta «vuole» (usted quiere); respondes en primera persona: «vorrei».",
      "voice": "it-IT-DiegoNeural"
    },
    {
