  "phrases": [
    { "id": "gram.lei-e-di-qui", "text": "Lei è di qui?", "es": "¿Usted es de aquí?", "explanation": "Para preguntar a un desconocido o a alguien mayor. «qui» suena «kui»: LEI e di KUI.", "register": "lei", "situation": "presentarse", "tags": ["registro"] },
    { "id": "gram.sei-di-qui", "text": "Sei di qui?", "es": "¿Eres de aquí?", "explanation": "Para preguntar a alguien joven o que ya te tutea. «sei» es una sola sílaba: SEI di KUI.", "register": "tu", "situation": "presentarse", "tags": ["registro"] },
    { "id": "gram.senta-scusi", "text": "Senta, scusi…", "es": "Oiga, perdone…", "notes": "Para llamar a un camarero o preguntar algo a un desconocido.", "explanation": "Para llamar al camarero o parar a alguien por la calle. «scu» suena «sku»: SEN-ta, SKU-si.", "register": "lei", "situation": "saludos", "tags": ["registro"] },
    { "id": "gram.senti", "text": "Senti, una domanda.", "es": "Oye, una pregunta.", "explanation": "Para llamar la atención de un amigo antes de preguntarle algo. Acento en «sen»: SEN-ti.", "register": "tu", "situation": "presentarse", "tags": ["registro"] },
    { "id": "gram.grazie-a-lei", "text": "Grazie a Lei!", "es": "¡Gracias a usted!", "explanation": "Para devolver el agradecimiento a un camarero o un recepcionista. La «z» suena «ts»: GRA-tsie a LEI.", "register": "lei", "situation": "saludos", "tags": ["registro"] },
    { "id": "gram.grazie-a-te", "text": "Grazie a te!", "es": "¡Gracias a ti!", "explanation": "Para devolver las gracias a un amigo o a alguien que te tutea. La «z» suena «ts»: GRA-tsie a TE.", "register": "tu", "situation": "saludos", "tags": ["registro"] },
    { "id": "gram.darci-del-tu", "text": "Possiamo darci del tu?", "es": "¿Nos tuteamos?", "literal": "¿Podemos darnos el tú?", "explanation": "Para proponer tutearos a alguien con quien ya hay confianza. «ci» suena «chi»: DAR-chi del TU.", "register": "neutral", "situation": "presentarse", "tags": ["registro"] },

    { "id": "gram.vorrei-prenotare", "text": "Vorrei prenotare un tavolo per stasera.", "es": "Quería reservar una mesa para esta noche.", "explanation": "Por teléfono o en la puerta del restaurante. Marca la doble «r»: vor-REI pre-no-TA-re.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "gram.vorremmo-due-caffe", "text": "Vorremmo due caffè, per favore.", "es": "Queríamos dos cafés, por favor.", "notes": "«Caffè» no cambia en plural.", "explanation": "Al pedir en la barra para ti y quien te acompaña. Marca las dobles «rr» y «mm»: vor-REM-mo.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "gram.voglio-andare-al-mare", "text": "Domani voglio andare al mare.", "es": "Mañana quiero ir a la playa.", "literal": "Mañana quiero ir al mar.", "explanation": "Para contar tus planes a un amigo; al pedir algo, mejor «vorrei». «glio» suena como «llo» suave: VO-llo.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.vuole-lo-scontrino", "text": "Vuole lo scontrino?", "es": "¿Quiere el tique?", "explanation": "Te lo preguntarán al pagar en una tienda o un bar. «vuo» es una sola sílaba: VUO-le lo skon-TRI-no.", "register": "lei", "situation": "compras", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "gram.vuoi-venire", "text": "Vuoi venire con noi?", "es": "¿Quieres venir con nosotros?", "explanation": "Para invitar a alguien que has conocido en el viaje. «vuoi» es una sola sílaba: VUOI ve-NI-re.", "register": "tu", "situation": "presentarse", "voice": "it-IT-IsabellaNeural" },

    { "id": "gram.sono-in-vacanza", "text": "Sono in vacanza.", "es": "Estoy de vacaciones.", "explanation": "Para explicar que eres turista cuando alguien te da conversación. La «z» suena «ts»: va-KAN-tsa.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.e-lontano", "text": "È lontano?", "es": "¿Está lejos?", "explanation": "Pregúntalo al pedir indicaciones, antes de decidir si vas andando. Acento en «ta»: lon-TA-no.", "register": "neutral", "situation": "calle" },
    { "id": "gram.sono-stanco", "text": "Sono stanco.", "es": "Estoy cansado.", "explanation": "Tras un día de visitas, para decir que quieres descansar. Acento en «stan»: SO-no STAN-ko.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.ho-fame", "text": "Ho fame.", "es": "Tengo hambre.", "explanation": "Para proponer ir a comer. La «h» es muda: o FA-me.", "register": "neutral", "situation": "restaurante" },
    { "id": "gram.ho-sete", "text": "Ho sete.", "es": "Tengo sed.", "explanation": "Cuando necesitas agua bajo el sol siciliano. La «h» es muda: o SE-te.", "register": "neutral", "situation": "bar" },
    { "id": "gram.ho-caldo", "text": "Ho caldo.", "es": "Tengo calor.", "explanation": "En pleno verano siciliano, para pedir sombra o aire acondicionado. La «h» es muda: o KAL-do.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.ce-l-ha-piu-piccolo", "text": "Ce l'ha più piccolo?", "es": "¿Lo tiene más pequeño?", "explanation": "En una tienda, para pedir otra talla o tamaño. «ce» suena «che» y se une todo: che-LA piu PIK-ko-lo.", "register": "lei", "situation": "compras" },
    { "id": "gram.non-ce-l-ho", "text": "Non ce l'ho.", "es": "No lo tengo.", "explanation": "Para decir que no tienes algo que te piden, como suelto o el tique. Se une todo: non che-LO.", "register": "neutral", "situation": "compras" },

    { "id": "gram.posso-entrare", "text": "Posso entrare?", "es": "¿Puedo entrar?", "explanation": "En una tienda, una iglesia o un despacho, antes de pasar. Marca la doble «s»: POS-so en-TRA-re.", "register": "neutral", "situation": "calle" },
    { "id": "gram.mi-puo-fare-una-foto", "text": "Mi può fare una foto, per favore?", "es": "¿Me puede hacer una foto, por favor?", "explanation": "A un desconocido, en un mirador o delante de un monumento. «può» es una sola sílaba: mi PUO FA-re.", "register": "lei", "situation": "calle" },
    { "id": "gram.mi-fai-una-foto", "text": "Mi fai una foto?", "es": "¿Me haces una foto?", "explanation": "A alguien de tu edad o de tu grupo. «fai» es una sola sílaba: mi FAI U-na FO-to.", "register": "tu", "situation": "calle" },
    { "id": "gram.non-posso", "text": "Non posso, mi dispiace.", "es": "No puedo, lo siento.", "explanation": "Para rechazar una invitación o una propuesta con educación. Marca la doble «s»: non POS-so.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.vado-a-palermo", "text": "Domani vado a Palermo.", "es": "Mañana voy a Palermo.", "explanation": "Para contarle a alguien tus planes de viaje. Acento en «ler»: pa-LER-mo.", "register": "neutral", "situation": "presentarse" },
    { "id": "gram.vado-in-treno", "text": "Vado in treno.", "es": "Voy en tren.", "explanation": "Para decir cómo vas a moverte. Acento en «tre»: in TRE-no.", "register": "neutral", "situation": "tren" },
    { "id": "gram.dove-vai-stasera", "text": "Dove vai stasera?", "es": "¿Adónde vas esta noche?", "explanation": "Para preguntar a un amigo sus planes. «vai» es una sola sílaba: DO-ve VAI sta-SE-ra.", "register": "tu", "situation": "presentarse", "voice": "it-IT-IsabellaNeural" },
    { "id": "gram.andiamo-al-mare", "text": "Andiamo al mare?", "es": "¿Vamos a la playa?", "explanation": "Para proponer un plan a alguien con quien tienes confianza. Acento en «dia»: an-DIA-mo al MA-re.", "register": "neutral", "situation": "presentarse" }
  ],
