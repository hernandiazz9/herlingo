  "phrases": [
    { "id": "move-strada.dove-posso-prendere-un-taxi", "text": "Dove posso prendere un taxi?", "es": "¿Dónde puedo coger un taxi?", "explanation": "En el hotel, un bar o la estación. «taxi» se dice «TAK-si», como en español.", "register": "neutral", "situation": "taxi" },
    { "id": "move-strada.mi-chiama-un-taxi", "text": "Mi può chiamare un taxi?", "es": "¿Me puede pedir un taxi?", "notes": "Útil en el hotel o en el bar: en Sicilia no suelen parar a mano alzada.", "explanation": "Al recepcionista o al camarero. «chiamare» suena «kia-MA-re»: «chi» es «ki».", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.e-libero", "text": "È libero?", "es": "¿Está libre?", "explanation": "Al taxista, asomándote a la ventanilla. Acento en la primera sílaba: LI-be-ro.", "register": "neutral", "situation": "taxi" },
    { "id": "move-strada.dove-la-porto", "text": "Dove La porto?", "es": "¿Adónde le llevo?", "explanation": "Te lo pregunta el taxista al subir: di tu destino. «porto» con «o» abierta: POR-to.", "register": "lei", "situation": "taxi", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.alla-stazione-centrale", "text": "Alla stazione centrale, per favore.", "es": "A la estación central, por favor.", "explanation": "Al taxista, para darle el destino. «stazione» suena «sta-TSIO-ne» y «centrale» «chen-TRA-le».", "register": "neutral", "situation": "taxi" },
    { "id": "move-strada.mi-porta-a-questo-indirizzo", "text": "Mi porta a questo indirizzo, per favore?", "es": "¿Me lleva a esta dirección, por favor?", "explanation": "Al taxista, mientras le enseñas la dirección en el móvil. «indirizzo» suena «in-di-RIT-tso».", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.ha-l-indirizzo", "text": "Ha l'indirizzo?", "es": "¿Tiene la dirección?", "explanation": "Te lo pregunta el taxista: enséñale el móvil o la reserva. La «h» de «ha» es muda.", "register": "lei", "situation": "taxi", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.quanto-costa-fino-a", "text": "Quanto costa più o meno fino a Ortigia?", "es": "¿Cuánto cuesta más o menos hasta Ortigia?", "explanation": "Al taxista antes de subir, para evitar sorpresas. «Ortigia» suena «or-TI-dya».", "register": "neutral", "situation": "taxi" },
    { "id": "move-strada.tariffa-fissa", "text": "C'è una tariffa fissa per l'aeroporto?", "es": "¿Hay tarifa fija al aeropuerto?", "notes": "Pregunta el precio antes de subir.", "explanation": "Al taxista en la parada del aeropuerto, antes de subir. Doble «ff» y doble «ss»: ta-RIF-fa FIS-sa.", "register": "neutral", "situation": "taxi" },
    { "id": "move-strada.puo-accendere-il-tassametro", "text": "Può accendere il tassametro?", "es": "¿Puede poner el taxímetro?", "explanation": "Si el taxista arranca sin taxímetro ni precio pactado. «accendere» suena «at-CHEN-de-re».", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.si-fermi-qui", "text": "Si fermi qui, per favore.", "es": "Pare aquí, por favor.", "explanation": "Al taxista cuando ves tu destino. Acento en «fer»: FER-mi.", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.non-posso-entrare", "text": "In centro storico non posso entrare, La lascio qui.", "es": "En el casco antiguo no puedo entrar, le dejo aquí.", "notes": "Muchos cascos antiguos son ZTL: zona de tráfico limitado.", "explanation": "Te lo dice el taxista a la entrada de una ZTL: sigue andando. «storico» lleva el acento en «STO».", "register": "lei", "situation": "taxi", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.sono-venticinque-euro", "text": "Sono venticinque euro.", "es": "Son veinticinco euros.", "explanation": "Te lo dice el taxista al llegar. «venticinque» suena «ven-ti-CHIN-kue».", "register": "neutral", "situation": "taxi", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.quanto-le-devo", "text": "Quanto Le devo?", "es": "¿Cuánto le debo?", "explanation": "Al taxista o en la caja, al pagar. Dilo de corrido: kuan-to-le-DE-vo.", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.tenga-il-resto", "text": "Tenga il resto.", "es": "Quédese con el cambio.", "explanation": "Al pagar al taxista o al camarero si quieres dejar propina. «resto» con «e» abierta: RES-to.", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.mi-fa-la-ricevuta", "text": "Mi fa la ricevuta?", "es": "¿Me hace un recibo?", "explanation": "Al taxista o en una tienda si necesitas justificante. «ricevuta» suena «ri-che-VU-ta».", "register": "lei", "situation": "taxi" },
    { "id": "move-strada.scusi-per-andare-a", "text": "Scusi, per andare alla Cattedrale?", "es": "Perdone, ¿para ir a la Catedral?", "notes": "La forma más rápida y natural de preguntar un camino.", "explanation": "Para parar a alguien por la calle. «Scusi» suena «SKU-si»; «Cattedrale» con «tt» larga.", "register": "lei", "situation": "calle" },
    { "id": "move-strada.dov-e-la-stazione", "text": "Dov'è la stazione?", "es": "¿Dónde está la estación?", "explanation": "A cualquiera en la calle o en un bar. «Dov'è» se dice de un tirón: do-VÈ.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.sto-cercando", "text": "Sto cercando il Teatro Massimo.", "es": "Estoy buscando el Teatro Massimo.", "explanation": "Al preguntar por un sitio concreto. «cercando» suena «cher-KAN-do».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.e-lontano", "text": "È lontano?", "es": "¿Está lejos?", "explanation": "Tras preguntar un camino, para decidir si vas andando. Acento en «TA»: lon-TA-no.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.ci-si-puo-andare-a-piedi", "text": "Ci si può andare a piedi?", "es": "¿Se puede ir andando?", "explanation": "A alguien de la zona antes de coger un taxi. «ci» suena «chi»; «piedi» es «PIE-di».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.quanto-ci-vuole-a-piedi", "text": "Quanto ci vuole a piedi?", "es": "¿Cuánto se tarda andando?", "explanation": "Para calcular si llegas andando. «vuole» suena «VUO-le».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.c-e-un-bancomat-qui-vicino", "text": "C'è un bancomat qui vicino?", "es": "¿Hay un cajero por aquí cerca?", "explanation": "A un transeúnte o en un bar. «vicino» suena «vi-CHI-no».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.me-lo-indica-sulla-mappa", "text": "Me lo può indicare sulla mappa?", "es": "¿Me lo puede señalar en el mapa?", "explanation": "Mientras enseñas el mapa del móvil. «mappa» con «pp» larga: MAP-pa.", "register": "lei", "situation": "calle" },
    { "id": "move-strada.mi-sono-perso", "text": "Mi sono perso.", "es": "Me he perdido.", "notes": "Si eres mujer: «Mi sono persa».", "explanation": "Para pedir ayuda por la calle. «perso» con «e» abierta y «s» sorda: PER-so.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.e-questa-la-strada-per", "text": "È questa la strada per Ortigia?", "es": "¿Es este el camino a Ortigia?", "explanation": "A alguien en la calle cuando dudas del camino. «questa» suena «KUES-ta».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.da-che-parte-e", "text": "Da che parte è il Duomo?", "es": "¿Hacia dónde queda el Duomo?", "explanation": "Para que te indiquen hacia dónde queda algo. «che» se dice «ke» y «Duomo» «DUO-mo».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.grazie-gentilissimo", "text": "Grazie, gentilissimo!", "es": "¡Gracias, muy amable!", "notes": "A una mujer: «gentilissima».", "explanation": "Para dar las gracias a quien te ha ayudado mucho. «grazie» suena «GRA-tsie» y «gentilissimo» «dyen-ti-LIS-si-mo».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.vada-sempre-dritto", "text": "Vada sempre dritto.", "es": "Siga todo recto.", "explanation": "Te lo dicen al indicarte el camino: sigue recto. «dritto» con «tt» larga: DRIT-to.", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.giri-a-destra", "text": "Giri a destra.", "es": "Gire a la derecha.", "explanation": "Te lo dicen al darte indicaciones. «giri» suena «DYI-ri».", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.al-semaforo-giri-a-sinistra", "text": "Al semaforo giri a sinistra.", "es": "En el semáforo gire a la izquierda.", "explanation": "Te lo dicen al indicarte el camino. Acento en «MA»: se-MA-fo-ro.", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.prenda-la-prima-a-destra", "text": "Prenda la prima a destra.", "es": "Coja la primera a la derecha.", "explanation": "Te lo dicen al indicarte calles. «prenda» con «e» abierta: PREN-da.", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.la-seconda-a-sinistra", "text": "La seconda strada a sinistra.", "es": "La segunda calle a la izquierda.", "explanation": "Te lo dicen al darte indicaciones. «seconda» suena «se-KON-da».", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.attraversi-la-piazza", "text": "Attraversi la piazza.", "es": "Cruce la plaza.", "explanation": "Te lo dicen al indicarte el camino. «piazza» suena «PIAT-tsa».", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.in-fondo-alla-strada", "text": "È in fondo alla strada.", "es": "Está al final de la calle.", "explanation": "Te lo dicen: sigue hasta el final de la calle. «alla» con «ll» larga: AL-la.", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.di-fronte-alla-chiesa", "text": "È di fronte alla chiesa.", "es": "Está enfrente de la iglesia.", "explanation": "Te lo dicen para situarte un sitio. «chiesa» suena «KIE-sa»: «chi» es «ki».", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.accanto-al-bar", "text": "È accanto al bar.", "es": "Está al lado del bar.", "explanation": "Te lo dicen para situarte un sitio. «accanto» con «cc» larga: ak-KAN-to.", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.dietro-l-angolo", "text": "È proprio dietro l'angolo.", "es": "Está justo a la vuelta de la esquina.", "explanation": "Te lo dicen cuando ya casi has llegado. «angolo» lleva el acento en «AN»: AN-go-lo.", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.a-cinque-minuti-da-qui", "text": "È a cinque minuti da qui.", "es": "Está a cinco minutos de aquí.", "explanation": "Te lo dicen al preguntar si está lejos. «cinque» suena «CHIN-kue».", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.deve-tornare-indietro", "text": "Deve tornare indietro.", "es": "Tiene que volver atrás.", "explanation": "Te lo dicen si te has pasado. «indietro» suena «in-DIE-tro».", "register": "lei", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.vai-sempre-dritto", "text": "Vai sempre dritto e poi gira a destra.", "es": "Sigue recto y luego gira a la derecha.", "notes": "Así te lo dirá alguien joven, tuteándote.", "explanation": "Así te lo dice alguien que te tutea. «gira» suena «DYI-ra» y «dritto» lleva «tt» larga.", "register": "tu", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.a-che-ora-apre", "text": "A che ora apre?", "es": "¿A qué hora abre?", "explanation": "En museos, iglesias o tiendas. «che» se dice «ke» y «apre» es «A-pre».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.a-che-ora-chiude", "text": "A che ora chiude?", "es": "¿A qué hora cierra?", "explanation": "Antes de entrar en una visita o tienda. «chiude» suena «KIU-de».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.e-aperto-oggi", "text": "È aperto oggi?", "es": "¿Está abierto hoy?", "explanation": "En la puerta o por teléfono, sobre todo los lunes y festivos. «oggi» con «gg» larga: OD-dyi.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.oggi-e-chiuso", "text": "Oggi è chiuso, è lunedì.", "es": "Hoy está cerrado, es lunes.", "explanation": "Te lo dicen en museos: muchos cierran el lunes. «chiuso» suena «KIU-so» y «lunedì» acentúa la «ì» final.", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.riapre-alle-quattro", "text": "Riapre alle quattro.", "es": "Vuelve a abrir a las cuatro.", "notes": "Muchas iglesias y tiendas cierran a mediodía.", "explanation": "Te lo dicen en tiendas e iglesias que cierran a mediodía. «riapre» es «ri-A-pre».", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-strada.dove-si-fa-il-biglietto", "text": "Dove si fa il biglietto per entrare?", "es": "¿Dónde se saca la entrada?", "explanation": "En la entrada de un museo o de un yacimiento. «biglietto» con «gli» como una «ll» suave.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.un-intero", "text": "Un intero, per favore.", "es": "Una entrada normal, por favor.", "notes": "«Intero» = entrada completa; «ridotto» = reducida.", "explanation": "En la taquilla del museo, si no tienes descuento. Acento en «TE»: in-TE-ro.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.come-si-chiama-questa-piazza", "text": "Come si chiama questa piazza?", "es": "¿Cómo se llama esta plaza?", "explanation": "A un transeúnte, para orientarte en el mapa. «chiama» suena «KIA-ma» y «piazza» «PIAT-tsa».", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.c-e-un-bagno-pubblico", "text": "C'è un bagno pubblico qui vicino?", "es": "¿Hay un baño público por aquí cerca?", "explanation": "A alguien por la calle o en un bar. «bagno» es «BA-ño» y «pubblico» lleva «bb» larga.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.mi-fa-una-foto", "text": "Mi può fare una foto?", "es": "¿Me puede hacer una foto?", "explanation": "A un turista o paseante, dándole tu móvil. «foto» con «o» abierta: FO-to.", "register": "lei", "situation": "calle" },
    { "id": "move-strada.vorrei-andare-a-piedi", "text": "Vorrei andare a Ortigia a piedi.", "es": "Quiero ir a Ortigia andando.", "explanation": "En el hotel, al pedir consejo sobre la ruta. «vorrei» con «rr» vibrante: vor-REI.", "register": "neutral", "situation": "calle" },
    { "id": "move-strada.attenzione-ai-motorini", "text": "Attenzione, passano i motorini!", "es": "¡Cuidado, que pasan motos!", "explanation": "Te lo gritan en callejuelas por donde pasan motos. «attenzione» suena «at-ten-TSIO-ne».", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-IsabellaNeural" },
    { "id": "move-strada.meglio-la-mattina-presto", "text": "Con questo caldo, meglio andare la mattina presto.", "es": "Con este calor, mejor ir por la mañana temprano.", "explanation": "Te lo recomiendan para visitas al aire libre en verano. «meglio» suena «ME-llo», con «gli» como «ll» suave.", "register": "neutral", "situation": "calle", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" }
  ],
