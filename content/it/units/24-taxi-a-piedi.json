  "qa": [
    {
      "id": "move-strada.qa.dove-la-porto",
      "question": "Buonasera! Dove La porto?",
      "questionEs": "¡Buenas tardes! ¿Adónde le llevo?",
      "accepted": [
        { "text": "A questo indirizzo, per favore.", "es": "A esta dirección, por favor." },
        { "text": "Alla stazione centrale, per favore.", "es": "A la estación central, por favor." }
      ],
      "distractors": [
        { "text": "Porto una valigia.", "es": "Llevo una maleta." },
        { "text": "Sì, sono libero.", "es": "Sí, estoy libre." }
      ],
      "register": "lei",
      "situation": "taxi",
      "notes": "«Dove La porto?» = ¿adónde le llevo? Responde con el destino.",
      "voice": "it-IT-DiegoNeural"
    },
    {
      "id": "move-strada.qa.diciotto-euro",
      "question": "Sono diciotto euro.",
      "questionEs": "Son dieciocho euros.",
      "accepted": [
        { "text": "Ecco a Lei. Tenga il resto.", "es": "Aquí tiene. Quédese con el cambio." },
        { "text": "Posso pagare con la carta?", "es": "¿Puedo pagar con tarjeta?" }
      ],
      "distractors": [
        { "text": "Otto euro? Ecco.", "es": "¿Ocho euros? Aquí tiene." },
        { "text": "Diciotto anni?", "es": "¿Dieciocho años?" }
      ],
      "register": "lei",
      "situation": "taxi",
      "notes": "«Diciotto» (18) y «otto» (8) se confunden al oído.",
      "voice": "it-IT-DiegoNeural"
    },
    {
      "id": "move-strada.qa.dove-deve-andare",
      "question": "Dove deve andare?",
      "questionEs": "¿Adónde tiene que ir?",
      "accepted": [
        { "text": "Alla Cattedrale.", "es": "A la Catedral." },
        { "text": "Sto cercando via Etnea.", "es": "Estoy buscando la via Etnea." }
      ],
      "distractors": [
        { "text": "A piedi.", "es": "Andando." },
        { "text": "Sì, devo andare.", "es": "Sí, tengo que ir." }
      ],
      "register": "lei",
      "situation": "calle",
      "voice": "it-IT-IsabellaNeural"
    },
    {
      "id": "move-strada.qa.venti-minuti-a-piedi",
      "question": "È un po' lontano, sono venti minuti a piedi.",
      "questionEs": "Está un poco lejos, son veinte minutos andando.",
      "accepted": [
        { "text": "Ah, allora prendo un taxi.", "es": "Ah, entonces cojo un taxi." },
        { "text": "Va bene, vado a piedi. Grazie!", "es": "Vale, voy andando. ¡Gracias!" }
      ],
      "distractors": [
        { "text": "Venti euro? Ecco.", "es": "¿Veinte euros? Aquí tiene." },
        { "text": "Sì, ho venti minuti.", "es": "Sí, tengo veinte minutos." }
      ],
      "register": "neutral",
      "situation": "calle",
      "voice": "it-IT-DiegoNeural"
    },
    {
      "id": "move-strada.qa.ha-bisogno-di-aiuto",
      "question": "Ha bisogno di aiuto?",
      "questionEs": "¿Necesita ayuda?",
      "accepted": [
        { "text": "Sì, grazie. Cerco la stazione.", "es": "Sí, gracias. Busco la estación." },
        { "text": "No, grazie, sono a posto.", "es": "No, gracias, estoy bien." }
      ],
      "distractors": [
        { "text": "Sì, aiuto!", "es": "¡Sí, socorro!" },
        { "text": "No, grazie, ho già mangiato.", "es": "No, gracias, ya he comido." }
      ],
      "register": "lei",
      "situation": "calle",
      "notes": "«Aiuto!» a secas es un grito de socorro.",
      "voice": "it-IT-IsabellaNeural"
    },
    {
      "id": "move-strada.qa.ha-capito",
      "question": "Ha capito?",
      "questionEs": "¿Lo ha entendido?",
      "accepted": [
        { "text": "Sì, sempre dritto e poi a destra. Grazie!", "es": "Sí, todo recto y luego a la derecha. ¡Gracias!" },
        { "text": "Scusi, può ripetere più piano?", "es": "Perdone, ¿puede repetirlo más despacio?" }
      ],
      "distractors": [
        { "text": "Sì, sono capito.", "es": "Sí, estoy entendido." },
        { "text": "No, grazie.", "es": "No, gracias." }
      ],
      "register": "lei",
      "situation": "calle",
      "voice": "it-IT-DiegoNeural"
    },
    {
      "id": "move-strada.qa.secondo-incrocio",
      "question": "Al secondo incrocio giri a sinistra.",
      "questionEs": "En el segundo cruce gire a la izquierda.",
      "accepted": [
        { "text": "Al secondo incrocio a sinistra. Grazie!", "es": "En el segundo cruce a la izquierda. ¡Gracias!" }
      ],
      "distractors": [
        { "text": "Al secondo semaforo a destra, grazie.", "es": "En el segundo semáforo a la derecha, gracias." },
        { "text": "Alle due a sinistra.", "es": "A las dos a la izquierda." }
      ],
      "register": "lei",
      "situation": "calle",
      "notes": "Repetir la indicación en voz alta es la mejor forma de comprobarla.",
      "voice": "it-IT-DiegoNeural"
    },
    {
      "id": "move-strada.qa.ci-fa-una-foto",
      "question": "Scusi, ci può fare una foto?",
      "questionEs": "Perdone, ¿nos puede hacer una foto?",
      "accepted": [
        { "text": "Certo! Sorridete!", "es": "¡Claro! ¡Sonreíd!" },
        { "text": "Sì, certo. Pronti?", "es": "Sí, claro. ¿Listos?" }
      ],
      "distractors": [
        { "text": "Certo! Mi fate una foto?", "es": "¡Claro! ¿Me hacéis una foto?" },
        { "text": "No, è chiuso.", "es": "No, está cerrado." }
      ],
      "register": "lei",
      "situation": "calle",
      "voice": "it-IT-IsabellaNeural"
    },
    {
      "id": "move-strada.qa.oggi-e-chiuso",
      "question": "Guardi che oggi è chiuso.",
      "questionEs": "Mire que hoy está cerrado.",
      "accepted": [
        { "text": "Ah, e domani a che ora apre?", "es": "Ah, ¿y mañana a qué hora abre?" },
        { "text": "Peccato! Grazie lo stesso.", "es": "¡Qué pena! Gracias de todas formas." }
      ],
      "distractors": [
        { "text": "Perfetto, allora entro.", "es": "Perfecto, entonces entro." },
        { "text": "Sì, è aperto.", "es": "Sí, está abierto." }
      ],
      "register": "lei",
      "situation": "calle",
      "voice": "it-IT-DiegoNeural"
    }
