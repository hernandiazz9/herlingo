  "phrases": [
    { "id": "move-bus.dov-e-la-fermata", "text": "Dov'è la fermata dell'autobus?", "es": "¿Dónde está la parada del autobús?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.dove-si-compra-il-biglietto", "text": "Dove si compra il biglietto dell'autobus?", "es": "¿Dónde se compra el billete de autobús?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.lo-trova-dal-tabaccaio", "text": "Lo trova dal tabaccaio.", "es": "Lo encuentra en el estanco.", "register": "lei", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.un-biglietto-per-l-autobus", "text": "Un biglietto per l'autobus, per favore.", "es": "Un billete de autobús, por favor.", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.si-puo-fare-a-bordo", "text": "Si può fare il biglietto a bordo?", "es": "¿Se puede sacar el billete en el autobús?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.si-timbra-a-bordo", "text": "Il biglietto si timbra a bordo.", "es": "El billete se valida dentro del autobús.", "register": "neutral", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.quanto-dura-il-biglietto", "text": "Quanto dura il biglietto?", "es": "¿Cuánto tiempo vale el billete?", "literal": "¿Cuánto dura el billete?", "notes": "Muchos billetes urbanos valen 90 minutos desde que los validas.", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.che-autobus-devo-prendere", "text": "Che autobus devo prendere per la stazione?", "es": "¿Qué autobús tengo que coger para la estación?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.passa-da-qui-il-101", "text": "Passa da qui il 101?", "es": "¿Pasa por aquí el 101?", "notes": "Las líneas se dicen como números: «il centouno».", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.ogni-quanto-passa", "text": "Ogni quanto passa?", "es": "¿Cada cuánto pasa?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.passa-ogni-venti-minuti", "text": "Passa ogni venti minuti, più o meno.", "es": "Pasa cada veinte minutos, más o menos.", "register": "neutral", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.l-autobus-e-gia-passato", "text": "L'autobus è già passato?", "es": "¿Ya ha pasado el autobús?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.questo-autobus-va-in-centro", "text": "Questo autobus va in centro?", "es": "¿Este autobús va al centro?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.mi-dice-quando-arriviamo", "text": "Mi dice quando arriviamo alla Cattedrale?", "es": "¿Me avisa cuando lleguemos a la Catedral?", "register": "lei", "situation": "bus" },
    { "id": "move-bus.dove-devo-scendere-per", "text": "Dove devo scendere per Ballarò?", "es": "¿Dónde me tengo que bajar para Ballarò?", "notes": "Ballarò es el mercado más popular de Palermo.", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.e-questa-la-fermata-per", "text": "È questa la fermata per Ortigia?", "es": "¿Es esta la parada para Ortigia?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.posso-passare", "text": "Posso passare?", "es": "¿Puedo pasar?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.mi-fa-scendere", "text": "Scusi, mi fa scendere qui?", "es": "Perdone, ¿me deja bajar aquí?", "register": "lei", "situation": "bus" },
    { "id": "move-bus.prenoti-la-fermata", "text": "Prenoti la fermata.", "es": "Pida la parada.", "notes": "Pulsa el botón de «prenotazione fermata»; si no, el bus no para.", "register": "lei", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.deve-scendere-alla-prossima", "text": "Deve scendere alla prossima.", "es": "Tiene que bajarse en la próxima.", "register": "lei", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.capolinea-si-scende", "text": "Capolinea, si scende.", "es": "Final de trayecto, hay que bajar.", "register": "neutral", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.si-sposti-avanti", "text": "Si sposti un po' più avanti, per favore.", "es": "Échese un poco más adelante, por favor.", "register": "lei", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.questo-non-ci-va", "text": "Questo non ci va, deve prendere un altro autobus.", "es": "Este no va allí, tiene que coger otro autobús.", "register": "lei", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.da-dove-parte-il-pullman", "text": "Da dove parte il pullman per Siracusa?", "es": "¿De dónde sale el autobús para Siracusa?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.dov-e-l-autostazione", "text": "Dov'è l'autostazione?", "es": "¿Dónde está la estación de autobuses?", "register": "neutral", "situation": "bus" },
