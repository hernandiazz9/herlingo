    {
      "id": "move-bus.qa.prenda-il-101",
      "question": "Per la stazione? Prenda il 101.",
      "questionEs": "¿Para la estación? Coja el 101.",
      "accepted": [
        { "text": "Grazie! E dove lo prendo?", "es": "¡Gracias! ¿Y dónde lo cojo?" },
        { "text": "Il 101? Grazie mille.", "es": "¿El 101? Muchas gracias." }
