    { "id": "move-bus.a-bordo-o-in-biglietteria", "text": "Si compra a bordo o in biglietteria?", "es": "¿Se compra a bordo o en taquilla?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.si-fa-in-biglietteria", "text": "Il biglietto si fa in biglietteria, non a bordo.", "es": "El billete se saca en taquilla, no a bordo.", "register": "neutral", "situation": "bus", "tags": ["te-dicen"], "voice": "it-IT-DiegoNeural" },
    { "id": "move-bus.il-primo-pullman", "text": "A che ora c'è il primo pullman per Agrigento?", "es": "¿A qué hora sale el primer autobús para Agrigento?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.a-che-ora-parte-l-ultimo", "text": "A che ora parte l'ultimo?", "es": "¿A qué hora sale el último?", "register": "neutral", "situation": "bus" },
    { "id": "move-bus.quanto-ci-mette", "text": "Quanto ci mette ad arrivare a Taormina?", "es": "¿Cuánto tarda en llegar a Taormina?", "register": "neutral", "situation": "bus" },
