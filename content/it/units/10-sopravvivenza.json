  "phrases": [
    { "id": "surv.buongiorno", "text": "Buongiorno!", "es": "¡Buenos días!", "notes": "Hasta media tarde; con desconocidos es el saludo seguro.", "explanation": "Al entrar en una tienda, bar o farmacia hasta media tarde. «gior» suena «dyor»: buon-DYOR-no.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.buonasera", "text": "Buonasera!", "es": "¡Buenas tardes! / ¡Buenas noches!", "notes": "Desde media tarde (hacia las 16–17 h) y también al llegar por la noche.", "explanation": "Al entrar en un sitio o saludar a alguien a partir de media tarde. «uo» se dice seguido, sin pausa: buo-na-SE-ra.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.salve", "text": "Salve!", "es": "¡Hola!", "notes": "Un «hola» educado que vale con cualquiera, a cualquier hora.", "explanation": "Te vale para saludar a cualquiera, del camarero al recepcionista, a cualquier hora. La «v» se hace con el labio de abajo en los dientes: SAL-ve.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.buona-giornata", "text": "Buona giornata!", "es": "¡Que vaya bien el día!", "notes": "Para despedirte por la mañana o a mediodía.", "explanation": "Al despedirte del panadero o del dependiente por la mañana. «gior» suena «dyor»: buo-na-dyor-NA-ta.", "register": "neutral", "situation": "saludos", "tags": ["despedida"] },
    { "id": "surv.buona-serata", "text": "Buona serata!", "es": "¡Que vaya bien la noche!", "notes": "Para despedirte a partir de media tarde.", "explanation": "Al despedirte al salir del restaurante o de un bar por la tarde-noche. Acento en «ra»: buo-na-se-RA-ta.", "register": "neutral", "situation": "saludos", "tags": ["despedida"] },
    { "id": "surv.grazie-mille", "text": "Grazie mille!", "es": "¡Muchas gracias!", "literal": "¡Mil gracias!", "explanation": "Cuando alguien te ayuda de verdad: te indica el camino, te guarda la mochila. La «z» suena «ts»: GRA-tsie MIL-le, con la doble «l» marcada.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.prego", "text": "Prego.", "es": "De nada. / Adelante.", "notes": "También lo oirás como «¿qué desea?» o «pase usted».", "explanation": "Contestas así a un «grazie», y te lo dirán al invitarte a pasar o al atenderte. Acento al principio: PRE-go.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.si-figuri", "text": "Si figuri!", "es": "¡No hay de qué!", "notes": "Respuesta a «grazie» de usted; con amigos, «Figurati!».", "explanation": "Respondes así a un «grazie» de alguien a quien tratas de usted, como un recepcionista. Acento en «fi»: si FI-gu-ri.", "register": "lei", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.mi-scusi", "text": "Mi scusi!", "es": "¡Perdone!", "notes": "Para llamar la atención de alguien o pedir perdón, de usted.", "explanation": "Para parar a alguien por la calle o si le das un empujón sin querer. «scu» suena «sku»: mi SKU-si.", "register": "lei", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.permesso", "text": "Permesso!", "es": "¡Con permiso!", "notes": "Para abrirte paso en el bus o el mercado, o al entrar en una casa.", "explanation": "Para abrirte paso en un bus lleno o al entrar en casa de alguien. Alarga la doble «s»: per-MES-so.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.mi-dispiace", "text": "Mi dispiace.", "es": "Lo siento.", "explanation": "Para disculparte en serio o decir que no puedes ayudar. «ce» suena «che»: mi di-SPIA-che.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.va-bene", "text": "Va bene.", "es": "Vale. / De acuerdo.", "explanation": "Para aceptar un plan, un precio o una indicación. Dilo casi como una sola palabra: va-BE-ne.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.volentieri", "text": "Volentieri!", "es": "¡Con mucho gusto!", "notes": "Para aceptar una invitación o una propuesta.", "explanation": "Cuando alguien te invita a un café o te propone ir a algún sitio. Acento en «tie»: vo-len-TIE-ri.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },

    { "id": "surv.non-capisco", "text": "Non capisco.", "es": "No entiendo.", "explanation": "Cuando no entiendes nada de lo que te dicen. «sco» suena «sko»: non ka-PI-sko.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.non-ho-capito", "text": "Non ho capito.", "es": "No lo he entendido.", "notes": "En la conversación es más frecuente que «non capisco».", "explanation": "Lo más natural cuando se te escapa lo que te acaban de decir. La «h» es muda: non o ka-PI-to.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.come-scusi", "text": "Come, scusi?", "es": "¿Cómo dice?", "notes": "La reacción más natural cuando no has pillado algo.", "explanation": "La reacción rápida cuando no pillas algo, con camareros o taquilleros. Sube el tono al final, como pregunta: KO-me, SKU-si?", "register": "lei", "situation": "no-entiendo" },
    { "id": "surv.puo-ripetere", "text": "Può ripetere, per favore?", "es": "¿Puede repetir, por favor?", "explanation": "Cuando alguien a quien tratas de usted, como el de la taquilla, habla demasiado rápido. Acento en «pe»: ri-PE-te-re.", "register": "lei", "situation": "no-entiendo" },
    { "id": "surv.puoi-ripetere", "text": "Puoi ripetere?", "es": "¿Puedes repetir?", "explanation": "La versión con tú, para alguien de tu edad o un amigo. «puoi» es una sola sílaba: PUOI ri-PE-te-re.", "register": "tu", "situation": "no-entiendo" },
    { "id": "surv.piu-piano", "text": "Più piano, per favore.", "es": "Más despacio, por favor.", "notes": "Aquí «piano» significa «despacio».", "explanation": "Cuando te hablan demasiado rápido; dilo con una sonrisa. «più» lleva el acento en la «u»: PIU PIA-no.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.parlo-poco", "text": "Parlo solo un po' d'italiano.", "es": "Solo hablo un poco de italiano.", "explanation": "Úsalo al empezar a hablar con alguien: así te tendrán paciencia. «un po'» es muy corto, casi «um-PO».", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.parla-inglese", "text": "Parla inglese?", "es": "¿Habla inglés?", "explanation": "Plan B con el personal de hoteles o estaciones. Acento en «gle»: PAR-la in-GLE-se.", "register": "lei", "situation": "no-entiendo" },
    { "id": "surv.parla-spagnolo", "text": "Parla spagnolo?", "es": "¿Habla español?", "explanation": "Plan B si te atascas: en Sicilia mucha gente entiende algo de español. «gn» es una «ñ»: spa-ÑO-lo.", "register": "lei", "situation": "no-entiendo" },
    { "id": "surv.cosa-vuol-dire", "text": "Cosa vuol dire?", "es": "¿Qué significa?", "literal": "¿Qué quiere decir?", "explanation": "Para preguntar por una palabra que oyes o lees en un cartel o una carta. «vuol» es una sola sílaba: VUOL DI-re.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.come-si-dice", "text": "Come si dice in italiano?", "es": "¿Cómo se dice en italiano?", "explanation": "Señala algo y pregúntalo: aprenderás palabras sobre la marcha. «ce» suena «che»: si DI-che.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.me-lo-scrive", "text": "Me lo può scrivere?", "es": "¿Me lo puede escribir?", "notes": "Salvavidas con precios, horas y andenes.", "explanation": "Cuando no pillas un precio, una hora o un andén: que te lo apunten. «scri» suena «skri»: SKRI-ve.", "register": "lei", "situation": "no-entiendo" },
    { "id": "surv.un-attimo", "text": "Un attimo, per favore.", "es": "Un momento, por favor.", "explanation": "Para pedir que te esperen mientras buscas el dinero o miras el móvil. Marca la doble «t» y el acento en la «a»: un AT-ti-mo.", "register": "neutral", "situation": "no-entiendo" },
    { "id": "surv.non-lo-so", "text": "Non lo so.", "es": "No lo sé.", "explanation": "Cuando te preguntan algo y no tienes ni idea. Todo seguido: non lo SO.", "register": "neutral", "situation": "no-entiendo" },

    { "id": "surv.fanno-sedici-euro", "text": "Fanno sedici euro.", "es": "Son dieciséis euros.", "literal": "Hacen dieciséis euros.", "notes": "«Fanno» es muy típico al cobrar.", "explanation": "Te lo dirán en la caja al cobrarte. «ci» suena «chi»: SE-di-chi; y la doble «n» de «fanno» se nota.", "register": "neutral", "situation": "numeros", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "surv.diciotto-e-cinquanta", "text": "Diciotto e cinquanta.", "es": "Dieciocho cincuenta.", "notes": "Los céntimos se dicen sin «euro» ni «centesimi».", "explanation": "Así te cantan un precio en caja, sin decir «euro». «ci» suena «chi»: di-CHOT-to e chin-KUAN-ta.", "register": "neutral", "situation": "numeros", "tags": ["escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "surv.sono-tre-euro-e-venti", "text": "Sono tre euro e venti.", "es": "Son tres euros con veinte.", "explanation": "Otra forma de decirte un precio al pagar. La «v» se hace con el labio de abajo en los dientes: VEN-ti.", "register": "neutral", "situation": "numeros", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },

    { "id": "surv.quanto-costa", "text": "Quanto costa?", "es": "¿Cuánto cuesta?", "explanation": "Para preguntar el precio de una cosa en el mercado o una tienda. «qua» suena «kua»: KUAN-to KO-sta.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },
    { "id": "surv.quanto-costano", "text": "Quanto costano?", "es": "¿Cuánto cuestan?", "explanation": "Cuando preguntas por varias cosas a la vez. Acento en «co», no en «sta»: KO-sta-no.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },
    { "id": "surv.quant-e", "text": "Quant'è?", "es": "¿Cuánto es?", "notes": "Para preguntar el total cuando vas a pagar.", "explanation": "Al ir a pagar, para saber el total. Se une todo, con el acento al final: kuan-TE.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },
    { "id": "surv.posso-pagare-con-la-carta", "text": "Posso pagare con la carta?", "es": "¿Puedo pagar con tarjeta?", "explanation": "Antes de pedir en bares pequeños o puestos, por si solo aceptan efectivo. Marca la doble «s»: POS-so pa-GA-re.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },
    { "id": "surv.solo-contanti", "text": "Solo contanti.", "es": "Solo en efectivo.", "notes": "Todavía pasa en mercados, quioscos y algún bar.", "explanation": "Te lo dirán en mercados o quioscos: lleva billetes encima. Acento en «tan»: kon-TAN-ti.", "register": "neutral", "situation": "compras", "tags": ["pagar", "escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "surv.ha-spiccioli", "text": "Ha spiccioli?", "es": "¿Tiene suelto?", "notes": "Te lo preguntarán si pagas con un billete grande.", "explanation": "Te lo preguntarán si pagas con un billete grande. La «h» es muda y «ccio» es una «ch» larga: a SPIT-cho-li.", "register": "lei", "situation": "compras", "tags": ["pagar", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "surv.non-ho-spiccioli", "text": "Non ho spiccioli, mi dispiace.", "es": "No tengo suelto, lo siento.", "explanation": "Cuando solo llevas un billete grande y te piden suelto. «ccio» es una «ch» larga: SPIT-cho-li.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },
    { "id": "surv.ecco-il-resto", "text": "Ecco il resto.", "es": "Aquí tiene la vuelta.", "explanation": "Lo oirás al recibir la vuelta en cualquier caja. Marca la doble «c»: EK-ko il RE-sto.", "register": "neutral", "situation": "compras", "tags": ["pagar", "escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "surv.c-e-un-bancomat", "text": "C'è un bancomat qui vicino?", "es": "¿Hay un cajero por aquí cerca?", "explanation": "Cuando necesitas efectivo para el mercado o un bar que no acepta tarjeta. «c'è» suena «che»: che un BAN-ko-mat.", "register": "neutral", "situation": "compras", "tags": ["pagar"] },

    { "id": "surv.quanto-costano-queste", "text": "Quanto costano queste?", "es": "¿Cuánto cuestan estas?", "explanation": "Señalando la fruta o los recuerdos de un puesto. «que» suena «kue»: KUE-ste.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.posso-assaggiare", "text": "Posso assaggiare?", "es": "¿Puedo probar?", "notes": "En los mercados de Palermo y Catania suelen dejarte probar.", "explanation": "En los puestos de fruta, queso o aceitunas del mercado. «ggia» suena como «dya» alargada: as-sad-DYA-re.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.solo-guardando", "text": "Sto solo guardando, grazie.", "es": "Solo estoy mirando, gracias.", "explanation": "Cuando un dependiente se acerca y solo quieres curiosear. Acento en «dan»: guar-DAN-do.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.mezzo-chilo", "text": "Mezzo chilo, per favore.", "es": "Medio kilo, por favor.", "explanation": "En el mercado, para pedir fruta o verdura a peso. «zz» suena «dz» y «chi» es «ki»: MED-dzo KI-lo.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.due-etti", "text": "Due etti di olive, per favore.", "es": "Doscientos gramos de aceitunas, por favor.", "notes": "Un «etto» son 100 gramos: así se pide en el mercado.", "explanation": "Así se pide a peso en la charcutería o el puesto de aceitunas. Marca la doble «t»: DU-e ET-ti.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.e-un-po-caro", "text": "È un po' caro.", "es": "Es un poco caro.", "explanation": "Para comentar un precio en el mercado; a lo mejor te hacen descuento. «un po'» es muy corto, casi «um-PO».", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.lo-prendo", "text": "Lo prendo.", "es": "Me lo llevo.", "literal": "Lo cojo.", "explanation": "Cuando has decidido comprar algo en una tienda o un puesto. Acento en «pren»: lo PREN-do.", "register": "neutral", "situation": "compras", "tags": ["mercado"] },
    { "id": "surv.quanto-ne-vuole", "text": "Quanto ne vuole?", "es": "¿Cuánto quiere?", "notes": "«Ne» = «de eso»: te pregunta la cantidad.", "explanation": "Te lo pregunta el del puesto cuando pides algo a peso. «vuo» es una sola sílaba: KUAN-to ne VUO-le.", "register": "lei", "situation": "compras", "tags": ["mercado", "escuchar"], "voice": "it-IT-DiegoNeural" },

    { "id": "surv.che-ore-sono", "text": "Che ore sono?", "es": "¿Qué hora es?", "explanation": "Para preguntar la hora a alguien por la calle. «che» suena «ke»: ke O-re SO-no.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.sono-le-tre", "text": "Sono le tre.", "es": "Son las tres.", "explanation": "Para dar la hora o entenderla cuando te la dicen. La «r» es simple, como en «pero»: SO-no le TRE.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.e-l-una", "text": "È l'una.", "es": "Es la una.", "explanation": "Para decir o entender la una en punto: va en singular. Se une todo: e-LU-na.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.e-mezzogiorno", "text": "È mezzogiorno.", "es": "Son las doce del mediodía.", "explanation": "Para hablar de las doce, la hora de ir pensando en comer. «zz» suena «dz» y «gior» «dyor»: med-dzo-DYOR-no.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.alle-otto-e-mezza", "text": "Alle otto e mezza.", "es": "A las ocho y media.", "explanation": "Para quedar o reservar a una hora. Marca las dobles: AL-le OT-to e MED-dza.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.alle-sette-meno-un-quarto", "text": "Alle sette meno un quarto.", "es": "A las siete menos cuarto.", "explanation": "Para quedar o entender horarios. «qua» suena «kua» y la doble «t» se nota: SET-te ME-no un KUAR-to.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.tra-dieci-minuti", "text": "Tra dieci minuti.", "es": "Dentro de diez minutos.", "explanation": "Para decir cuándo llegas o cuándo sale algo. «ci» suena «chi»: DIE-chi mi-NU-ti.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.tra-un-quarto-d-ora", "text": "Tra un quarto d'ora.", "es": "Dentro de un cuarto de hora.", "explanation": "Para decir cuánto falta para llegar o salir. «d'ora» se une: KUAR-to DO-ra.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.a-che-ora-apre", "text": "A che ora apre?", "es": "¿A qué hora abre?", "explanation": "Para preguntar por museos, tiendas o farmacias. «che» suena «ke»: a ke O-ra A-pre.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.a-che-ora-chiude", "text": "A che ora chiude?", "es": "¿A qué hora cierra?", "explanation": "Para saber hasta cuándo puedes entrar en un museo o una tienda. «chiu» suena «kiu»: KIU-de.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "surv.riapriamo-alle-cinque", "text": "Riapriamo alle cinque.", "es": "Volvemos a abrir a las cinco.", "notes": "En Sicilia muchas tiendas cierran de 13 a 16–17 h.", "explanation": "Lo leerás o te lo dirán en tiendas que cierran a mediodía. «cin» suena «chin»: CHIN-kue.", "register": "neutral", "situation": "numeros", "tags": ["hora", "escuchar"], "voice": "it-IT-IsabellaNeural" },

    { "id": "surv.oggi-e-chiuso", "text": "Oggi è chiuso.", "es": "Hoy está cerrado.", "explanation": "Te lo dirán en la puerta de un museo o una tienda. «oggi» suena «OD-dyi» y «chiu» es «kiu»: KIU-so.", "register": "neutral", "situation": "numeros", "tags": ["dias", "escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "surv.la-domenica-siamo-chiusi", "text": "La domenica siamo chiusi.", "es": "Los domingos cerramos.", "explanation": "Lo verás en carteles y te lo dirán en tiendas pequeñas. Acento en «me»: do-ME-ni-ka.", "register": "neutral", "situation": "numeros", "tags": ["dias", "escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "surv.a-domani", "text": "A domani!", "es": "¡Hasta mañana!", "explanation": "Para despedirte de alguien a quien verás mañana, como el de tu alojamiento. Acento en «ma»: a do-MA-ni.", "register": "neutral", "situation": "saludos", "tags": ["despedida"] },
    { "id": "surv.ci-vediamo-stasera", "text": "Ci vediamo stasera?", "es": "¿Nos vemos esta noche?", "explanation": "Para quedar con alguien que has conocido en el viaje. «ci» suena «chi»: chi ve-DIA-mo sta-SE-ra.", "register": "neutral", "situation": "presentarse", "tags": ["dias"] },

    { "id": "surv.dov-e-il-bagno", "text": "Dov'è il bagno, per favore?", "es": "¿Dónde está el baño, por favor?", "notes": "En un bar, lo educado es tomar algo antes.", "explanation": "En bares, restaurantes o museos. «gn» es una «ñ»: do-VE il BA-ño.", "register": "neutral", "situation": "bar" },
    { "id": "surv.posso-usare-il-bagno", "text": "Posso usare il bagno?", "es": "¿Puedo usar el baño?", "explanation": "En un bar donde aún no has tomado nada; pregúntalo con educación. «gn» es una «ñ»: il BA-ño.", "register": "neutral", "situation": "bar" },
    { "id": "surv.c-e-il-wifi", "text": "C'è il wifi?", "es": "¿Hay wifi?", "notes": "Se pronuncia «uai-fai».", "explanation": "En el alojamiento, un bar o un restaurante. «c'è» suena «che»: che il UAI-fai.", "register": "neutral", "situation": "alojamiento" },
    { "id": "surv.qual-e-la-password", "text": "Qual è la password del wifi?", "es": "¿Cuál es la contraseña del wifi?", "explanation": "Al camarero o en recepción, cuando ya sabes que hay wifi. «qual è» se une: kua-LE.", "register": "neutral", "situation": "alojamiento" },
    { "id": "surv.posso-caricare", "text": "Posso caricare il telefono qui?", "es": "¿Puedo cargar el móvil aquí?", "explanation": "En un bar o en recepción, cuando te quedas sin batería. Acento en la segunda «ca»: ka-ri-KA-re.", "register": "neutral", "situation": "alojamiento" },
    { "id": "surv.mi-da-un-sacchetto", "text": "Mi dà un sacchetto, per favore?", "es": "¿Me da una bolsa, por favor?", "notes": "Las bolsas se pagan: unos céntimos.", "explanation": "En el súper o una tienda, al pagar. «cch» es una «k» larga: sak-KET-to.", "register": "lei", "situation": "compras" },
    { "id": "surv.posso-lasciare-lo-zaino", "text": "Posso lasciare lo zaino qui?", "es": "¿Puedo dejar la mochila aquí?", "notes": "Útil el día que dejas el alojamiento y tu tren sale tarde.", "explanation": "En recepción, cuando dejas el alojamiento y aún tienes horas por delante. «scia» suena «sha»: la-SHA-re; «z» suena «dz»: DZAI-no.", "register": "neutral", "situation": "alojamiento" },
    { "id": "surv.c-e-un-supermercato", "text": "C'è un supermercato qui vicino?", "es": "¿Hay un súper por aquí cerca?", "explanation": "Para comprar agua o algo de comer barato. «c'è» suena «che»: che un su-per-mer-KA-to.", "register": "neutral", "situation": "compras" }
  ],
