  "phrases": [
    { "id": "surv.buongiorno", "text": "Buongiorno!", "es": "¡Buenos días!", "notes": "Hasta media tarde; con desconocidos es el saludo seguro.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.buonasera", "text": "Buonasera!", "es": "¡Buenas tardes! / ¡Buenas noches!", "notes": "Desde media tarde (hacia las 16–17 h) y también al llegar por la noche.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.salve", "text": "Salve!", "es": "¡Hola!", "notes": "Un «hola» educado que vale con cualquiera, a cualquier hora.", "register": "neutral", "situation": "saludos", "tags": ["saludo"] },
    { "id": "surv.buona-giornata", "text": "Buona giornata!", "es": "¡Que vaya bien el día!", "notes": "Para despedirte por la mañana o a mediodía.", "register": "neutral", "situation": "saludos", "tags": ["despedida"] },
    { "id": "surv.buona-serata", "text": "Buona serata!", "es": "¡Que vaya bien la noche!", "notes": "Para despedirte a partir de media tarde.", "register": "neutral", "situation": "saludos", "tags": ["despedida"] },
    { "id": "surv.grazie-mille", "text": "Grazie mille!", "es": "¡Muchas gracias!", "literal": "¡Mil gracias!", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.prego", "text": "Prego.", "es": "De nada. / Adelante.", "notes": "También lo oirás como «¿qué desea?» o «pase usted».", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.si-figuri", "text": "Si figuri!", "es": "¡No hay de qué!", "notes": "Respuesta a «grazie» de usted; con amigos, «Figurati!».", "register": "lei", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.mi-scusi", "text": "Mi scusi!", "es": "¡Perdone!", "notes": "Para llamar la atención de alguien o pedir perdón, de usted.", "register": "lei", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.permesso", "text": "Permesso!", "es": "¡Con permiso!", "notes": "Para abrirte paso en el bus o el mercado, o al entrar en una casa.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.mi-dispiace", "text": "Mi dispiace.", "es": "Lo siento.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.va-bene", "text": "Va bene.", "es": "Vale. / De acuerdo.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },
    { "id": "surv.volentieri", "text": "Volentieri!", "es": "¡Con mucho gusto!", "notes": "Para aceptar una invitación o una propuesta.", "register": "neutral", "situation": "saludos", "tags": ["cortesia"] },

    { "id": "surv.non-capisco", "text": "Non capisco.", "es": "No entiendo.", "register": "neutral", "situation": "no-entiendo" },
