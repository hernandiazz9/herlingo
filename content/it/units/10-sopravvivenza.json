      "question": "Buongiorno! Come sta?",
      "questionEs": "¡Buenos días! ¿Cómo está?",
      "accepted": [
        { "text": "Bene, grazie. E Lei?", "es": "Bien, gracias. ¿Y usted?" },
        { "text": "Tutto bene, grazie!", "es": "Todo bien, ¡gracias!" }
      ],
      "distractors": [
