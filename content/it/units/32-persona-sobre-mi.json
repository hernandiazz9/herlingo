  "phrases": [
    { "id": "talk-io.mi-chiamo", "text": "Mi chiamo Hernán.", "es": "Me llamo Hernán.", "explanation": "Al presentarte. «chiamo» suena «KIA-mo»: «chi» es «ki».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-spagnolo", "text": "Sono spagnolo.", "es": "Soy español.", "notes": "Si eres mujer: «Sono spagnola».", "explanation": "Cuando te preguntan de dónde eres. «spagnolo» suena «spa-ÑO-lo».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-di-madrid", "text": "Sono di Madrid.", "es": "Soy de Madrid.", "explanation": "Para decir tu ciudad. «sono» con «o» cerrada y la «s» suave: SO-no.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.vengo-dalla-spagna", "text": "Vengo dalla Spagna, da Madrid.", "es": "Vengo de España, de Madrid.", "explanation": "Respuesta a «di dove sei?». «Spagna» suena «SPA-ña» y «dalla» lleva «ll» larga.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.abito-a-madrid", "text": "Abito a Madrid.", "es": "Vivo en Madrid.", "explanation": "Al hablar de dónde vives. Acento en la primera sílaba: A-bi-to.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.madrid-e-la-capitale", "text": "Madrid è la capitale, al centro della Spagna.", "es": "Madrid es la capital, en el centro de España.", "explanation": "Si te preguntan dónde queda Madrid. «capitale» lleva el acento en «TA»: ca-pi-TA-le.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.lavoro-nell-informatica", "text": "Lavoro nell'informatica.", "es": "Trabajo en informática.", "explanation": "Respuesta a «che lavoro fai?». Acento en «MA»: in-for-MA-ti-ca.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-programmatore", "text": "Sono programmatore.", "es": "Soy programador.", "notes": "Sin artículo: «sono programmatore», «sono ingegnere».", "explanation": "Al hablar de tu trabajo. Doble «mm» larga: pro-gram-ma-TO-re.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.faccio-il-programmatore", "text": "Faccio il programmatore.", "es": "Trabajo de programador.", "literal": "Hago el programador.", "explanation": "Otra forma natural de decir tu profesión. «faccio» suena «FAT-cho».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.lavoro-da-casa", "text": "Lavoro con il computer, da casa.", "es": "Trabajo con el ordenador, desde casa.", "explanation": "Si te preguntan más sobre tu trabajo. «computer» se dice «kom-PIU-ter».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.adesso-sono-in-ferie", "text": "Adesso sono in ferie.", "es": "Ahora estoy de vacaciones.", "explanation": "Para explicar que estás de vacaciones del trabajo. «ferie» lleva el acento en «FE»: FE-rie.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-in-vacanza", "text": "Sono in vacanza.", "es": "Estoy de vacaciones.", "explanation": "Respuesta a «sei qui in vacanza?». «vacanza» suena «va-KAN-tsa».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.e-la-prima-volta-che-vengo", "text": "È la prima volta che vengo in Sicilia.", "es": "Es la primera vez que vengo a Sicilia.", "explanation": "Respuesta a «è la prima volta?». «Sicilia» suena «si-CHI-lia».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.resto-una-decina-di-giorni", "text": "Resto una decina di giorni.", "es": "Me quedo unos diez días.", "explanation": "Respuesta a «quanto ti fermi?». «decina» suena «de-CHI-na» y «giorni» «DYOR-ni».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-arrivato-ieri", "text": "Sono arrivato a Palermo ieri.", "es": "Llegué ayer a Palermo.", "notes": "Si eres mujer: «Sono arrivata».", "explanation": "Al contar tu viaje. «ieri» suena «IE-ri» y «arrivato» lleva «rr» vibrante.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.viaggio-da-solo", "text": "Viaggio da solo.", "es": "Viajo solo.", "notes": "Si eres mujer: «da sola».", "explanation": "Respuesta a «sei da solo?». «viaggio» suena «VIAD-dyo».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.mi-muovo-in-treno", "text": "Mi muovo in treno e in autobus.", "es": "Me muevo en tren y en autobús.", "explanation": "Al explicar cómo te mueves por la isla. «muovo» suena «MUO-vo».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.non-ho-la-macchina", "text": "Non ho la macchina.", "es": "No tengo coche.", "explanation": "Si te preguntan cómo te mueves o te ofrecen ir en coche. «macchina» suena «MAK-ki-na».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.il-mio-giro", "text": "Faccio Palermo, Cefalù, Agrigento, Catania e Siracusa.", "es": "Mi ruta: Palermo, Cefalù, Agrigento, Catania y Siracusa.", "literal": "Hago Palermo, Cefalù, Agrigento, Catania y Siracusa.", "explanation": "Para contar tu ruta por Sicilia. «Cefalù» acentúa la «ù» final: che-fa-LÙ.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.dopo-palermo-vado-a-catania", "text": "Dopo Palermo vado a Catania.", "es": "Después de Palermo voy a Catania.", "explanation": "Para contar tu siguiente parada. «Catania» lleva el acento en «TA»: ca-TA-nia.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sono-stato-a-cefalu", "text": "Sono stato a Cefalù, bellissima!", "es": "He estado en Cefalù, ¡preciosa!", "explanation": "Para contar un sitio que te ha gustado. «bellissima» con «ll» y «ss» largas.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.torno-in-spagna", "text": "Torno in Spagna la settimana prossima.", "es": "Vuelvo a España la semana que viene.", "explanation": "Al hablar de tu vuelta. «settimana» con «tt» larga: set-ti-MA-na.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.parlo-solo-un-po", "text": "Parlo solo un po' d'italiano.", "es": "Solo hablo un poco de italiano.", "explanation": "Para avisar al empezar una conversación. «po'» es muy corto, con «o» abierta.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.sto-imparando", "text": "Sto imparando l'italiano per questo viaggio.", "es": "Estoy aprendiendo italiano para este viaje.", "explanation": "Para explicar tus errores; suele caer muy bien. «imparando» lleva el acento en «RAN».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.studio-con-un-app", "text": "Studio con un'app sul telefono.", "es": "Estudio con una app en el móvil.", "explanation": "Si te preguntan cómo aprendes. «un'app» se dice de corrido: u-NAP.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.capisco-piu-di-quanto-parlo", "text": "Capisco più di quanto parlo.", "es": "Entiendo más de lo que hablo.", "explanation": "Para pedir paciencia en una charla. «capisco» suena «ka-PIS-ko».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.mi-piace-la-cucina-siciliana", "text": "Mi piace tantissimo la cucina siciliana.", "es": "Me encanta la cocina siciliana.", "explanation": "Para elogiar la comida ante alguien de allí. «cucina» suena «ku-CHI-na».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.adoro-la-granita", "text": "Adoro la granita con la brioche.", "es": "Me encanta la granita con brioche.", "explanation": "En el bar o al hablar de comida. «brioche» se dice a la francesa: bri-OSH.", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.mi-piace-il-mare", "text": "Mi piace il mare.", "es": "Me gusta el mar.", "explanation": "Al hablar de planes o gustos. «piace» suena «PIA-che».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] },
    { "id": "talk-io.mi-piacciono-i-mercati", "text": "Mi piacciono molto i mercati.", "es": "Me gustan mucho los mercados.", "notes": "Con plural: «mi piacciono».", "explanation": "Al hablar de Ballarò o de otros mercados. «piacciono» suena «PIAT-cho-no».", "register": "neutral", "situation": "presentarse", "tags": ["persona"] }
  ],
