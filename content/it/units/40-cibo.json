  "phrases": [
    { "id": "food.un-caffe", "text": "Un caffè, per favore.", "es": "Un café, por favor.", "notes": "En Italia «un caffè» es un expreso corto.", "explanation": "En la barra de cualquier bar, a cualquier hora. Marca la doble «f» y el acento final: kaf-FE.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.cappuccino-e-cornetto", "text": "Un cappuccino e un cornetto, per favore.", "es": "Un capuchino y un cruasán, por favor.", "explanation": "El desayuno típico en la barra del bar, nunca después de comer. «ccino» suena «chino» con «ch» larga: kap-put-CHI-no.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.caffe-macchiato", "text": "Un caffè macchiato, per favore.", "es": "Un cortado, por favor.", "literal": "Un café manchado, por favor.", "explanation": "En la barra, si quieres el expreso con un poco de leche. «cchia» suena «kia»: mak-KIA-to.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.cosa-prende", "text": "Cosa prende?", "es": "¿Qué va a tomar?", "explanation": "Te lo preguntará el camarero en cuanto te acerques a la barra o a la mesa. Acento en «pren»: KO-sa PREN-de.", "register": "lei", "situation": "bar", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.ecco-a-lei", "text": "Ecco a Lei.", "es": "Aquí tiene.", "explanation": "Lo oirás al servirte el café o al darte la vuelta. Marca la doble «c»: EK-ko a LEI.", "register": "lei", "situation": "bar", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.altro", "text": "Altro?", "es": "¿Algo más?", "explanation": "Te lo pregunta el camarero o el dependiente antes de cobrar. Acento en «al»: AL-tro.", "register": "neutral", "situation": "bar", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.basta-cosi", "text": "Basta così, grazie.", "es": "Nada más, gracias.", "literal": "Basta así, gracias.", "explanation": "Para decir que ya has pedido todo. «così» lleva el acento al final: BA-sta ko-SI.", "register": "neutral", "situation": "bar" },
    { "id": "food.bicchiere-d-acqua", "text": "Un bicchiere d'acqua, per favore.", "es": "Un vaso de agua, por favor.", "notes": "Muchos italianos lo piden junto con el café.", "explanation": "Pídelo con el café o en la mesa. «cchie» suena «kie» y «cqu» es una «k» larga: bik-KIE-re DAK-kua.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },

    { "id": "food.al-banco", "text": "Lo prendo al banco.", "es": "Me lo tomo en la barra.", "notes": "En la barra es más barato que sentado a la mesa.", "explanation": "Al pedir en el bar, para que te cobren el precio de barra. Acento en «pren»: lo PREN-do al BAN-ko.", "register": "neutral", "situation": "bar" },
    { "id": "food.si-paga-prima", "text": "Si paga prima alla cassa?", "es": "¿Se paga antes en caja?", "notes": "En muchos bares pagas primero y das el tique en la barra.", "explanation": "Al entrar en un bar lleno con la caja aparte. Marca la doble «s»: al-la KAS-sa.", "register": "neutral", "situation": "bar", "tags": ["pagar"] },
    { "id": "food.ecco-lo-scontrino", "text": "Ecco lo scontrino.", "es": "Aquí tiene el tique.", "explanation": "Lo oirás al pagar; en muchos bares luego lo enseñas en la barra. «sco» es «sko»: skon-TRI-no.", "register": "neutral", "situation": "bar", "tags": ["pagar"] },
    { "id": "food.quanto-le-devo", "text": "Quanto Le devo?", "es": "¿Cuánto le debo?", "explanation": "Al acabar en un bar o una tienda pequeña, para pagar. Acento en «de»: KUAN-to le DE-vo.", "register": "lei", "situation": "bar", "tags": ["pagar"] },
    { "id": "food.ci-possiamo-sedere", "text": "Ci possiamo sedere a un tavolino?", "es": "¿Nos podemos sentar en una mesa?", "notes": "Sentado suele costar algo más que en la barra.", "explanation": "Pregúntalo al camarero antes de sentarte en una terraza. «ci» suena «chi»: chi pos-SIA-mo se-DE-re.", "register": "neutral", "situation": "bar" },
    { "id": "food.una-spremuta", "text": "Una spremuta d'arancia, per favore.", "es": "Un zumo de naranja natural, por favor.", "explanation": "En el bar por la mañana, zumo recién exprimido. «cia» de «arancia» suena «cha»: a-RAN-cha.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },

    { "id": "food.granita-e-brioche", "text": "Una granita alla mandorla con brioche, per favore.", "es": "Un granizado de almendra con brioche, por favor.", "notes": "El desayuno siciliano de verano por excelencia.", "explanation": "En los bares de Sicilia en verano, sobre todo para desayunar. «brioche» se dice a la francesa: bri-OSH.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.che-gusti", "text": "Che gusti ci sono?", "es": "¿Qué sabores hay?", "explanation": "En la heladería o al pedir granita, antes de elegir. «che» suena «ke»: ke GU-sti.", "register": "neutral", "situation": "bar" },
    { "id": "food.meta-e-meta", "text": "Posso avere metà mandorla e metà gelsi?", "es": "¿Me la pone mitad almendra y mitad mora?", "literal": "¿Puedo tener mitad almendra y mitad moras?", "explanation": "En la heladería o al pedir granita, para mezclar dos sabores. «gelsi» empieza por «dye»: DYEL-si; «metà» lleva acento final.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.con-panna", "text": "Con la panna?", "es": "¿Con nata?", "explanation": "Te lo preguntarán al servirte helado o granita. Marca la doble «n»: PAN-na.", "register": "neutral", "situation": "bar", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.senza-panna", "text": "Senza panna, grazie.", "es": "Sin nata, gracias.", "explanation": "Al pedir helado, granita o café si no quieres nata. La «z» suena «ts»: SEN-tsa PAN-na.", "register": "neutral", "situation": "bar" },
    { "id": "food.e-buonissima", "text": "È buonissima!", "es": "¡Está buenísima!", "explanation": "Para felicitar al heladero o al cocinero por un dulce o una granita. Doble «s» y acento en «nis»: buo-NIS-si-ma.", "register": "neutral", "situation": "bar" },

    { "id": "food.un-cannolo", "text": "Un cannolo, per favore.", "es": "Un cannolo, por favor.", "explanation": "En una pastelería siciliana, el dulce que no te puedes perder. Marca la doble «n»; el acento cae en «no»: kan-NO-lo.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.cosa-mi-consiglia", "text": "Cosa mi consiglia?", "es": "¿Qué me recomienda?", "explanation": "Pregúntalo en la pastelería, la heladería o el restaurante si dudas. «glia» suena como una «ll» suave: kon-SI-lla.", "register": "lei", "situation": "bar" },
    { "id": "food.brioche-col-gelato", "text": "Una brioche col gelato: pistacchio e cioccolato.", "es": "Un brioche con helado: pistacho y chocolate.", "notes": "En Sicilia el helado se toma también dentro de un brioche.", "explanation": "En las heladerías de Sicilia, para merendar a lo siciliano. «ge» suena «dye» y «cchio» «kio»: dye-LA-to, pi-STAK-kio.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.coppetta-o-cono", "text": "Coppetta o cono?", "es": "¿Tarrina o cucurucho?", "explanation": "Te lo preguntará el heladero antes de servirte. Marca las dobles «p» y «t»: kop-PET-ta.", "register": "neutral", "situation": "bar", "tags": ["escuchar"], "voice": "it-IT-IsabellaNeural" },
    { "id": "food.coppetta-piccola", "text": "Una coppetta piccola, per favore.", "es": "Una tarrina pequeña, por favor.", "explanation": "Al pedir helado si no quieres una tarrina enorme. Marca la doble «c»: PIK-ko-la.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },

    { "id": "food.arancina-al-ragu", "text": "Un'arancina al ragù, per favore.", "es": "Una arancina de ragú, por favor.", "notes": "En Palermo se dice «l'arancina», en femenino.", "explanation": "En las freidurías y bares de Palermo, para comer algo rápido. «ci» suena «chi»: a-ran-CHI-na; «ragù» con acento final.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.arancino-al-burro", "text": "Un arancino al burro, per favore.", "es": "Un arancino de jamón y queso, por favor.", "notes": "En Catania es «l'arancino»; «al burro» lleva jamón, mozzarella y bechamel.", "explanation": "En los bares de Catania y del este de Sicilia. «ci» suena «chi» y marca la doble «r»: a-ran-CHI-no al BUR-ro.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.cosa-c-e-dentro", "text": "Cosa c'è dentro?", "es": "¿Qué lleva dentro?", "explanation": "Pregúntalo ante una vitrina de bar o freiduría con cosas que no conoces. «c'è» suena «che»: KO-sa che DEN-tro.", "register": "neutral", "situation": "bar" },
    { "id": "food.e-piccante", "text": "È piccante?", "es": "¿Pica?", "explanation": "Pregúntalo antes de pedir algo con guindilla o salsa. Marca la doble «c»: pik-KAN-te.", "register": "neutral", "situation": "bar" },
    { "id": "food.me-la-riscalda", "text": "Me la riscalda, per favore?", "es": "¿Me la calienta, por favor?", "explanation": "En el bar, cuando pides una arancina o un trozo de pizza de la vitrina. «sca» es «ska»: ri-SKAL-da.", "register": "lei", "situation": "bar" },
    { "id": "food.da-portare-via", "text": "Da portare via, grazie.", "es": "Para llevar, gracias.", "explanation": "Cuando pides algo para comer por la calle o en la playa. Acento en «ta»: por-TA-re VI-a.", "register": "neutral", "situation": "bar" },
    { "id": "food.mangio-qui", "text": "Mangio qui, grazie.", "es": "Me lo como aquí, gracias.", "explanation": "Cuando te preguntan si es para llevar y te quedas. «gio» suena «dyo» y «qui» es «kui»: MAN-dyo KUI.", "register": "neutral", "situation": "bar" },
    { "id": "food.un-pezzo-di-sfincione", "text": "Un pezzo di sfincione, per favore.", "es": "Un trozo de sfincione, por favor.", "explanation": "En panaderías y puestos callejeros de Palermo. «zz» suena «ts» larga y «cio» «cho»: PET-tso di sfin-CHO-ne.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.panino-con-panelle", "text": "Un panino con panelle e crocchè.", "es": "Un bocadillo de panelle y croquetas.", "notes": "El bocadillo callejero de Palermo: buñuelos de garbanzo y croquetas de patata.", "explanation": "En los puestos callejeros de Palermo, para comer barato. Doble «l»: pa-NEL-le; «crocchè» con acento final: krok-KE.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },

    { "id": "food.bottiglietta-d-acqua", "text": "Una bottiglietta d'acqua naturale, per favore.", "es": "Una botellita de agua sin gas, por favor.", "explanation": "En un bar o un quiosco cuando tienes sed paseando. «glie» suena como una «ll» suave: bot-ti-LLET-ta.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.frizzante-o-naturale", "text": "Frizzante o naturale?", "es": "¿Con gas o sin gas?", "explanation": "Te lo preguntará el camarero al pedir agua. «zz» suena «dz» larga: frid-DZAN-te.", "register": "neutral", "situation": "restaurante", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.birra-piccola", "text": "Una birra piccola, per favore.", "es": "Una caña, por favor.", "literal": "Una cerveza pequeña, por favor.", "explanation": "En un bar o una pizzería si quieres una cerveza pequeña. Marca las dobles: BIR-ra PIK-ko-la.", "register": "neutral", "situation": "bar", "tags": ["pedir"] },
    { "id": "food.mezzo-litro-di-vino", "text": "Mezzo litro di vino rosso della casa.", "es": "Medio litro de vino tinto de la casa.", "notes": "El vino de la casa se pide en jarras de cuarto, medio o un litro.", "explanation": "En una trattoria, para acompañar la comida sin pedir botella. «zz» suena «dz»: MED-dzo LI-tro.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "food.bicchiere-di-bianco", "text": "Un bicchiere di vino bianco, per favore.", "es": "Una copa de vino blanco, por favor.", "explanation": "En un bar o restaurante, para tomar solo una copa. «cchie» suena «kie»: bik-KIE-re.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "food.salute", "text": "Salute!", "es": "¡Salud!", "notes": "También oirás «Cin cin!».", "explanation": "Al brindar con amigos o con quien te invite. Acento en «lu»: sa-LU-te.", "register": "neutral", "situation": "restaurante" },

    { "id": "food.tavolo-per-due", "text": "Un tavolo per due, per favore.", "es": "Una mesa para dos, por favor.", "explanation": "Al entrar en un restaurante sin reserva. Acento en «ta»: TA-vo-lo per DU-e.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.c-e-un-tavolo-libero", "text": "C'è un tavolo libero?", "es": "¿Hay alguna mesa libre?", "explanation": "Al llegar a un restaurante o una terraza sin reserva. «c'è» suena «che»; acento en «li»: LI-be-ro.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.ho-prenotato", "text": "Ho prenotato per le nove.", "es": "He reservado para las nueve.", "notes": "En Sicilia se cena tarde: a las 21 h es lo normal.", "explanation": "Al llegar al restaurante donde reservaste. La «h» es muda: o pre-no-TA-to.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.dentro-o-fuori", "text": "Dentro o fuori?", "es": "¿Dentro o fuera?", "explanation": "Te lo preguntará el camarero al llegar. «fuo» es una sola sílaba: FUO-ri.", "register": "neutral", "situation": "restaurante", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.possiamo-sederci-fuori", "text": "Possiamo sederci fuori?", "es": "¿Podemos sentarnos fuera?", "explanation": "Pídelo al llegar si quieres terraza. «ci» suena «chi»: se-DER-chi FUO-ri.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.ci-porta-il-menu", "text": "Ci porta il menù, per favore?", "es": "¿Nos trae la carta, por favor?", "explanation": "Para pedir la carta al camarero cuando ya estás sentado. «menù» lleva acento final: me-NU.", "register": "lei", "situation": "restaurante" },
    { "id": "food.un-altra-forchetta", "text": "Mi porta un'altra forchetta, per favore?", "es": "¿Me trae otro tenedor, por favor?", "explanation": "Al camarero si se te cae un cubierto o falta uno. «che» suena «ke» y marca la doble «t»: for-KET-ta.", "register": "lei", "situation": "restaurante" },
    { "id": "food.buon-appetito", "text": "Buon appetito!", "es": "¡Que aproveche!", "explanation": "Se lo dices a tus compañeros de mesa, o te lo dice el camarero al servir. Doble «p» y doble «t»: ap-pe-TI-to.", "register": "neutral", "situation": "restaurante" },

    { "id": "food.ha-deciso", "text": "Ha già deciso?", "es": "¿Ya ha decidido?", "explanation": "Te lo preguntará el camarero cuando venga a tomar nota. La «h» es muda y «ci» suena «chi»: a de-CHI-so.", "register": "lei", "situation": "restaurante", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.non-ancora", "text": "Non ancora, un attimo.", "es": "Todavía no, un momento.", "explanation": "Cuando el camarero viene y aún estás mirando la carta. Acento en «co»: an-KO-ra.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.cosa-ci-consiglia", "text": "Cosa ci consiglia?", "es": "¿Qué nos recomienda?", "explanation": "Al camarero si no sabes qué pedir, sobre todo en una trattoria. «glia» suena como una «ll» suave: kon-SI-lla.", "register": "lei", "situation": "restaurante" },
    { "id": "food.specialita", "text": "Qual è la specialità della casa?", "es": "¿Cuál es la especialidad de la casa?", "explanation": "Pregúntalo en una trattoria para probar lo típico. «cia» suena «cha» y el acento va al final: spe-cha-li-TA.", "register": "neutral", "situation": "restaurante" },
    { "id": "food.antipasto-da-dividere", "text": "Un antipasto da dividere, per favore.", "es": "Un entrante para compartir, por favor.", "explanation": "Al pedir algo para picar entre todos. Acento en «vi»: di-VI-de-re.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "food.per-me-la-norma", "text": "Per me la pasta alla Norma.", "es": "Para mí, la pasta alla Norma.", "notes": "Pasta de Catania con berenjena frita, tomate y ricotta salada.", "explanation": "Al pedir, para decir lo que quieres tú. Acento en «nor»: la NOR-ma.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "food.come-primo", "text": "Come primo, la pasta con le sarde.", "es": "De primero, la pasta con sardinas.", "notes": "Clásico de Palermo: sardinas, hinojo silvestre, pasas y piñones.", "explanation": "Al pedir el plato de pasta en la trattoria. Acento en «pri» y en «sar»: KO-me PRI-mo, le SAR-de.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },
    { "id": "food.come-secondo", "text": "Come secondo, il pesce spada.", "es": "De segundo, el pez espada.", "explanation": "Al pedir el plato de carne o pescado. Acento en «con»: se-KON-do; y en «spa»: SPA-da.", "register": "neutral", "situation": "restaurante", "tags": ["pedir"] },

    { "id": "food.allergico-frutta-secca", "text": "Sono allergico alla frutta secca.", "es": "Soy alérgico a los frutos secos.", "notes": "Ojo: pistacho y almendra están en muchísimos dulces sicilianos.", "explanation": "Díselo al camarero antes de pedir, sobre todo con dulces y pesto. «gi» suena «dyi»: al-LER-dyi-ko; y marca la doble «c»: SEK-ka.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.sono-celiaco", "text": "Sono celiaco.", "es": "Soy celíaco.", "explanation": "Díselo al camarero al pedir. «ce» suena «che»: che-LI-a-ko.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.senza-glutine", "text": "Ci sono piatti senza glutine?", "es": "¿Hay platos sin gluten?", "notes": "Italia está muy preparada: busca «senza glutine».", "explanation": "Pregúntalo al sentarte o al pedir la carta. «senza» suena «SEN-tsa»; «glutine» lleva el acento en «glu»: GLU-ti-ne.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.intollerante-lattosio", "text": "Sono intollerante al lattosio.", "es": "Soy intolerante a la lactosa.", "explanation": "Díselo al camarero o en la heladería. Marca las dobles: in-tol-le-RAN-te al lat-TO-sio.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.sono-vegetariano", "text": "Sono vegetariano.", "es": "Soy vegetariano.", "explanation": "Díselo al camarero al pedir o al preguntar por un plato. «ge» suena «dye»: ve-dye-ta-RIA-no.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.contiene-frutti-di-mare", "text": "Questo piatto contiene frutti di mare?", "es": "¿Este plato lleva marisco?", "explanation": "Pregúntalo si tienes alergia o no te gusta el marisco. «tie» es una sola sílaba: kon-TIE-ne.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },
    { "id": "food.senza-cipolla", "text": "Senza cipolla, per favore.", "es": "Sin cebolla, por favor.", "explanation": "Al pedir un bocadillo o un plato si no quieres cebolla. «ci» suena «chi»: chi-POL-la.", "register": "neutral", "situation": "restaurante", "tags": ["alergias"] },

    { "id": "food.dolce-o-caffe", "text": "Un dolce? Un caffè?", "es": "¿Algún postre? ¿Un café?", "explanation": "Te lo preguntará el camarero al terminar el segundo. «ce» suena «che»: DOL-che.", "register": "neutral", "situation": "restaurante", "tags": ["escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.il-conto", "text": "Il conto, per favore.", "es": "La cuenta, por favor.", "explanation": "Al camarero cuando quieres pagar: en Italia no te la traen hasta que la pides. Acento en «con»: il KON-to.", "register": "neutral", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.ci-porta-il-conto", "text": "Ci porta il conto, per favore?", "es": "¿Nos trae la cuenta, por favor?", "explanation": "Versión educada para pedir la cuenta desde la mesa. «ci» suena «chi»: chi POR-ta il KON-to.", "register": "lei", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.cos-e-il-coperto", "text": "Cos'è il coperto?", "es": "¿Qué es el «coperto»?", "explanation": "Pregúntalo si ves un cargo fijo en la cuenta. Acento en «per»: ko-PER-to.", "register": "neutral", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.il-coperto-e", "text": "Il coperto è due euro a persona.", "es": "El cubierto son dos euros por persona.", "explanation": "Te lo explicará el camarero o lo verás en la carta. Acento en «per»: il ko-PER-to.", "register": "neutral", "situation": "restaurante", "tags": ["pagar", "escuchar"], "voice": "it-IT-DiegoNeural" },
    { "id": "food.servizio-incluso", "text": "Il servizio è incluso?", "es": "¿El servicio está incluido?", "explanation": "Pregúntalo antes de dejar propina. «zio» suena «tsio»: ser-VI-tsio.", "register": "neutral", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.pagare-separatamente", "text": "Possiamo pagare separatamente?", "es": "¿Podemos pagar por separado?", "explanation": "Al pedir la cuenta en grupo, si cada uno paga lo suyo. Acento en «men»: se-pa-ra-ta-MEN-te.", "register": "neutral", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.alla-romana", "text": "Facciamo alla romana?", "es": "¿Pagamos a escote?", "notes": "Dividir la cuenta a partes iguales, sin mirar qué ha tomado cada uno.", "explanation": "Propónselo a tus amigos al llegar la cuenta. Acento en «ma»: al-la ro-MA-na.", "register": "neutral", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.tenga-il-resto", "text": "Tenga il resto.", "es": "Quédese con la vuelta.", "explanation": "Al pagar en un bar o un taxi, para dejar la vuelta como propina. Acento en «ten»: TEN-ga il RE-sto.", "register": "lei", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.c-e-un-errore", "text": "Scusi, credo che ci sia un errore nel conto.", "es": "Perdone, creo que hay un error en la cuenta.", "explanation": "Con educación al camarero si la cuenta no cuadra. Marca la doble «r»: er-RO-re.", "register": "lei", "situation": "restaurante", "tags": ["pagar"] },
    { "id": "food.era-tutto-buonissimo", "text": "Era tutto buonissimo, grazie!", "es": "¡Estaba todo buenísimo, gracias!", "explanation": "Al despedirte del camarero o del cocinero. Marca las dobles: TUT-to buo-NIS-si-mo.", "register": "neutral", "situation": "restaurante" }
