    { "id": "sic.assai", "text": "Grazie assai!", "es": "¡Muchas gracias!", "variety": "Siciliano", "standard": "Grazie mille!", "notes": "«Assai» = mucho; lo oirás también en italiano del sur.", "tags": ["siciliano"] },
    { "id": "sic.chi-fu", "text": "Chi fu?", "es": "¿Qué ha pasado?", "variety": "Siciliano", "standard": "Cos'è successo?", "tags": ["siciliano"], "voice": "it-IT-DiegoNeural" }
  ]
