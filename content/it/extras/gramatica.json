    {
      "id": "gram.avere",
      "title": "Avere (tener / haber)",
      "summary": "«Avere» es tener. Como en español, el hambre, la sed, el calor y el frío se «tienen»: «ho fame», «ho caldo».",
      "points": [
        "La «h» nunca suena: «ho» se dice «o».",
        "También forma el pasado: «ho capito», «ho perso il treno».",
        "«Ce l'ho» = lo tengo; «Ce l'ha?» = ¿lo tiene?",
        "La edad va con «avere»: «Ho trent'anni»."
      ],
      "table": [
        ["persona", "avere", "español"],
        ["io", "ho", "tengo / he"],
        ["tu", "hai", "tienes / has"],
        ["lui / lei / Lei", "ha", "tiene / ha"],
        ["noi", "abbiamo", "tenemos / hemos"],
        ["voi", "avete", "tenéis / habéis"],
        ["loro", "hanno", "tienen / han"]
      ],
      "examples": [
        { "text": "Ho fame.", "es": "Tengo hambre." },
        { "text": "Ha spiccioli?", "es": "¿Tiene suelto?" },
        { "text": "Ho perso il treno.", "es": "He perdido el tren." }
      ],
