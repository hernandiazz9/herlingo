  "phrases": [
    {
      "id": "a2-about-me.hi-im-hernan",
      "text": "Hi, I'm Hernán.",
      "es": "Hola, soy Hernán.",
      "notes": "Cambia el nombre por el tuyo.",
      "explanation": "La forma más habitual de presentarte cara a cara. «I'm» es una sola sílaba: «aim», con la «m» bien cerrada.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.my-name-is",
      "text": "My name is Hernán.",
      "es": "Me llamo Hernán.",
      "literal": "Mi nombre es Hernán.",
      "explanation": "Un poco más formal que «I'm…»: en clase, en el trabajo o al teléfono. «name» suena «neim», con «m» final clara.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.whats-your-name",
      "text": "What's your name?",
      "es": "¿Cómo te llamas?",
      "explanation": "Para preguntar el nombre a alguien que acabas de conocer. «What's» une la «t» y la «s»: «uats».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.may-i-have-your-name",
      "text": "May I have your name, please?",
      "es": "¿Me dice su nombre, por favor?",
      "explanation": "Lo oirás en recepciones, hoteles y consultas. «May I» va unido: «mei-ai».",
      "register": "formal",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.my-last-name-is",
      "text": "My last name is Díaz.",
      "es": "Mi apellido es Díaz.",
      "explanation": "En formularios, hoteles o por teléfono. «last» lleva una «a» abierta y la «t» casi no suena: «las-NEIM».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.how-do-you-spell-that",
      "text": "How do you spell that?",
      "es": "¿Cómo se escribe?",
      "explanation": "Cuando un nombre no te suena y necesitas escribirlo. «spell» empieza directamente: «spel», nunca «espel».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.its-spelled",
      "text": "It's D-I-A-Z.",
      "es": "Se escribe D-I-A-Z.",
      "notes": "Practica tu nombre y apellido letra a letra.",
      "explanation": "Para deletrear. Ojo con las letras: la I se dice «ai», la A «ei»; la Z es «zii», con una «z» zumbante, como una abeja.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.nice-to-meet-you",
      "text": "Nice to meet you.",
      "es": "Encantado de conocerte.",
      "explanation": "Justo después de presentarte. «meet» lleva una «i» larga: «miit», no «mit».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.nice-to-meet-you-too",
      "text": "Nice to meet you, too.",
      "es": "Igualmente.",
      "literal": "Encantado de conocerte también.",
      "explanation": "La respuesta a «Nice to meet you». «too» es una «u» larga: «tuu».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.its-a-pleasure",
      "text": "It's a pleasure to meet you.",
      "es": "Es un placer conocerle.",
      "explanation": "En una reunión de trabajo o con alguien mayor. En «pleasure» la «s» suena como la «ll» argentina: «PLE-zher».",
      "register": "formal",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.where-are-you-from",
      "text": "Where are you from?",
      "es": "¿De dónde eres?",
      "explanation": "La pregunta típica al conocer a alguien. «from» lleva una «o» corta, casi «a», y «m» final: «fram».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.im-from-spain",
      "text": "I'm from Spain.",
      "es": "Soy de España.",
      "explanation": "La respuesta más natural. «Spain» sin «e» delante: «spein», nunca «espein».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.im-spanish",
      "text": "I'm Spanish.",
      "es": "Soy español.",
      "notes": "Nacionalidad con mayúscula: Spanish, American, French.",
      "explanation": "Para decir tu nacionalidad. Las nacionalidades van con mayúscula. «Spanish» empieza con «sp» directo: «SPA-nish».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "a2-about-me.im-from-madrid",
      "text": "I'm from Madrid.",
      "es": "Soy de Madrid.",
      "explanation": "Cuando te preguntan la ciudad. Los americanos dicen «ma-DRID» con su «r» suave, sin vibrar.",
