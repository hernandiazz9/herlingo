    {"id": "a2-shopping.qa.need-a-bag", "question": "Do you need a bag?", "questionEs": "¿Necesita bolsa?", "accepted": [{"text": "No, thanks. I have my own bag.", "es": "No, gracias. Llevo mi propia bolsa."}, {"text": "Yes, please.", "es": "Sí, por favor."}], "distractors": [{"text": "It's in my bag.", "es": "Está en mi bolsa."}, {"text": "Yes, a big size.", "es": "Sí, una talla grande."}], "register": "neutral", "situation": "compras", "notes": "Di si quieres bolsa; muchas tiendas la cobran.", "voice": "en-US-BrianNeural"},
