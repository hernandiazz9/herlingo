  "phrases": [
    {"id": "a2-shopping.where-can-i-find-the-milk", "text": "Excuse me, where can I find the milk?", "es": "Perdona, ¿dónde está la leche?", "explanation": "A un empleado del súper. «find» suena FAIND, con la «d» final clara.", "register": "neutral", "situation": "compras", "tags": ["supermercado"]},
    {"id": "a2-shopping.which-aisle", "text": "Which aisle is the rice in?", "es": "¿En qué pasillo está el arroz?", "explanation": "Los pasillos van numerados. «aisle» suena AIL: la «s» no se pronuncia.", "register": "neutral", "situation": "compras", "tags": ["supermercado"]},
    {"id": "a2-shopping.any-fresh-bread", "text": "Do you have any fresh bread?", "es": "¿Tenéis pan del día?", "explanation": "Para preguntar si queda algo. «fresh» acaba en «sh»: FRESH.", "register": "neutral", "situation": "compras", "tags": ["supermercado"]},
    {"id": "a2-shopping.is-this-on-sale", "text": "Is this on sale?", "es": "¿Esto está de oferta?", "explanation": "Mirando un cartel o una etiqueta de color. «sale» suena SEIL, con «ei».", "register": "neutral", "situation": "compras", "tags": ["supermercado", "precios"]},
    {"id": "a2-shopping.buy-one-get-one-free", "text": "It's buy one, get one free.", "es": "Es un dos por uno.", "notes": "En los carteles aparece como «BOGO».", "explanation": "Lo oyes o lo lees en las ofertas. Se dice seguido: bai-WAN-get-wan-FRII.", "register": "neutral", "situation": "compras", "tags": ["supermercado", "precios"]},
    {"id": "a2-shopping.how-much-per-pound", "text": "How much is it per pound?", "es": "¿Cuánto cuesta la libra?", "notes": "Una libra son unos 450 gramos.", "explanation": "En la fruta y la carne el precio va por libra (lb). «pound» suena PAUND.", "register": "neutral", "situation": "compras", "tags": ["supermercado", "precios"]},
    {"id": "a2-shopping.a-dozen-eggs", "text": "I need a dozen eggs.", "es": "Necesito una docena de huevos.", "explanation": "Los huevos se venden por docenas. «dozen» suena DA-zən, con «z» sonora.", "register": "neutral", "situation": "compras", "tags": ["supermercado"]},
    {"id": "a2-shopping.is-this-register-open", "text": "Is this register open?", "es": "¿Está abierta esta caja?", "explanation": "Antes de ponerte en una caja. «register» se acentúa al principio: RE-jis-tər.", "register": "neutral", "situation": "compras", "tags": ["pagar"]},
    {"id": "a2-shopping.no-bag-thanks", "text": "No bag, thanks.", "es": "Sin bolsa, gracias.", "explanation": "Muchas tiendas cobran las bolsas. «bag» con «a» abierta: BÆG.", "register": "neutral", "situation": "compras", "tags": ["pagar"]},
    {"id": "a2-shopping.i-have-my-own-bag", "text": "I have my own bag.", "es": "Llevo mi propia bolsa.", "explanation": "Para no pagar bolsa. «own» suena OUN, con «ou».", "register": "neutral", "situation": "compras", "tags": ["pagar"]},
    {"id": "a2-shopping.can-i-just-tap", "text": "Can I just tap my card?", "es": "¿Puedo pagar sin contacto?", "explanation": "Para pagar acercando la tarjeta o el móvil. «tap» con «a» abierta: TÆP.", "register": "neutral", "situation": "compras", "tags": ["pagar"]},
    {"id": "a2-shopping.i-have-a-coupon", "text": "I have a coupon.", "es": "Tengo un cupón.", "explanation": "Dalo antes de pagar. «coupon» suena KU-pan o KIU-pan: las dos valen.", "register": "neutral", "situation": "compras", "tags": ["pagar", "precios"]},
    {"id": "a2-shopping.self-checkout-isnt-working", "text": "The self-checkout isn't working.", "es": "La caja de autoservicio no funciona.", "explanation": "Para llamar a un empleado. «isn't» suena I-zənt.", "register": "neutral", "situation": "compras", "tags": ["pagar", "problemas"]},
    {"id": "a2-shopping.price-is-wrong", "text": "Sorry, I think the price is wrong.", "es": "Perdona, creo que el precio está mal.", "explanation": "Si en caja te cobran más de lo que ponía. «think» con «th»: THINK, no «tink».", "register": "neutral", "situation": "compras", "tags": ["pagar", "precios"]},
    {"id": "a2-shopping.im-just-looking", "text": "I'm just looking, thanks.", "es": "Solo estoy mirando, gracias.", "explanation": "Cuando un dependiente te ofrece ayuda. «looking» lleva «u» corta: LU-king.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.looking-for-a-jacket", "text": "I'm looking for a winter jacket.", "es": "Busco una chaqueta de invierno.", "explanation": "Para decir qué buscas. «jacket» suena JÆ-kit.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.this-in-blue", "text": "Do you have this in blue?", "es": "¿Tienes esto en azul?", "explanation": "Para pedir otro color. «blue» suena BLUU, con «u» larga.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.this-in-a-medium", "text": "Do you have this in a medium?", "es": "¿Lo tienes en una M?", "notes": "Tallas: small, medium, large (S, M, L).", "explanation": "Para pedir tu talla. «medium» suena MII-di-əm.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.what-size-is-this", "text": "What size is this?", "es": "¿Qué talla es esta?", "explanation": "Si la etiqueta no está clara. «size» acaba en «z» sonora: SAIZ.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.how-much-are-these-jeans", "text": "How much are these jeans?", "es": "¿Cuánto cuestan estos vaqueros?", "explanation": "«jeans» es plural: «are these», no «is this». Suena YIINZ, con «i» larga.", "register": "neutral", "situation": "compras", "tags": ["ropa", "precios"]},
    {"id": "a2-shopping.i-like-this-color", "text": "I really like this color.", "es": "Me gusta mucho este color.", "explanation": "Al ver algo que te gusta. «color» suena KA-lər, con «a» corta.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.can-i-try-this-on", "text": "Can I try this on?", "es": "¿Me lo puedo probar?", "explanation": "Con la prenda en la mano, al dependiente. Se dice seguido: TRAI-ðis-AN.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.where-are-the-fitting-rooms", "text": "Where are the fitting rooms?", "es": "¿Dónde están los probadores?", "explanation": "«fitting» lleva la «t» americana suave, como «r»: FI-ring.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.its-too-small", "text": "It's too small.", "es": "Me queda pequeño.", "explanation": "Al salir del probador. «too» suena TUU, larga.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.its-a-little-big", "text": "It's a little too big.", "es": "Me queda un poco grande.", "explanation": "Si te sobra talla. «big» lleva «i» corta: BIG.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.a-bigger-size", "text": "Do you have a bigger size?", "es": "¿Tienes una talla más grande?", "explanation": "Para pedir otra talla. «bigger» suena BI-gər.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.a-smaller-size", "text": "Could I try a smaller size?", "es": "¿Podría probarme una talla más pequeña?", "explanation": "Pidiendo otra talla con educación. «smaller» sin «e» delante: SMO-lər.", "register": "formal", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.it-fits-perfectly", "text": "It fits perfectly.", "es": "Me queda perfecto.", "explanation": "Si la talla es la buena. «fits» acaba en «ts» clara: FITS.", "register": "neutral", "situation": "compras", "tags": ["ropa", "tallas"]},
    {"id": "a2-shopping.how-does-it-look", "text": "How does it look?", "es": "¿Qué tal me queda?", "explanation": "Se lo preguntas a quien te acompaña. «look» lleva «u» corta: LUK.", "register": "tu", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.looks-great-on-you", "text": "That looks great on you!", "es": "¡Te queda genial!", "explanation": "Para decírselo a un amigo en el probador. «great» suena GREIT.", "register": "tu", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.ill-take-it", "text": "I'll take it.", "es": "Me lo llevo.", "explanation": "Para decir que lo compras. «I'll» suena AIL, en una sílaba.", "register": "neutral", "situation": "compras", "tags": ["ropa", "pagar"]},
    {"id": "a2-shopping.ill-think-about-it", "text": "I'll think about it, thanks.", "es": "Me lo pienso, gracias.", "explanation": "Para irte sin comprar, con educación. «think» con «th»: THINK.", "register": "neutral", "situation": "compras", "tags": ["ropa"]},
    {"id": "a2-shopping.id-like-to-return-this", "text": "I'd like to return this, please.", "es": "Quería devolver esto, por favor.", "explanation": "En la caja o en el mostrador de devoluciones. «return» se acentúa al final: ri-TERN.", "register": "formal", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.can-i-exchange-this", "text": "Can I exchange this for a smaller size?", "es": "¿Puedo cambiar esto por una talla más pequeña?", "explanation": "Si prefieres otra talla en vez del dinero. «exchange» suena iks-CHEINCH.", "register": "neutral", "situation": "compras", "tags": ["devoluciones", "tallas"]},
    {"id": "a2-shopping.it-doesnt-fit", "text": "It doesn't fit.", "es": "No me queda bien.", "explanation": "La razón más común para devolver ropa. «doesn't» suena DA-zənt.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.it-has-a-hole", "text": "It has a hole in it.", "es": "Tiene un agujero.", "explanation": "Si la prenda tiene un defecto. «hole» suena JOUL, con «h» aspirada.", "register": "neutral", "situation": "compras", "tags": ["devoluciones", "problemas"]},
    {"id": "a2-shopping.heres-the-receipt", "text": "Here's the receipt.", "es": "Aquí tiene el tíquet.", "explanation": "Suelen pedírtelo para devolver algo. «receipt» suena ri-SIIT: la «p» no se pronuncia.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.i-dont-have-the-receipt", "text": "I don't have the receipt.", "es": "No tengo el tíquet.", "explanation": "Sin tíquet a veces solo te dan saldo para la tienda. «don't» suena DOUNT.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.can-i-get-a-refund", "text": "Can I get a refund?", "es": "¿Me pueden devolver el dinero?", "explanation": "Para recuperar el dinero, no un cambio. «refund» se acentúa al principio: RI-fand.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.it-was-a-gift", "text": "It was a gift.", "es": "Fue un regalo.", "explanation": "Si devuelves algo que te regalaron. «gift» con «g» fuerte: GIFT.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.whats-your-return-policy", "text": "What's your return policy?", "es": "¿Cuál es vuestra política de devoluciones?", "notes": "Muchas tiendas aceptan devoluciones durante 30 días con el tíquet.", "explanation": "Antes de comprar algo caro. «policy» suena PA-lə-si.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]},
    {"id": "a2-shopping.i-havent-worn-it", "text": "I haven't worn it.", "es": "No me lo he puesto.", "explanation": "Para dejar claro que está nuevo. «worn» suena UORN, con la «r» americana.", "register": "neutral", "situation": "compras", "tags": ["devoluciones"]}
  ],
