  "phrases": [
    {
      "id": "a2-daily.i-live-in-an-apartment",
      "text": "I live in an apartment downtown.",
      "es": "Vivo en un piso en el centro.",
      "notes": "«downtown» = en el centro de la ciudad, sin «in».",
      "explanation": "«apartment» es lo americano («flat» es británico). Acento en la segunda: a-PART-ment.",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.it-has-two-bedrooms",
      "text": "It has two bedrooms and one bathroom.",
      "es": "Tiene dos dormitorios y un baño.",
      "explanation": "Para describir un piso. «bedrooms» con la «d» unida: «BED-rumz».",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.the-kitchen-is-pretty-small",
      "text": "The kitchen is pretty small.",
      "es": "La cocina es bastante pequeña.",
      "explanation": "«pretty» delante de un adjetivo = bastante. Las «tt» suenan como una «r» suave: «PRI-ri».",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.theres-a-balcony",
      "text": "There's a balcony with a view.",
      "es": "Hay un balcón con vistas.",
      "explanation": "«There's» = «there is» (hay). Pon la lengua entre los dientes, como una «d» suave: «dherz».",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.i-live-alone",
      "text": "I live alone.",
      "es": "Vivo solo.",
      "explanation": "Para decir que vives solo. «alone» se acentúa en la segunda: a-LOUN.",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.i-have-a-roommate",
      "text": "I have a roommate.",
      "es": "Comparto piso.",
      "literal": "Tengo un compañero de piso.",
      "explanation": "Para decir que compartes piso. «roommate» une «room» y «mate»: «RUUM-meit».",
      "register": "neutral",
      "situation": "casa"
    },
    {
      "id": "a2-daily.come-on-in",
      "text": "Come on in!",
      "es": "¡Pasa, pasa!",
      "explanation": "Al recibir a alguien en casa. Todo va unido: «ka-mo-NIN».",
      "register": "tu",
      "situation": "casa"
    },
    {
      "id": "a2-daily.wheres-the-bathroom",
      "text": "Where's the bathroom?",
      "es": "¿Dónde está el baño?",
