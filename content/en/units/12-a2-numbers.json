  "phrases": [
    { "id": "a2-numbers.table-for-two", "text": "Table for two, please.", "es": "Una mesa para dos, por favor.", "notes": "En EE. UU. esperas en la entrada a que te sienten.", "explanation": "Al host que te recibe en la entrada del restaurante. «two» suena igual que «too»: TEI-bəl fər TUU.", "register": "neutral", "situation": "numeros", "tags": ["numero", "restaurante"] },
    { "id": "a2-numbers.thirteen-or-thirty", "text": "Sorry, did you say thirteen or thirty?", "es": "Perdona, ¿has dicho trece o treinta?", "notes": "En «-teen» el acento va al final; en «-ty», al principio.", "explanation": "Cuando dudas con un precio o un número de puerta. Marca el acento: thir-TIIN frente a THIR-ri, con «th» entre los dientes.", "register": "neutral", "situation": "numeros", "tags": ["numero"] },
    { "id": "a2-numbers.how-old-are-you", "text": "How old are you?", "es": "¿Cuántos años tienes?", "notes": "No se pregunta a desconocidos ni en el trabajo.", "explanation": "A un amigo, a un niño o en un formulario. «old» lleva una «o» que acaba en «u»: jau OULD ar-yu?", "register": "neutral", "situation": "numeros", "tags": ["edad"] },
    { "id": "a2-numbers.im-thirty-two", "text": "I'm thirty-two.", "es": "Tengo treinta y dos años.", "literal": "Soy treinta y dos.", "notes": "La edad va con «be»: «I'm thirty-two», nunca «I have thirty-two».", "explanation": "Para decir tu edad. «th» con la lengua entre los dientes, y la «t» de «thirty» suave, casi «r»: aim THIR-ri TUU.", "register": "neutral", "situation": "numeros", "tags": ["edad"] },
    { "id": "a2-numbers.born-in", "text": "I was born in nineteen ninety-four.", "es": "Nací en 1994.", "notes": "Los años se dicen de dos en dos: 1994 = «nineteen ninety-four»; 2026 = «twenty twenty-six».", "explanation": "Cuando te preguntan el año en que naciste. «born» con «r» americana: ai-wəz BORN in.", "register": "neutral", "situation": "numeros", "tags": ["edad", "fecha"] },
    { "id": "a2-numbers.whats-your-number", "text": "What's your phone number?", "es": "¿Cuál es tu número de teléfono?", "explanation": "Al pedir el teléfono a alguien o cuando te lo piden en una tienda. «phone» suena FOUN: wats-yər FOUN NAM-bər?", "register": "neutral", "situation": "numeros", "tags": ["telefono"] },
    { "id": "a2-numbers.my-number-is", "text": "It's three one two, five five five, oh one four seven.", "es": "Es el 312 555 0147.", "notes": "Se dice cifra a cifra en grupos de 3, 3 y 4; el cero se suele decir «oh».", "explanation": "Al dar tu teléfono, con una pausa entre los grupos. El cero se dice «ou», como la letra O.", "register": "neutral", "situation": "numeros", "tags": ["telefono"] },
    { "id": "a2-numbers.how-much-is-it", "text": "How much is it?", "es": "¿Cuánto es? / ¿Cuánto cuesta?", "explanation": "Señalando algo en una tienda o en un mercadillo. «much» lleva una «a» corta y oscura: jau MACH iz-it?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "a2-numbers.thats-three-fifty", "text": "That's three fifty.", "es": "Son 3,50 dólares.", "notes": "Los precios se dicen sin «dollars» ni «cents»: $3.50 = «three fifty».", "explanation": "Lo que te dice el cajero al cobrar. «fifty» lleva el acento al principio: ðæts THRII FIF-ti.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "precio"] },
    { "id": "a2-numbers.nineteen-ninety-nine", "text": "It's nineteen ninety-nine.", "es": "Cuesta 19,99 dólares.", "notes": "$19.99 = «nineteen ninety-nine». En EE. UU. los decimales llevan punto, no coma.", "explanation": "Cuando te dicen el precio de algo. Distingue «nine-TEEN» (19) de «NINE-ty» (90) por el acento.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "precio"] },
    { "id": "a2-numbers.is-tax-included", "text": "Is tax included?", "es": "¿Va incluido el impuesto?", "notes": "En EE. UU. el precio de la etiqueta casi nunca incluye el impuesto: se suma en caja.", "explanation": "Cuando el total en caja es más alto que la etiqueta. «tax» con «a» abierta y acento final en «included»: in-KLUU-did.", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "a2-numbers.can-i-pay-by-card", "text": "Can I pay by card?", "es": "¿Puedo pagar con tarjeta?", "notes": "«by card» o «with a card»; nunca «in card».", "explanation": "Antes de pagar en un taxi, un puesto o un bar pequeño. «can» es débil, «kən»: kən-ai PEI bai KARD?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "a2-numbers.do-you-take-cash", "text": "Do you take cash?", "es": "¿Aceptáis efectivo?", "notes": "Algunos sitios en EE. UU. ya solo aceptan tarjeta («cashless»).", "explanation": "Si quieres pagar en billetes. «cash» con «a» abierta, entre «a» y «e»: dyu teik KÆSH?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "a2-numbers.twenty-percent-tip", "text": "I'll add a twenty percent tip.", "es": "Añado un veinte por ciento de propina.", "notes": "En restaurantes con camarero se deja entre el 18 y el 20 %; no es opcional en la práctica.", "explanation": "Al pagar en un restaurante o un taxi. «percent» lleva el acento al final: pər-SENT.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "propina"] },
    { "id": "a2-numbers.keep-the-change", "text": "Keep the change.", "es": "Quédese el cambio.", "explanation": "Al pagar en efectivo un taxi o una cuenta pequeña. «change» suena CHEINCH, con «ch» suave al final.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "propina"] },
    { "id": "a2-numbers.what-time-is-it", "text": "What time is it?", "es": "¿Qué hora es?", "explanation": "A un amigo o a cualquiera. «time» con «ai» y «it» muy corto: wət TAIM iz-it?", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.do-you-have-the-time", "text": "Excuse me, do you have the time?", "es": "Perdone, ¿tiene hora?", "notes": "«Do you have time?» (sin «the») significa «¿tienes tiempo?».", "explanation": "A un desconocido por la calle. «the» con «th» suave, como la «d» de «nada»: də TAIM.", "register": "formal", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.its-three-oclock", "text": "It's three o'clock.", "es": "Son las tres.", "explanation": "Para las horas en punto. «o'clock» = ə-KLAK, con acento al final; «three» con «th» entre los dientes.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.its-eight-thirty", "text": "It's eight thirty.", "es": "Son las ocho y media.", "notes": "Lo normal es decir los números: «eight thirty», «six fifteen».", "explanation": "Para dar la hora como se hace en EE. UU. La «t» de «eight» se une a «thirty»: eit-THIR-ri.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.quarter-to-ten", "text": "It's a quarter to ten.", "es": "Son las diez menos cuarto.", "notes": "«a quarter after ten» = las diez y cuarto.", "explanation": "Otra forma de dar la hora, muy común. «quarter» suena KWOR-rər, con la «t» suave.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.its-noon", "text": "It's noon.", "es": "Es mediodía.", "notes": "«noon» = las 12 del mediodía; «midnight» = las 12 de la noche.", "explanation": "Para las doce del mediodía. «noon» con «u» larga: its NUUN.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.what-time-do-you-open", "text": "What time do you open tomorrow?", "es": "¿A qué hora abrís mañana?", "explanation": "En una tienda o un museo. «do you» se une en «dyu»: wət TAIM dyu OU-pən?", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.we-close-at-nine", "text": "We close at nine p.m.", "es": "Cerramos a las nueve de la noche.", "notes": "En EE. UU. se usa el reloj de 12 horas: a.m. (mañana) y p.m. (tarde y noche).", "explanation": "Lo verás en carteles y te lo dirán en tiendas. «close» con «z» sonora: wi KLOUZ ət NAIN pii-EM.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.im-running-late", "text": "Sorry, I'm running late.", "es": "Perdona, llego tarde.", "notes": "Para avisar de que vas con retraso.", "explanation": "En un mensaje o una llamada antes de llegar. «running» con «r» americana: aim RA-ning LEIT.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "a2-numbers.whats-the-date", "text": "What's the date today?", "es": "¿A qué fecha estamos hoy?", "explanation": "Al rellenar un formulario o fechar algo. «date» rima con «eight»: wats ðə DEIT tə-DEI?", "register": "neutral", "situation": "numeros", "tags": ["fecha"] },
    { "id": "a2-numbers.its-october-sixth", "text": "Today is October sixth.", "es": "Hoy es 6 de octubre.", "notes": "En EE. UU. se escribe primero el mes: 10/6 = 6 de octubre.", "explanation": "Para decir la fecha: mes + número ordinal. «sixth» acaba en «ksth», difícil: SIKSTH.", "register": "neutral", "situation": "numeros", "tags": ["fecha"] },
    { "id": "a2-numbers.closed-on-sundays", "text": "We're closed on Sundays.", "es": "Los domingos cerramos.", "notes": "Días de la semana con «on»: «on Monday», «on Sundays».", "explanation": "En carteles y tiendas. «closed» acaba en «zd», sin «e» extra: KLOUZD.", "register": "neutral", "situation": "numeros", "tags": ["fecha"] },
    { "id": "a2-numbers.when-is-your-birthday", "text": "When's your birthday?", "es": "¿Cuándo es tu cumpleaños?", "explanation": "A un amigo o compañero. «birthday» con «th» entre los dientes: BERTH-dei.", "register": "neutral", "situation": "numeros", "tags": ["fecha"] },
    { "id": "a2-numbers.birthday-july-fourth", "text": "My birthday is on July fourth.", "es": "Mi cumpleaños es el 4 de julio.", "notes": "El 4 de julio es la fiesta nacional de EE. UU.", "explanation": "Para decir tu cumpleaños: «on» + mes + ordinal. «July» lleva el acento al final: dʒu-LAI.", "register": "neutral", "situation": "numeros", "tags": ["fecha"] }
  ],
