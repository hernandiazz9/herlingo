    {"id": "a2-hotel.luggage", "word": "luggage", "es": "el equipaje", "notes": "Incontable: «my luggage», nunca «a luggage» ni «luggages».", "situation": "alojamiento", "tags": ["equipaje"], "image": "fluent:luggage"}
