  "qa": [
    {"id": "a2-hotel.qa.your-name", "question": "Hi! Can I have your last name, please?", "questionEs": "¡Hola! ¿Me dice su apellido, por favor?", "accepted": [{"text": "Sure, it's Díaz.", "es": "Claro, es Díaz."}, {"text": "It's Díaz, D-I-A-Z.", "es": "Es Díaz, D-I-A-Z."}], "distractors": [{"text": "I'm good, thanks.", "es": "Bien, gracias."}, {"text": "For three nights.", "es": "Para tres noches."}], "register": "neutral", "situation": "alojamiento", "notes": "Te piden el apellido de la reserva: dilo y, si hace falta, deletréalo.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-hotel.qa.how-many-nights", "question": "How many nights are you staying with us?", "questionEs": "¿Cuántas noches se queda con nosotros?", "accepted": [{"text": "Three nights.", "es": "Tres noches."}, {"text": "Just two nights.", "es": "Solo dos noches."}], "distractors": [{"text": "Room three.", "es": "La habitación tres."}, {"text": "At nine p.m.", "es": "A las nueve de la noche."}], "register": "neutral", "situation": "alojamiento", "notes": "«How many nights» pregunta un número de noches, no una hora.", "voice": "en-US-AndrewNeural"},
    {"id": "a2-hotel.qa.one-bed-or-two", "question": "Would you like a room with one bed or two?", "questionEs": "¿Quiere una habitación con una cama o con dos?", "accepted": [{"text": "One bed, please.", "es": "Una cama, por favor."}, {"text": "Two beds, please.", "es": "Dos camas, por favor."}], "distractors": [{"text": "Two nights, please.", "es": "Dos noches, por favor."}, {"text": "Yes, please.", "es": "Sí, por favor."}], "register": "formal", "situation": "alojamiento", "notes": "Te ofrecen elegir entre dos: responde «one bed» o «two beds», no «yes».", "voice": "en-US-AvaNeural"},
    {"id": "a2-hotel.qa.front-desk", "question": "Front desk, how can I help you?", "questionEs": "Recepción, ¿en qué le puedo ayudar?", "accepted": [{"text": "Hi, could I get some extra towels?", "es": "Hola, ¿me podría dar unas toallas más?"}, {"text": "Hi, what time is breakfast?", "es": "Hola, ¿a qué hora es el desayuno?"}], "distractors": [{"text": "Hi, I'm the front desk.", "es": "Hola, soy la recepción."}, {"text": "I'm fine, and you?", "es": "Bien, ¿y usted?"}], "register": "formal", "situation": "alojamiento", "notes": "Contestan en recepción: saluda y di directamente lo que necesitas.", "voice": "en-US-AvaNeural"},
    {"id": "a2-hotel.qa.anything-else", "question": "Is there anything else I can help you with?", "questionEs": "¿Puedo ayudarle con algo más?", "accepted": [{"text": "No, that's all. Thank you!", "es": "No, eso es todo. ¡Gracias!"}, {"text": "Yes, what's the Wi-Fi password?", "es": "Sí, ¿cuál es la contraseña del wifi?"}], "distractors": [{"text": "You're welcome.", "es": "De nada."}, {"text": "Yes, I'm fine.", "es": "Sí, estoy bien."}], "register": "formal", "situation": "alojamiento", "notes": "Di «That's all, thank you» si no necesitas nada más, o pide otra cosa.", "voice": "en-US-BrianNeural"},
    {"id": "a2-hotel.qa.whats-the-problem", "question": "I'm sorry about that. What seems to be the problem?", "questionEs": "Lo siento. ¿Cuál es el problema?", "accepted": [{"text": "The AC doesn't work.", "es": "El aire acondicionado no funciona."}, {"text": "There's no hot water.", "es": "No hay agua caliente."}], "distractors": [{"text": "It's on the third floor.", "es": "Está en la tercera planta."}, {"text": "No problem, thanks.", "es": "No pasa nada, gracias."}], "register": "formal", "situation": "alojamiento", "notes": "Te piden que expliques el problema: di qué no funciona.", "voice": "en-US-AndrewNeural"},
    {"id": "a2-hotel.qa.different-room", "question": "We can give you a different room. Is that OK?", "questionEs": "Le podemos dar otra habitación. ¿Le parece bien?", "accepted": [{"text": "Yes, that's great. Thank you!", "es": "Sí, genial. ¡Gracias!"}, {"text": "Sure, thanks a lot.", "es": "Claro, muchas gracias."}], "distractors": [{"text": "Yes, it's a different room.", "es": "Sí, es otra habitación."}, {"text": "You're welcome.", "es": "De nada."}], "register": "formal", "situation": "alojamiento", "notes": "Te ofrecen una solución: acéptala y da las gracias.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-hotel.qa.how-was-your-stay", "question": "How was your stay?", "questionEs": "¿Qué tal la estancia?", "accepted": [{"text": "It was great, thank you!", "es": "¡Genial, gracias!"}, {"text": "Really nice, thanks.", "es": "Muy bien, gracias."}], "distractors": [{"text": "I stayed three nights.", "es": "Me quedé tres noches."}, {"text": "Yes, I'm staying.", "es": "Sí, me quedo."}], "register": "neutral", "situation": "alojamiento", "notes": "«How was…?» pide tu opinión: responde «It was great» o «Really nice».", "voice": "en-US-BrianNeural"},
    {"id": "a2-hotel.qa.minibar", "question": "Did you have anything from the minibar?", "questionEs": "¿Tomó algo del minibar?", "accepted": [{"text": "No, nothing.", "es": "No, nada."}, {"text": "Yes, just a bottle of water.", "es": "Sí, solo una botella de agua."}], "distractors": [{"text": "Yes, I'm checking out.", "es": "Sí, hago el check-out."}, {"text": "No, I didn't sleep.", "es": "No, no dormí."}], "register": "formal", "situation": "alojamiento", "notes": "Te preguntan si consumiste algo: «No, nothing» o di qué tomaste.", "voice": "en-US-AvaNeural"}
  ]
