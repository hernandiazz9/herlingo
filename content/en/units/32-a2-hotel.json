    {"id": "a2-hotel.night", "word": "night", "article": "a", "plural": "nights", "es": "la noche", "notes": "«three nights» = tres noches. La «gh» no suena: NAIT.", "example": "a2-hotel.three-nights", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.key-card", "word": "key card", "article": "a", "plural": "key cards", "es": "la tarjeta de la habitación", "notes": "La llave de plástico del hotel.", "situation": "alojamiento", "tags": ["recepcion"], "image": "fluent:key"},
    {"id": "a2-hotel.floor", "word": "floor", "article": "a", "plural": "floors", "es": "la planta / el piso", "notes": "En EE. UU. la planta baja es el «first floor».", "example": "a2-hotel.what-floor", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.elevator", "word": "elevator", "article": "an", "plural": "elevators", "es": "el ascensor", "notes": "En EE. UU. «elevator», no «lift». Acento al principio: E-lə-vei-rər.", "example": "a2-hotel.where-is-the-elevator", "situation": "alojamiento", "tags": ["recepcion"], "image": "fluent:elevator"},
    {"id": "a2-hotel.credit-card", "word": "credit card", "article": "a", "plural": "credit cards", "es": "la tarjeta de crédito", "notes": "En el hotel te la piden para la fianza.", "situation": "alojamiento", "tags": ["recepcion", "pagar"], "image": "fluent:credit-card"},
    {"id": "a2-hotel.bed", "word": "bed", "article": "a", "plural": "beds", "es": "la cama", "notes": "«e» corta y «d» final suave: BED. «bad» (malo) suena distinto.", "example": "a2-hotel.bed-is-comfortable", "situation": "alojamiento", "tags": ["habitacion"], "image": "fluent:bed"},
    {"id": "a2-hotel.pillow", "word": "pillow", "article": "a", "plural": "pillows", "es": "la almohada", "notes": "Suena PI-lou.", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.shower", "word": "shower", "article": "a", "plural": "showers", "es": "la ducha", "notes": "Suena SHAU-ər.", "example": "a2-hotel.how-does-the-shower-work", "situation": "alojamiento", "tags": ["habitacion", "bano"], "image": "fluent:shower"},
    {"id": "a2-hotel.bathtub", "word": "bathtub", "article": "a", "plural": "bathtubs", "es": "la bañera", "notes": "«th» entre los dientes: BATH-tab.", "situation": "alojamiento", "tags": ["habitacion", "bano"], "image": "fluent:bathtub"},
    {"id": "a2-hotel.air-conditioning", "word": "air conditioning", "es": "el aire acondicionado", "notes": "Casi siempre se dice «the AC»: ei-SI.", "example": "a2-hotel.how-do-i-turn-on-the-ac", "situation": "alojamiento", "tags": ["habitacion"], "image": "fluent:snowflake"},
    {"id": "a2-hotel.heat", "word": "heat", "es": "la calefacción", "notes": "En EE. UU. «the heat» es la calefacción. «i» larga: JIIT.", "situation": "alojamiento", "tags": ["habitacion"], "image": "fluent:fire"},
    {"id": "a2-hotel.tv", "word": "TV", "article": "a", "plural": "TVs", "es": "la tele", "notes": "Se deletrea: ti-VI.", "situation": "alojamiento", "tags": ["habitacion"], "image": "fluent:television"},
    {"id": "a2-hotel.light", "word": "light", "article": "a", "plural": "lights", "es": "la luz", "notes": "«turn on / turn off the light» = encender / apagar la luz.", "example": "a2-hotel.where-is-the-light-switch", "situation": "alojamiento", "tags": ["habitacion"], "image": "fluent:light-bulb"},
    {"id": "a2-hotel.wifi", "word": "Wi-Fi", "es": "el wifi", "notes": "Suena UAI-fai.", "example": "a2-hotel.wifi-password", "situation": "alojamiento", "tags": ["pedir"], "image": "fluent:wireless"},
    {"id": "a2-hotel.password", "word": "password", "article": "a", "plural": "passwords", "es": "la contraseña", "notes": "Suena PAS-werd; la «w» no suena.", "example": "a2-hotel.wifi-password", "situation": "alojamiento", "tags": ["pedir"]},
    {"id": "a2-hotel.breakfast", "word": "breakfast", "es": "el desayuno", "notes": "Sin artículo: «Breakfast is at seven». Suena BREK-fəst.", "example": "a2-hotel.what-time-is-breakfast", "situation": "alojamiento", "tags": ["desayuno"], "image": "fluent:croissant"},
    {"id": "a2-hotel.towel", "word": "towel", "article": "a", "plural": "towels", "es": "la toalla", "notes": "Suena TAU-əl.", "example": "a2-hotel.extra-towels", "situation": "alojamiento", "tags": ["pedir", "bano"]},
    {"id": "a2-hotel.toothbrush", "word": "toothbrush", "article": "a", "plural": "toothbrushes", "es": "el cepillo de dientes", "notes": "«th» entre los dientes: TUUTH-brash.", "situation": "alojamiento", "tags": ["pedir", "bano"], "image": "fluent:toothbrush"},
    {"id": "a2-hotel.soap", "word": "soap", "es": "el jabón", "notes": "Suena SOUP, con «ou».", "situation": "alojamiento", "tags": ["pedir", "bano"], "image": "fluent:soap"},
    {"id": "a2-hotel.toilet-paper", "word": "toilet paper", "es": "el papel higiénico", "notes": "En EE. UU. el baño es «the bathroom»; «toilet» es el váter.", "situation": "alojamiento", "tags": ["pedir", "bano"], "image": "fluent:roll-of-paper"},
    {"id": "a2-hotel.ice", "word": "ice", "es": "el hielo", "notes": "Suena AIS. Muchos hoteles tienen «ice machine» en cada planta.", "example": "a2-hotel.ice-machine", "situation": "alojamiento", "tags": ["pedir"], "image": "fluent:ice"},
    {"id": "a2-hotel.problem", "word": "problem", "article": "a", "plural": "problems", "es": "el problema", "notes": "Acento al principio: PRA-bləm.", "example": "a2-hotel.problem-with-my-room", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.noise", "word": "noise", "es": "el ruido", "notes": "«noisy» = ruidoso. Suena NOIZ, con «z» zumbada.", "example": "a2-hotel.room-is-noisy", "situation": "alojamiento", "tags": ["problemas"], "image": "fluent:speaker-high-volume"},
    {"id": "a2-hotel.hot-water", "word": "hot water", "es": "el agua caliente", "notes": "«hot» lleva una «a» abierta: HAT.", "example": "a2-hotel.no-hot-water", "situation": "alojamiento", "tags": ["problemas", "bano"]},
    {"id": "a2-hotel.sink", "word": "sink", "article": "a", "plural": "sinks", "es": "el lavabo", "notes": "También el fregadero de la cocina.", "situation": "alojamiento", "tags": ["problemas", "bano"]},
    {"id": "a2-hotel.toilet", "word": "toilet", "article": "a", "plural": "toilets", "es": "el váter", "notes": "Para preguntar por el baño se dice «restroom» o «bathroom».", "example": "a2-hotel.toilet-doesnt-flush", "situation": "alojamiento", "tags": ["problemas", "bano"], "image": "fluent:toilet"},
    {"id": "a2-hotel.manager", "word": "manager", "article": "a", "plural": "managers", "es": "el gerente / el encargado", "notes": "Suena MA-nə-dʒər.", "situation": "alojamiento", "tags": ["problemas", "personas"]},
    {"id": "a2-hotel.maintenance", "word": "maintenance", "es": "el mantenimiento", "notes": "Suena MEIN-tə-nəns.", "situation": "alojamiento", "tags": ["problemas"], "image": "fluent:wrench"},
    {"id": "a2-hotel.bill", "word": "bill", "article": "a", "plural": "bills", "es": "la factura / la cuenta", "notes": "«i» corta: BIL. En el hotel también «the folio».", "example": "a2-hotel.mistake-on-the-bill", "situation": "alojamiento", "tags": ["recepcion", "pagar"], "image": "fluent:receipt"},
    {"id": "a2-hotel.minibar", "word": "minibar", "article": "a", "plural": "minibars", "es": "el minibar", "notes": "Suena MI-ni-bar.", "example": "a2-hotel.didnt-use-the-minibar", "situation": "alojamiento", "tags": ["habitacion", "pagar"]},
