  "phrases": [
    {"id": "a2-hotel.id-like-to-check-in", "text": "Hi, I'd like to check in, please.", "es": "Hola, quería hacer el check-in, por favor.", "explanation": "Al llegar a recepción. «I'd like» es una forma educada; «I'd» suena AID, con la «d» suave.", "register": "formal", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.reservation-under", "text": "I have a reservation under Díaz.", "es": "Tengo una reserva a nombre de Díaz.", "notes": "«under + apellido» es como se dice «a nombre de».", "explanation": "Justo después de saludar en recepción. «under» = a nombre de. Suena AN-dər.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.three-nights", "text": "It's for three nights.", "es": "Es para tres noches.", "explanation": "Si te preguntan cuántas noches. «three» con «th» entre los dientes y «nights» con «ts» final: THRII NAITS.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.is-breakfast-included", "text": "Is breakfast included?", "es": "¿El desayuno está incluido?", "explanation": "Al hacer el check-in o al reservar. «breakfast» suena BREK-fəst, con «e».", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion", "desayuno"]},
    {"id": "a2-hotel.what-time-is-check-out", "text": "What time is check-out?", "es": "¿A qué hora es el check-out?", "explanation": "En recepción, para saber cuándo dejar la habitación. «What time» se une: wat-TAIM.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.do-you-need-my-card", "text": "Do you need my credit card?", "es": "¿Necesita mi tarjeta de crédito?", "explanation": "Cuando te piden documentos al llegar. «credit» suena KRE-dit, con la «r» americana.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion", "pagar"]},
    {"id": "a2-hotel.what-floor", "text": "What floor is my room on?", "es": "¿En qué planta está mi habitación?", "explanation": "Al recibir la llave. «floor» suena FLOR, con la «r» americana al final.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.where-is-the-elevator", "text": "Where's the elevator?", "es": "¿Dónde está el ascensor?", "explanation": "En el vestíbulo, con las maletas. «Where's the» se une: WERZ-thə, con «th» suave.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.room-is-really-nice", "text": "The room is really nice.", "es": "La habitación es muy bonita.", "explanation": "Al entrar, o si recepción te pregunta qué tal. «really» suena RI-li, con la «r» americana.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.room-with-a-view", "text": "Does the room have a view?", "es": "¿La habitación tiene vistas?", "explanation": "Al reservar o en el check-in. «view» empieza con «v» de labio y dientes: VYUU, no «biu».", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.how-do-i-turn-on-the-ac", "text": "How do I turn on the AC?", "es": "¿Cómo enciendo el aire acondicionado?", "explanation": "Llamando a recepción o con el mando en la mano. «turn on» se une: ter-NAN.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.how-does-the-shower-work", "text": "How does the shower work?", "es": "¿Cómo funciona la ducha?", "explanation": "Si no entiendes el grifo; en EE. UU. pasa mucho. «work» suena WERK, sin «o».", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion", "bano"]},
    {"id": "a2-hotel.bed-is-comfortable", "text": "The bed is very comfortable.", "es": "La cama es muy cómoda.", "explanation": "Para comentar algo bueno de la habitación. «comfortable» tiene tres sílabas: KAMF-tər-bəl.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.where-is-the-light-switch", "text": "Where's the light switch?", "es": "¿Dónde está el interruptor de la luz?", "explanation": "Al entrar en una habitación a oscuras. «switch» empieza con «s» directa, sin «e»: SWICH.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.can-i-open-the-window", "text": "Can I open the window?", "es": "¿Puedo abrir la ventana?", "explanation": "En habitaciones con ventanas que casi no se abren. «open» suena OU-pən.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.is-there-a-fridge", "text": "Is there a fridge in the room?", "es": "¿Hay nevera en la habitación?", "explanation": "Al hacer el check-in, si quieres guardar algo frío. «fridge» suena FRIDCH, con «i» corta.", "register": "neutral", "situation": "alojamiento", "tags": ["habitacion"]},
    {"id": "a2-hotel.wifi-password", "text": "What's the Wi-Fi password?", "es": "¿Cuál es la contraseña del wifi?", "explanation": "En recepción, nada más llegar. «What's the» se une: WATS-thə, con «th» suave.", "register": "neutral", "situation": "alojamiento", "tags": ["pedir"]},
    {"id": "a2-hotel.extra-towels", "text": "Could I get some extra towels?", "es": "¿Me podría dar unas toallas más?", "explanation": "Llamando a recepción o al personal de limpieza. «towels» suena TAU-əlz.", "register": "formal", "situation": "alojamiento", "tags": ["pedir", "bano"]},
    {"id": "a2-hotel.more-toilet-paper", "text": "Could we get more toilet paper?", "es": "¿Nos podrían traer más papel higiénico?", "explanation": "Llamando a recepción. «toilet» suena TOI-lət, con acento en la primera sílaba.", "register": "formal", "situation": "alojamiento", "tags": ["pedir", "bano"]},
    {"id": "a2-hotel.what-time-is-breakfast", "text": "What time is breakfast?", "es": "¿A qué hora es el desayuno?", "explanation": "En el check-in o al bajar por la mañana. «breakfast» suena BREK-fəst, no «brekfast» con «a».", "register": "neutral", "situation": "alojamiento", "tags": ["pedir", "desayuno"]},
    {"id": "a2-hotel.where-is-breakfast", "text": "Where do you serve breakfast?", "es": "¿Dónde sirven el desayuno?", "explanation": "Si no sabes dónde está el comedor. «serve» empieza con «s» directa: SERV.", "register": "neutral", "situation": "alojamiento", "tags": ["pedir", "desayuno"]},
    {"id": "a2-hotel.hair-dryer", "text": "Do you have a hair dryer?", "es": "¿Tienen secador de pelo?", "explanation": "Si no lo encuentras en el baño. «hair» suena JER y «dryer» DRAI-ər.", "register": "neutral", "situation": "alojamiento", "tags": ["pedir", "bano"]},
    {"id": "a2-hotel.ice-machine", "text": "Is there an ice machine?", "es": "¿Hay una máquina de hielo?", "explanation": "En hoteles de EE. UU. suele estar en el pasillo. «an ice» se une: ə-NAIS mə-SHIIN.", "register": "neutral", "situation": "alojamiento", "tags": ["pedir"]},
    {"id": "a2-hotel.leave-my-bags", "text": "Can I leave my bags here?", "es": "¿Puedo dejar aquí mis maletas?", "explanation": "Si llegas antes del check-in o después del check-out. «leave» lleva «i» larga: LIIV, no «live».", "register": "neutral", "situation": "alojamiento", "tags": ["pedir", "equipaje"]},
    {"id": "a2-hotel.call-me-a-taxi", "text": "Could you call me a taxi?", "es": "¿Me podría pedir un taxi?", "explanation": "En recepción, antes de salir. «call me» se une: KOL-mi; «taxi» suena TAK-si.", "register": "formal", "situation": "alojamiento", "tags": ["pedir", "transporte"]},
    {"id": "a2-hotel.wake-up-call", "text": "Could I get a wake-up call at seven?", "es": "¿Me podrían llamar para despertarme a las siete?", "notes": "«wake-up call» = la llamada del hotel para despertarte.", "explanation": "La noche antes de un vuelo temprano. «wake-up» se une: WEI-kap.", "register": "formal", "situation": "alojamiento", "tags": ["pedir"]},
    {"id": "a2-hotel.problem-with-my-room", "text": "There's a problem with my room.", "es": "Hay un problema con mi habitación.", "explanation": "Para empezar una queja en recepción, con calma. «There's a» se une: THER-zə, con «th» suave.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.ac-doesnt-work", "text": "The AC doesn't work.", "es": "El aire acondicionado no funciona.", "explanation": "Llamando a recepción. «doesn't» suena DA-zənt; «AC» se deletrea: ei-SI.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.no-hot-water", "text": "There's no hot water.", "es": "No hay agua caliente.", "explanation": "Llamando a recepción desde el baño. «water» con la «t» como «r» suave: WA-rər.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas", "bano"]},
    {"id": "a2-hotel.key-card-doesnt-work", "text": "My key card doesn't work.", "es": "Mi tarjeta de la habitación no funciona.", "explanation": "Pasa mucho: bajas a recepción y te la vuelven a activar. «card» suena KAARD, con «r».", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.wifi-isnt-working", "text": "The Wi-Fi isn't working.", "es": "El wifi no funciona.", "explanation": "Llamando a recepción. «isn't» suena I-zənt; «working» WER-king.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.toilet-doesnt-flush", "text": "The toilet doesn't flush.", "es": "La cisterna no funciona.", "explanation": "Llamando a recepción. «flush» = tirar de la cadena; «u» corta: FLASH.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas", "bano"]},
    {"id": "a2-hotel.room-is-noisy", "text": "The room is very noisy.", "es": "La habitación es muy ruidosa.", "explanation": "Si oyes la calle o a los vecinos. «noisy» suena NOI-zi, con «z» zumbada.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.change-rooms", "text": "Could I change rooms, please?", "es": "¿Podría cambiarme de habitación, por favor?", "explanation": "Después de explicar el problema. En inglés es «rooms», en plural. «change» suena CHEINCH.", "register": "formal", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.someone-look-at-it", "text": "Can someone come and look at it?", "es": "¿Puede venir alguien a mirarlo?", "explanation": "Para pedir que suban a arreglar algo. «look at it» se une: LU-kə-rit.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.thanks-for-fixing-it", "text": "Thanks for fixing it so fast.", "es": "Gracias por arreglarlo tan rápido.", "explanation": "Cuando el técnico termina. «fast» con «a» abierta y «st» final: FÆST.", "register": "neutral", "situation": "alojamiento", "tags": ["problemas"]},
    {"id": "a2-hotel.id-like-to-check-out", "text": "I'd like to check out, please.", "es": "Quería hacer el check-out, por favor.", "explanation": "En recepción, al irte. «check out» se une: che-KAUT.", "register": "formal", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.late-check-out", "text": "Is late check-out possible?", "es": "¿Se puede dejar la habitación más tarde?", "explanation": "La noche antes o por la mañana, si tu vuelo sale tarde. «possible» suena PA-sə-bəl.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.keep-my-bags", "text": "Could you keep my bags until three?", "es": "¿Me podría guardar las maletas hasta las tres?", "explanation": "Después del check-out, si sales a pasear. «until» se acentúa al final: ən-TIL.", "register": "formal", "situation": "alojamiento", "tags": ["recepcion", "equipaje"]},
    {"id": "a2-hotel.didnt-use-the-minibar", "text": "I didn't use the minibar.", "es": "No he usado el minibar.", "explanation": "Si te cobran algo del minibar. «didn't use» se une: DI-dənt YUUZ.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion", "pagar"]},
    {"id": "a2-hotel.mistake-on-the-bill", "text": "I think there's a mistake on the bill.", "es": "Creo que hay un error en la factura.", "explanation": "Revisando la factura en recepción, con educación. «mistake» se acentúa al final: mis-TEIK.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion", "pagar"]},
    {"id": "a2-hotel.can-i-get-a-receipt", "text": "Can I get a receipt, please?", "es": "¿Me da un recibo, por favor?", "explanation": "Al pagar o al hacer el check-out. «receipt» suena ri-SIIT: la «p» no se pronuncia.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion", "pagar"]},
    {"id": "a2-hotel.leave-key-card-in-room", "text": "Can I leave the key card in the room?", "es": "¿Puedo dejar la tarjeta en la habitación?", "explanation": "Si te vas temprano y la recepción está cerrada. «key» suena KII, con «i» larga.", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]},
    {"id": "a2-hotel.everything-was-great", "text": "Everything was great, thanks.", "es": "Todo ha ido genial, gracias.", "explanation": "Cuando te preguntan qué tal la estancia. «great» suena GREIT, con «ei».", "register": "neutral", "situation": "alojamiento", "tags": ["recepcion"]}
  ],
  "vocab": [
    {"id": "a2-hotel.reservation", "word": "reservation", "article": "a", "plural": "reservations", "es": "la reserva", "notes": "Acento en «vei»: re-zer-VEI-shən.", "example": "a2-hotel.reservation-under", "situation": "alojamiento", "tags": ["recepcion"], "image": "fluent:clipboard"},
