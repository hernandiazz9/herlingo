    {"id": "a2-health.fever", "word": "fever", "article": "a", "plural": "fevers", "es": "la fiebre", "notes": "«I have a fever» = tengo fiebre, con «a».", "example": "a2-health.i-think-i-have-a-fever", "situation": "salud", "tags": ["sintomas"], "image": "fluent:face-with-thermometer"},
    {"id": "a2-health.cold", "word": "cold", "article": "a", "plural": "colds", "es": "el resfriado", "notes": "«I have a cold» = estoy resfriado. «cold» también es «frío».", "situation": "salud", "tags": ["sintomas"], "image": "fluent:sneezing-face"},
    {"id": "a2-health.cough", "word": "cough", "article": "a", "plural": "coughs", "es": "la tos", "notes": "Suena KOF.", "example": "a2-health.cough-and-runny-nose", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.headache", "word": "headache", "article": "a", "plural": "headaches", "es": "el dolor de cabeza", "notes": "«ache» = dolor: «stomachache», «toothache».", "example": "a2-health.something-for-a-headache", "situation": "salud", "tags": ["sintomas"], "image": "fluent:face-with-head-bandage"},
