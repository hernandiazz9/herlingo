    {"id": "a2-health.allergy", "word": "allergy", "article": "an", "plural": "allergies", "es": "la alergia", "notes": "Acento al principio: Æ-lər-ji.", "situation": "salud", "tags": ["sintomas", "alergias"]},
    {"id": "a2-health.pharmacy", "word": "pharmacy", "article": "a", "plural": "pharmacies", "es": "la farmacia", "notes": "También «drugstore» (CVS, Walgreens): venden de todo.", "example": "a2-health.where-is-the-pharmacy-counter", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.medicine", "word": "medicine", "es": "la medicina", "notes": "Incontable: «some medicine». Suena ME-di-sən.", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.pills", "word": "pills", "es": "las pastillas", "notes": "Una: «a pill».", "example": "a2-health.two-pills-every-six-hours", "situation": "salud", "tags": ["farmacia"], "image": "fluent:pill"},
    {"id": "a2-health.painkiller", "word": "painkiller", "article": "a", "plural": "painkillers", "es": "el analgésico", "notes": "En EE. UU. se pide por la marca: Tylenol, Advil.", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.prescription", "word": "prescription", "article": "a", "plural": "prescriptions", "es": "la receta", "notes": "La receta del médico; la de cocina es «recipe».", "example": "a2-health.do-i-need-a-prescription", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.bandage", "word": "bandage", "article": "a", "plural": "bandages", "es": "la tirita / la venda", "notes": "Una tirita se suele llamar «Band-Aid».", "situation": "salud", "tags": ["farmacia"], "image": "fluent:adhesive-bandage"},
    {"id": "a2-health.thermometer", "word": "thermometer", "article": "a", "plural": "thermometers", "es": "el termómetro", "notes": "Con «th» y acento en «mom»: thər-MA-mə-tər.", "situation": "salud", "tags": ["farmacia"], "image": "fluent:thermometer"},
    {"id": "a2-health.nurse", "word": "nurse", "article": "a", "plural": "nurses", "es": "el enfermero / la enfermera", "notes": "Suena NERS, con la «r» americana.", "situation": "salud", "tags": ["medico", "personas"], "image": "fluent:health-worker"},
    {"id": "a2-health.appointment", "word": "appointment", "article": "an", "plural": "appointments", "es": "la cita", "notes": "La cita con el médico; una cita romántica es «a date».", "example": "a2-health.make-an-appointment", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.urgent-care", "word": "urgent care", "es": "el centro de urgencias (sin cita)", "notes": "Para lo que no es grave; para lo grave, «the ER».", "example": "a2-health.urgent-care-near-here", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.insurance", "word": "insurance", "es": "el seguro", "notes": "Incontable: «I have insurance», sin «an».", "example": "a2-health.travel-insurance", "situation": "salud", "tags": ["medico", "pagar"]},
    {"id": "a2-health.hospital", "word": "hospital", "article": "a", "plural": "hospitals", "es": "el hospital", "notes": "La «h» se aspira: JAS-pi-rəl.", "situation": "salud", "tags": ["medico"], "image": "fluent:hospital"},
    {"id": "a2-health.emergency", "word": "emergency", "article": "an", "plural": "emergencies", "es": "la emergencia", "notes": "«It's an emergency!» = ¡es una emergencia!", "situation": "salud", "tags": ["emergencias"], "image": "fluent:sos-button"},
    {"id": "a2-health.ambulance", "word": "ambulance", "article": "an", "plural": "ambulances", "es": "la ambulancia", "notes": "Acento al principio: ÆM-biu-ləns.", "example": "a2-health.need-an-ambulance", "situation": "salud", "tags": ["emergencias"], "image": "fluent:ambulance"},
    {"id": "a2-health.police", "word": "police", "es": "la policía", "notes": "Con «the» y verbo en plural: «the police are here».", "example": "a2-health.call-the-police", "situation": "salud", "tags": ["emergencias"], "image": "fluent:police-car"},
    {"id": "a2-health.accident", "word": "accident", "article": "an", "plural": "accidents", "es": "el accidente", "notes": "Con «c» doble que suena «ks»: ÆK-si-dənt.", "example": "a2-health.theres-been-an-accident", "situation": "salud", "tags": ["emergencias"]}
  ],
  "qa": [
    {"id": "a2-health.qa.where-does-it-hurt", "question": "Where does it hurt?", "questionEs": "¿Dónde le duele?", "accepted": [{"text": "My head hurts.", "es": "Me duele la cabeza."}, {"text": "Right here, in my stomach.", "es": "Aquí, en la tripa."}], "distractors": [{"text": "It hurts me the head.", "es": "(calco del español) Me duele la cabeza."}, {"text": "It hurts yesterday.", "es": "Me duele ayer."}], "register": "neutral", "situation": "salud", "notes": "Di la parte del cuerpo: «My … hurts» o señala con «Right here».", "voice": "en-US-EmmaNeural"},
    {"id": "a2-health.qa.are-you-ok", "question": "Hey, are you OK? You look tired.", "questionEs": "Oye, ¿estás bien? Pareces cansado.", "accepted": [{"text": "Not really. I think I have a cold.", "es": "No mucho. Creo que estoy resfriado."}, {"text": "I'm OK, I just couldn't sleep.", "es": "Estoy bien, es que no he podido dormir."}], "distractors": [{"text": "Yes, you look tired.", "es": "Sí, pareces cansado."}, {"text": "I'm twenty-eight.", "es": "Tengo veintiocho años."}], "register": "tu", "situation": "salud", "notes": "Un amigo se preocupa por ti: di cómo estás y por qué.", "voice": "en-US-AndrewNeural"},
    {"id": "a2-health.qa.feel-better-soon", "question": "Oh no! Feel better soon.", "questionEs": "¡Vaya! Que te mejores.", "accepted": [{"text": "Thanks, I hope so.", "es": "Gracias, eso espero."}, {"text": "Thank you!", "es": "¡Gracias!"}], "distractors": [{"text": "You too!", "es": "¡Igualmente!"}, {"text": "Yes, I feel.", "es": "Sí, siento."}], "register": "tu", "situation": "salud", "notes": "Te desean que te mejores: da las gracias. «You too» no tiene sentido si el otro no está malo.", "voice": "en-US-AvaNeural"},
    {"id": "a2-health.qa.symptoms", "question": "What are your symptoms?", "questionEs": "¿Qué síntomas tiene?", "accepted": [{"text": "I have a sore throat and a fever.", "es": "Me duele la garganta y tengo fiebre."}, {"text": "I have a bad headache.", "es": "Tengo un dolor de cabeza fuerte."}], "distractors": [{"text": "I have a prescription.", "es": "Tengo una receta."}, {"text": "It's on your left.", "es": "Está a tu izquierda."}], "register": "neutral", "situation": "salud", "notes": "«symptoms» = síntomas: di qué te pasa con «I have…».", "voice": "en-US-BrianNeural"},
    {"id": "a2-health.qa.other-medicine", "question": "Are you taking any other medicine?", "questionEs": "¿Toma algún otro medicamento?", "accepted": [{"text": "No, nothing else.", "es": "No, nada más."}, {"text": "Just some vitamins.", "es": "Solo unas vitaminas."}], "distractors": [{"text": "Yes, I'm taking the bus.", "es": "Sí, voy en autobús."}, {"text": "No, I don't feel well.", "es": "No, no me encuentro bien."}], "register": "neutral", "situation": "salud", "notes": "Aquí «take» es tomar un medicamento: di que no, o qué tomas.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-health.qa.allergies", "question": "Do you have any allergies?", "questionEs": "¿Tiene alguna alergia?", "accepted": [{"text": "No, I don't.", "es": "No."}, {"text": "Yes, I'm allergic to penicillin.", "es": "Sí, soy alérgico a la penicilina."}], "distractors": [{"text": "Yes, I have insurance.", "es": "Sí, tengo seguro."}, {"text": "No, I'm allergic.", "es": "No, soy alérgico."}], "register": "neutral", "situation": "salud", "notes": "Responde sí o no; si es que sí, di a qué con «allergic to».", "voice": "en-US-AvaNeural"},
    {"id": "a2-health.qa.how-long", "question": "How long have you felt like this?", "questionEs": "¿Desde cuándo se encuentra así?", "accepted": [{"text": "Since yesterday.", "es": "Desde ayer."}, {"text": "For about three days.", "es": "Desde hace unos tres días."}], "distractors": [{"text": "Very bad.", "es": "Muy mal."}, {"text": "At three o'clock.", "es": "A las tres."}], "register": "neutral", "situation": "salud", "notes": "«How long» pregunta cuánto tiempo: «since» + momento, o «for» + duración.", "voice": "en-US-BrianNeural"},
    {"id": "a2-health.qa.insurance", "question": "Do you have insurance?", "questionEs": "¿Tiene seguro?", "accepted": [{"text": "Yes, I have travel insurance.", "es": "Sí, tengo seguro de viaje."}, {"text": "No. How much does the visit cost?", "es": "No. ¿Cuánto cuesta la consulta?"}], "distractors": [{"text": "Yes, I have a prescription.", "es": "Sí, tengo receta."}, {"text": "No, thank you.", "es": "No, gracias."}], "register": "neutral", "situation": "salud", "notes": "Di si tienes seguro de viaje; si no, pregunta el precio.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-health.qa.whats-your-emergency", "question": "Nine-one-one, what's your emergency?", "questionEs": "Nueve, uno, uno, ¿cuál es su emergencia?", "accepted": [{"text": "There's been an accident. We need an ambulance.", "es": "Ha habido un accidente. Necesitamos una ambulancia."}, {"text": "My friend fainted and he can't breathe.", "es": "Mi amigo se ha desmayado y no puede respirar."}], "distractors": [{"text": "I'm fine, thank you.", "es": "Estoy bien, gracias."}, {"text": "Nine-one-one, please.", "es": "El 911, por favor."}], "register": "neutral", "situation": "salud", "notes": "Di qué pasa en una frase corta y qué necesitas.", "voice": "en-US-AndrewNeural"},
    {"id": "a2-health.qa.location", "question": "OK. What's your location?", "questionEs": "Vale. ¿Dónde se encuentra?", "accepted": [{"text": "I'm at the corner of State and Lake.", "es": "Estoy en la esquina de State con Lake."}, {"text": "In Millennium Park, near the Bean.", "es": "En Millennium Park, cerca del Bean."}], "distractors": [{"text": "I'm from Spain.", "es": "Soy de España."}, {"text": "I'm OK, thanks.", "es": "Estoy bien, gracias."}], "register": "neutral", "situation": "salud", "notes": "«location» = dónde estás ahora: da el cruce de calles o un sitio conocido.", "voice": "en-US-AndrewNeural"}
  ]
}
