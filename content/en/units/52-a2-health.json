  "phrases": [
    {"id": "a2-health.my-head-hurts", "text": "My head hurts.", "es": "Me duele la cabeza.", "notes": "«hurt» = doler: «my head hurts», «my back hurts».", "explanation": "Para decir qué te duele, a un amigo o al médico. «hurts» suena JERTS, con la «r» americana.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.it-hurts-here", "text": "It hurts here.", "es": "Me duele aquí.", "explanation": "Señalando el sitio, en la farmacia o en la consulta. «hurts here» se une, con dos «h» aspiradas suaves.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.sore-throat", "text": "I have a sore throat.", "es": "Me duele la garganta.", "notes": "«sore» = dolorido: «a sore throat», «sore muscles».", "explanation": "Muy útil en la farmacia. «throat» con la lengua entre los dientes: THROUT, nunca «trout».", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.stomachache", "text": "I have a stomachache.", "es": "Me duele la tripa.", "explanation": "Si algo te ha sentado mal. «stomach» se escribe con «ch» pero suena «k»: STA-mək-eik.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.toothache", "text": "I have a toothache.", "es": "Me duele una muela.", "explanation": "Para pedir un dentista. «tooth» con «th» final y «u» larga: TUUTH-eik.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.hurt-my-ankle", "text": "I hurt my ankle.", "es": "Me he hecho daño en el tobillo.", "notes": "«hurt» es igual en presente y en pasado.", "explanation": "Después de torcerte el pie. «ankle» suena ÆN-kəl, con «a» abierta.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.hurts-when-i-walk", "text": "It hurts when I walk.", "es": "Me duele al andar.", "explanation": "Para explicar cuándo te duele. En «walk» la «l» no suena: WOK.", "register": "neutral", "situation": "salud", "tags": ["cuerpo", "dolor"]},
    {"id": "a2-health.i-dont-feel-well", "text": "I don't feel well.", "es": "No me encuentro bien.", "explanation": "A un amigo, en el trabajo o al médico. «feel» lleva «i» larga: FIIL; «well» con «w» suave.", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.i-feel-sick", "text": "I feel sick.", "es": "Me encuentro mal.", "notes": "En EE. UU. «sick» es estar enfermo; también puede ser tener náuseas.", "explanation": "Para decir que estás enfermo. «sick» con «i» corta: SIK, no «siik».", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.i-think-i-have-a-fever", "text": "I think I have a fever.", "es": "Creo que tengo fiebre.", "notes": "La temperatura va en °F: 100 °F son unos 38 °C.", "explanation": "En la farmacia o al médico. «think» con la lengua entre los dientes: THINK, nunca «tink».", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.cough-and-runny-nose", "text": "I have a cough and a runny nose.", "es": "Tengo tos y mocos.", "explanation": "Los síntomas típicos de un resfriado. «cough» suena KOF: la «gh» suena «f».", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.i-feel-dizzy", "text": "I feel dizzy.", "es": "Estoy mareado.", "explanation": "Si te mareas en la calle o en el tren. «dizzy» lleva «z» zumbada, como una abeja: DI-zi.", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.couldnt-sleep", "text": "I couldn't sleep last night.", "es": "Anoche no pude dormir.", "explanation": "Para explicar cómo estás. «couldn't» suena KU-dənt; la «l» no se pronuncia.", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.allergic-to-penicillin", "text": "I'm allergic to penicillin.", "es": "Soy alérgico a la penicilina.", "explanation": "Díselo siempre al médico y al farmacéutico. «allergic» se acentúa en «ler»: ə-LER-jik.", "register": "neutral", "situation": "salud", "tags": ["sintomas", "alergias"]},
    {"id": "a2-health.stay-home-today", "text": "I'm going to stay home today.", "es": "Hoy me voy a quedar en casa.", "notes": "En EE. UU. se dice «stay home», sin «at».", "explanation": "Para avisar en el trabajo o a tus amigos. «going to» se dice rápido: GOU-ing-tə.", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.hope-you-feel-better", "text": "I hope you feel better soon!", "es": "¡Que te mejores pronto!", "explanation": "Lo que dices a alguien que está malo. «better» con la «t» americana como «r»: BE-rər.", "register": "neutral", "situation": "salud", "tags": ["sintomas", "cortesia"]},
    {"id": "a2-health.feeling-better", "text": "I'm feeling better, thanks.", "es": "Ya me encuentro mejor, gracias.", "explanation": "Cuando te preguntan cómo sigues. «thanks» con la lengua entre los dientes: THÆNKS.", "register": "neutral", "situation": "salud", "tags": ["sintomas"]},
    {"id": "a2-health.where-is-the-pharmacy-counter", "text": "Where's the pharmacy counter?", "es": "¿Dónde está el mostrador de la farmacia?", "notes": "En CVS o Walgreens la farmacia es un mostrador al fondo de la tienda.", "explanation": "Al entrar en una «drugstore». «pharmacy» se acentúa al principio: FAR-mə-si.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.something-for-a-headache", "text": "Do you have something for a headache?", "es": "¿Tiene algo para el dolor de cabeza?", "explanation": "La forma más fácil de pedir un medicamento. «headache» suena JED-eik: «ache» es EIK.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.something-for-a-cough", "text": "I need something for a cough.", "es": "Necesito algo para la tos.", "explanation": "En el mostrador de la farmacia. «need» lleva «i» larga: NIID.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.do-i-need-a-prescription", "text": "Do I need a prescription?", "es": "¿Necesito receta?", "explanation": "Antes de pedir un medicamento concreto. «prescription» se acentúa en «scrip»: pri-SKRIP-shən.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.over-the-counter", "text": "Can I get this over the counter?", "es": "¿Esto se puede comprar sin receta?", "notes": "«over the counter» = sin receta; muchos analgésicos están en las estanterías.", "explanation": "Enseñando la caja o el nombre del medicamento. «counter» suena KAUN-tər, a veces KAU-nər.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.how-often", "text": "How often do I take it?", "es": "¿Cada cuánto me lo tomo?", "explanation": "Cuando te dan el medicamento. «often» suena O-fən: la «t» no se suele pronunciar.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.two-pills-every-six-hours", "text": "Take two pills every six hours.", "es": "Tómate dos pastillas cada seis horas.", "explanation": "Lo que te dice el farmacéutico. «hours» suena AUERZ: la «h» no se pronuncia.", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.take-it-with-food", "text": "Take it with food.", "es": "Tómatelo con comida.", "explanation": "Instrucción típica del farmacéutico. «food» lleva «u» larga: FUUD, no «fud».", "register": "neutral", "situation": "salud", "tags": ["farmacia"]},
    {"id": "a2-health.need-to-see-a-doctor", "text": "I need to see a doctor.", "es": "Necesito ver a un médico.", "explanation": "En la recepción del hotel o a un amigo. «doctor» en americano: DAK-tər.", "register": "neutral", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.make-an-appointment", "text": "I'd like to make an appointment.", "es": "Quería pedir cita.", "explanation": "Por teléfono o en la recepción de la consulta. «an appointment» se une: ə-nə-POINT-mənt.", "register": "formal", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.urgent-care-near-here", "text": "Is there an urgent care near here?", "es": "¿Hay un centro de urgencias por aquí cerca?", "notes": "Una «urgent care» atiende sin cita lo que no es grave; es más barata que el hospital.", "explanation": "Si necesitas un médico hoy sin ir al hospital. «urgent» suena ER-jənt.", "register": "neutral", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.fill-out-this-form", "text": "Please fill out this form.", "es": "Rellene este formulario, por favor.", "notes": "«fill out» = rellenar un papel.", "explanation": "Lo que te dicen en recepción al llegar. «fill out» se une: fi-LAUT.", "register": "neutral", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.travel-insurance", "text": "I have travel insurance.", "es": "Tengo seguro de viaje.", "explanation": "En la recepción de la consulta, al pagar. «insurance» se acentúa en «shur»: in-SHUR-əns.", "register": "neutral", "situation": "salud", "tags": ["medico", "pagar"]},
    {"id": "a2-health.how-much-is-the-visit", "text": "How much does the visit cost?", "es": "¿Cuánto cuesta la consulta?", "notes": "En EE. UU. la sanidad es cara: pregunta el precio antes.", "explanation": "Antes de que te atiendan. «visit» lleva «z»: VI-zit.", "register": "neutral", "situation": "salud", "tags": ["medico", "pagar"]},
    {"id": "a2-health.it-started-yesterday", "text": "It started yesterday.", "es": "Empezó ayer.", "explanation": "Cuando el médico pregunta desde cuándo. La «-ed» de «started» suena «id»: STAR-rid.", "register": "neutral", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.is-it-serious", "text": "Is it serious?", "es": "¿Es grave?", "explanation": "Al médico, después de que te mire. «serious» suena SI-riəs, acento al principio.", "register": "neutral", "situation": "salud", "tags": ["medico"]},
    {"id": "a2-health.write-that-down", "text": "Could you write that down, please?", "es": "¿Me lo podría escribir, por favor?", "explanation": "Si no entiendes el nombre de un medicamento. «write» suena RAIT: la «w» no se pronuncia.", "register": "formal", "situation": "salud", "tags": ["medico", "no-entiendo"]},
    {"id": "a2-health.help", "text": "Help!", "es": "¡Socorro!", "explanation": "Para pedir ayuda urgente en la calle. La «h» se aspira suave y la «p» final se oye: JELP.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.call-911", "text": "Call nine-one-one!", "es": "¡Llama al 911!", "notes": "El 911 es el número de emergencias de EE. UU. (policía, ambulancia, bomberos).", "explanation": "A la gente de alrededor si pasa algo grave. El 911 se dice cifra a cifra: nain-wan-wan.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.need-an-ambulance", "text": "I need an ambulance.", "es": "Necesito una ambulancia.", "explanation": "Al llamar al 911. «an ambulance» se une: ə-NÆM-biu-ləns.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.theres-been-an-accident", "text": "There's been an accident.", "es": "Ha habido un accidente.", "explanation": "Para empezar a explicar una emergencia. «accident» se acentúa al principio: ÆK-si-dənt.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.my-friend-fainted", "text": "My friend fainted.", "es": "Mi amigo se ha desmayado.", "explanation": "Al 911 o a quien pueda ayudar. La «-ed» de «fainted» suena «id»: FEIN-tid.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.he-cant-breathe", "text": "He can't breathe.", "es": "No puede respirar.", "explanation": "Una emergencia grave: dilo claro. «breathe» termina en «th» suave, como la «d» de «nada»: BRIID.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.corner-of-state-and-lake", "text": "I'm at the corner of State and Lake.", "es": "Estoy en la esquina de State con Lake.", "notes": "En Chicago se da la ubicación con el cruce de dos calles.", "explanation": "Para decir dónde estás al 911. «corner of» se une: KOR-nə-rəv.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.where-is-the-er", "text": "Where's the emergency room?", "es": "¿Dónde están las urgencias?", "notes": "Las urgencias del hospital: «the ER» (I-AR).", "explanation": "Al llegar al hospital. «emergency» se acentúa en «mer»: i-MER-jən-si.", "register": "neutral", "situation": "salud", "tags": ["emergencias", "medico"]},
    {"id": "a2-health.call-the-police", "text": "Please call the police!", "es": "¡Llame a la policía, por favor!", "explanation": "Si ves un delito o te pasa algo. «police» se acentúa al final: pə-LIIS.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]},
    {"id": "a2-health.someone-stole-my-wallet", "text": "Someone stole my wallet.", "es": "Me han robado la cartera.", "explanation": "A la policía o en la recepción del hotel. «stole» sin «e» delante: STOUL.", "register": "neutral", "situation": "salud", "tags": ["emergencias"]}
  ],
