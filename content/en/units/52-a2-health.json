    {"id": "a2-health.arm", "word": "arm", "article": "an", "plural": "arms", "es": "el brazo", "notes": "Suena AARM, con la «r» americana.", "situation": "salud", "tags": ["cuerpo"], "image": "fluent:flexed-biceps"},
