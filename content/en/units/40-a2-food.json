  "phrases": [
    {"id": "a2-food.can-i-get-a-latte", "text": "Can I get a medium latte?", "es": "¿Me pones un latte mediano?", "explanation": "Pidiendo en la barra de una cafetería; en EE. UU. «Can I get…?» es lo normal. «latte» suena LA-tei.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.small-coffee", "text": "A small coffee, please.", "es": "Un café pequeño, por favor.", "notes": "El café normal en EE. UU. es de filtro; el «espresso» se pide aparte.", "explanation": "La forma más corta de pedir. «coffee» es café de filtro, largo; acento al principio: KA-fi.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.iced-coffee", "text": "Could I get an iced coffee?", "es": "¿Me podría poner un café con hielo?", "explanation": "Para pedir café frío, muy habitual en EE. UU. «iced» suena AIST: la -ed suena «t».", "register": "formal", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.with-oat-milk", "text": "Can I get that with oat milk?", "es": "¿Me lo pones con leche de avena?", "explanation": "Para cambiar la leche de tu bebida. «oat» suena «óut», con o redonda, nunca «at».", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.no-sugar", "text": "No sugar, thanks.", "es": "Sin azúcar, gracias.", "explanation": "Si te preguntan cómo lo quieres. «sugar» empieza por «sh»: SHU-gər.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.for-here-or-to-go", "text": "For here or to go?", "es": "¿Para tomar aquí o para llevar?", "notes": "Te lo preguntan casi siempre al pedir.", "explanation": "Lo oyes al pedir en cafeterías y comida rápida. «to go» suena tə-GOU, con «to» débil.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.to-go-please", "text": "To go, please.", "es": "Para llevar, por favor.", "explanation": "Si te lo llevas. Responde solo con eso, sin «yes». «go» suena GOU, con «ou».", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.for-here-please", "text": "For here, please.", "es": "Para tomar aquí, por favor.", "explanation": "Si te quedas en el local. «here» con «h» aspirada suave y «r» americana: JIR.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.name-for-the-order", "text": "Can I get a name for the order?", "es": "¿Me dices un nombre para el pedido?", "notes": "Escriben tu nombre en el vaso: deletréalo si hace falta.", "explanation": "Te lo preguntan al pagar; luego te llaman por tu nombre. «order» suena OR-dər, con la «r» americana.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.blueberry-muffin", "text": "And a blueberry muffin, please.", "es": "Y una magdalena de arándanos, por favor.", "explanation": "Para añadir algo de comer al pedido. «blueberry» acentúa al principio: BLU-be-ri.", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.thats-all", "text": "That's all, thanks.", "es": "Nada más, gracias.", "explanation": "Cuando te preguntan «Anything else?». «That's» con la lengua entre los dientes, no «dats».", "register": "neutral", "situation": "comida", "tags": ["cafeteria"]},
    {"id": "a2-food.table-for-two", "text": "Hi, a table for two, please.", "es": "Hola, una mesa para dos, por favor.", "notes": "Cartel típico en la entrada: «Please wait to be seated».", "explanation": "Al entrar; en EE. UU. esperas en la entrada a que te sienten. «two» suena TUU, con «t» fuerte.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.have-a-reservation", "text": "I have a reservation for seven.", "es": "Tengo una reserva para las siete.", "explanation": "Al llegar si has reservado. «reservation» se acentúa en «vei»: re-zər-VEI-shən.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.how-long-is-the-wait", "text": "How long is the wait?", "es": "¿Cuánto hay que esperar?", "explanation": "Si el restaurante está lleno y hay lista de espera. «wait» suena UEIT, con «ei».", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.can-we-sit-outside", "text": "Can we sit outside?", "es": "¿Podemos sentarnos fuera?", "explanation": "Si quieres mesa en la terraza. «sit» lleva «i» corta, distinta de «seat»: SIT.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.could-we-see-the-menu", "text": "Could we see the menu, please?", "es": "¿Nos podría traer la carta, por favor?", "explanation": "Si aún no te la han dado. «menu» suena ME-niu, acento al principio.", "register": "formal", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.what-do-you-recommend", "text": "What do you recommend?", "es": "¿Qué me recomienda?", "explanation": "Para pedir consejo al camarero. Acento al final: re-kə-MEND.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.need-a-few-minutes", "text": "We need a few more minutes.", "es": "Necesitamos unos minutos más.", "explanation": "Si aún no has decidido cuando viene el camarero. «minutes» suena MI-nits.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.ill-have-the-burger", "text": "I'll have the burger, please.", "es": "Para mí, la hamburguesa, por favor.", "explanation": "La forma natural de pedir tu plato. «I'll» suena AIL, en una sola sílaba.", "register": "neutral", "situation": "comida", "tags": ["restaurante", "pedir"]},
    {"id": "a2-food.id-like-the-chicken-salad", "text": "I'd like the chicken salad, please.", "es": "Quería la ensalada de pollo, por favor.", "explanation": "Algo más educado que «I'll have». «I'd» suena AID; «salad» se acentúa al principio: SA-ləd.", "register": "formal", "situation": "comida", "tags": ["restaurante", "pedir"]},
    {"id": "a2-food.medium-rare", "text": "Medium rare, please.", "es": "Poco hecha, por favor.", "notes": "«rare» muy poco hecha, «medium» al punto, «well done» muy hecha.", "explanation": "Cuando te preguntan cómo quieres la carne. «rare» suena RER, con la «r» americana.", "register": "neutral", "situation": "comida", "tags": ["restaurante", "pedir"]},
    {"id": "a2-food.what-does-it-come-with", "text": "What does it come with?", "es": "¿Con qué viene?", "explanation": "Para saber la guarnición de un plato. «come with» se une: KAM-wiθ.", "register": "neutral", "situation": "comida", "tags": ["restaurante", "pedir"]},
    {"id": "a2-food.salad-instead-of-fries", "text": "Can I get a salad instead of fries?", "es": "¿Me pone ensalada en vez de patatas?", "explanation": "Para cambiar la guarnición. «instead» se acentúa al final: in-STED.", "register": "neutral", "situation": "comida", "tags": ["restaurante", "pedir"]},
    {"id": "a2-food.just-water", "text": "Just water for me, thanks.", "es": "Para mí solo agua, gracias.", "notes": "El agua del grifo con hielo es gratis en los restaurantes.", "explanation": "Cuando te preguntan qué quieres beber. «water» con la «t» americana suave, como «r»: UA-rər.", "register": "neutral", "situation": "comida", "tags": ["restaurante", "bebidas"]},
    {"id": "a2-food.beers-on-tap", "text": "What beers do you have on tap?", "es": "¿Qué cervezas tenéis de barril?", "notes": "«On tap» = de barril. Te pueden pedir el DNI: se bebe alcohol desde los 21.", "explanation": "En un bar o restaurante, para elegir cerveza. «beer» suena BIR, con «i» larga.", "register": "neutral", "situation": "comida", "tags": ["bebidas"]},
    {"id": "a2-food.im-vegetarian", "text": "I'm vegetarian.", "es": "Soy vegetariano.", "explanation": "Para avisar antes de pedir. Acento en «te»: ve-jə-TE-ri-ən.", "register": "neutral", "situation": "comida", "tags": ["alergias"]},
    {"id": "a2-food.allergic-to-nuts", "text": "I'm allergic to nuts.", "es": "Soy alérgico a los frutos secos.", "explanation": "Dilo siempre al pedir si tienes alergia. «allergic» acentúa la segunda sílaba: ə-LER-jik.", "register": "neutral", "situation": "comida", "tags": ["alergias"]},
    {"id": "a2-food.does-this-have-nuts", "text": "Does this have nuts in it?", "es": "¿Esto lleva frutos secos?", "explanation": "Señalando un plato de la carta. «this» con la lengua entre los dientes, nunca «dis».", "register": "neutral", "situation": "comida", "tags": ["alergias"]},
    {"id": "a2-food.is-it-spicy", "text": "Is it spicy?", "es": "¿Pica?", "explanation": "Antes de pedir algo que no conoces. «spicy» sin «e» delante: SPAI-si, no «espaisi».", "register": "neutral", "situation": "comida", "tags": ["pedir"]},
    {"id": "a2-food.without-onions", "text": "Can I get it without onions?", "es": "¿Me lo puede poner sin cebolla?", "explanation": "Para quitar un ingrediente del plato. «onions» suena AN-yənz, con «a» corta.", "register": "neutral", "situation": "comida", "tags": ["pedir", "alergias"]},
    {"id": "a2-food.dressing-on-the-side", "text": "Can I have the dressing on the side?", "es": "¿Me pone el aliño aparte?", "notes": "«On the side» = aparte, en un recipiente pequeño.", "explanation": "Muy habitual con ensaladas en EE. UU. «side» suena SAID, con la «d» final clara.", "register": "neutral", "situation": "comida", "tags": ["pedir"]},
    {"id": "a2-food.anything-gluten-free", "text": "Do you have anything gluten-free?", "es": "¿Tenéis algo sin gluten?", "explanation": "Si no puedes comer gluten. «gluten» suena GLU-tən; la «t» casi se traga.", "register": "neutral", "situation": "comida", "tags": ["alergias"]},
    {"id": "a2-food.i-dont-eat-meat", "text": "I don't eat meat.", "es": "No como carne.", "explanation": "Para explicar lo que no comes. «meat» lleva «i» larga: MIIT, igual que «meet».", "register": "neutral", "situation": "comida", "tags": ["alergias"]},
    {"id": "a2-food.no-ice", "text": "No ice, please.", "es": "Sin hielo, por favor.", "explanation": "Las bebidas llevan mucho hielo por defecto. «ice» suena AIS, con «s» sorda.", "register": "neutral", "situation": "comida", "tags": ["bebidas"]},
    {"id": "a2-food.everythings-great", "text": "Everything's great, thanks.", "es": "Todo está muy bueno, gracias.", "notes": "A mitad de comida te preguntan «How is everything?».", "explanation": "Respuesta típica cuando el camarero pasa a preguntar qué tal. «great» suena GREIT.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.this-is-delicious", "text": "This is delicious!", "es": "¡Esto está buenísimo!", "explanation": "Para decir que te encanta la comida. Acento en «li»: di-LI-shəs.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.more-napkins", "text": "Could we get some more napkins?", "es": "¿Nos podría traer más servilletas?", "explanation": "Pidiendo algo que falta en la mesa. «napkins» se acentúa al principio: NAP-kinz.", "register": "formal", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.can-i-get-a-refill", "text": "Can I get a refill?", "es": "¿Me lo rellenas?", "notes": "En muchos sitios el refresco y el café de filtro se rellenan gratis.", "explanation": "Señalando tu vaso vacío de refresco o café. Acento al principio: RI-fil.", "register": "neutral", "situation": "comida", "tags": ["bebidas"]},
    {"id": "a2-food.not-what-i-ordered", "text": "Sorry, this isn't what I ordered.", "es": "Perdone, esto no es lo que he pedido.", "explanation": "Si te traen otro plato. «ordered» suena OR-dərd: la -ed es una «d».", "register": "neutral", "situation": "comida", "tags": ["restaurante", "problemas"]},
    {"id": "a2-food.food-is-cold", "text": "My food is a little cold.", "es": "Mi comida está un poco fría.", "explanation": "Para quejarte con amabilidad. «cold» suena KOULD, con «ou», distinto de «called».", "register": "neutral", "situation": "comida", "tags": ["restaurante", "problemas"]},
    {"id": "a2-food.where-is-the-restroom", "text": "Where's the restroom?", "es": "¿Dónde está el baño?", "notes": "Se dice «restroom» o «bathroom»; «toilet» suena brusco.", "explanation": "Lo preguntas a cualquier camarero. «restroom» se acentúa al principio: REST-rum.", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.can-i-get-another-one", "text": "Can I get another one?", "es": "¿Me pones otra?", "explanation": "Para repetir la misma bebida. «another» se acentúa en la segunda: ə-NA-ðər.", "register": "neutral", "situation": "comida", "tags": ["bebidas"]},
    {"id": "a2-food.im-full", "text": "I'm full, thanks.", "es": "Estoy lleno, gracias.", "explanation": "Si te ofrecen más y no puedes más. «full» lleva «u» corta, distinta de «fool».", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.dessert-menu", "text": "Can we see the dessert menu?", "es": "¿Podemos ver la carta de postres?", "explanation": "Al terminar el plato principal. «dessert» se acentúa al final: di-ZERT (no lo confundas con «desert»).", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.can-we-get-the-check", "text": "Can we get the check, please?", "es": "¿Nos trae la cuenta, por favor?", "notes": "En EE. UU. es «check»; «bill» también se entiende.", "explanation": "Al terminar; a veces te la traen sin pedirla. «check» suena CHEK.", "register": "neutral", "situation": "comida", "tags": ["pagar"]},
    {"id": "a2-food.separate-checks", "text": "Can we get separate checks?", "es": "¿Nos puede cobrar por separado?", "explanation": "Si cada uno paga lo suyo; mejor pedirlo al principio. «separate» suena SE-prət, en dos sílabas.", "register": "neutral", "situation": "comida", "tags": ["pagar"]},
    {"id": "a2-food.lets-split-it", "text": "Let's split it.", "es": "Vamos a medias.", "explanation": "Entre amigos, para pagar a partes iguales. «split» sin «e» delante: SPLIT.", "register": "tu", "situation": "comida", "tags": ["pagar"]},
    {"id": "a2-food.is-the-tip-included", "text": "Is the tip included?", "es": "¿Está incluida la propina?", "notes": "Casi nunca: se deja entre el 18 y el 20 % en la mesa.", "explanation": "Mira la cuenta antes de dejar propina. La -ed de «included» suena /ɪd/: in-KLU-did.", "register": "neutral", "situation": "comida", "tags": ["pagar", "propina"]},
    {"id": "a2-food.where-do-i-add-the-tip", "text": "Where do I add the tip?", "es": "¿Dónde pongo la propina?", "explanation": "Con la cuenta delante, si hay una línea «Tip» o una pantalla. «add» con «a» abierta: ÆD.", "register": "neutral", "situation": "comida", "tags": ["pagar", "propina"]},
    {"id": "a2-food.can-i-get-a-box", "text": "Can I get a box for this?", "es": "¿Me pone esto para llevar?", "notes": "Llevarse las sobras es lo normal en EE. UU.", "explanation": "Si sobra comida: te dan una caja para llevártela. «box» suena BAKS, con «a».", "register": "neutral", "situation": "comida", "tags": ["restaurante"]},
    {"id": "a2-food.do-i-order-here", "text": "Do I order here?", "es": "¿Se pide aquí?", "explanation": "Si no sabes si te atienden en la mesa o en el mostrador. «order» suena OR-dər.", "register": "neutral", "situation": "comida", "tags": ["comida-rapida"]},
    {"id": "a2-food.ill-have-a-number-three", "text": "I'll have a number three.", "es": "Quiero el menú número tres.", "notes": "«Combo» o «meal» es el menú: plato, patatas y bebida.", "explanation": "En comida rápida los menús van numerados. «three» con «th»: THRII, no «tri».", "register": "neutral", "situation": "comida", "tags": ["comida-rapida"]},
    {"id": "a2-food.combo-with-a-coke", "text": "Can I get the combo with a Coke?", "es": "¿Me pone el menú con una Coca-Cola?", "explanation": "Para pedir la versión con patatas y bebida. «combo» suena KAM-bou.", "register": "neutral", "situation": "comida", "tags": ["comida-rapida"]},
    {"id": "a2-food.a-large-please", "text": "A large, please.", "es": "Grande, por favor.", "explanation": "Cuando te preguntan el tamaño: small, medium o large. «large» suena LAARCH, con la «r» americana.", "register": "neutral", "situation": "comida", "tags": ["comida-rapida"]},
