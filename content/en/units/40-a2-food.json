  "qa": [
    {"id": "a2-food.qa.what-can-i-get-you", "question": "Hi! What can I get you?", "questionEs": "¡Hola! ¿Qué te pongo?", "accepted": [{"text": "Can I get a medium latte?", "es": "¿Me pones un latte mediano?"}, {"text": "A small coffee, please.", "es": "Un café pequeño, por favor."}], "distractors": [{"text": "I'm good, thanks.", "es": "Estoy bien, gracias."}, {"text": "For here, please.", "es": "Para tomar aquí, por favor."}], "register": "neutral", "situation": "comida", "notes": "Te preguntan qué quieres tomar: pide directamente con «Can I get…?» o con el nombre de la bebida.", "voice": "en-US-AvaNeural"},
    {"id": "a2-food.qa.for-here-or-to-go", "question": "For here or to go?", "questionEs": "¿Para tomar aquí o para llevar?", "accepted": [{"text": "To go, please.", "es": "Para llevar, por favor."}, {"text": "For here, please.", "es": "Para tomar aquí, por favor."}], "distractors": [{"text": "Yes, please.", "es": "Sí, por favor."}, {"text": "I'm going home.", "es": "Me voy a casa."}], "register": "neutral", "situation": "comida", "notes": "Es una elección entre dos: responde con una de las dos, no con «yes».", "voice": "en-US-AndrewNeural"},
    {"id": "a2-food.qa.how-many", "question": "How many in your party?", "questionEs": "¿Cuántos sois?", "accepted": [{"text": "Two, please.", "es": "Dos, por favor."}, {"text": "Just one.", "es": "Solo uno."}], "distractors": [{"text": "Yes, it's a party.", "es": "Sí, es una fiesta."}, {"text": "At seven o'clock.", "es": "A las siete."}], "register": "neutral", "situation": "comida", "notes": "«Party» aquí es tu grupo de comensales: di cuántos sois.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-food.qa.ready-to-order", "question": "Are you ready to order?", "questionEs": "¿Ya saben qué van a pedir?", "accepted": [{"text": "Yes, I'll have the burger, please.", "es": "Sí, para mí la hamburguesa, por favor."}, {"text": "We need a few more minutes.", "es": "Necesitamos unos minutos más."}], "distractors": [{"text": "Yes, I'm ready to go.", "es": "Sí, estoy listo para irme."}, {"text": "No, thanks, I'm full.", "es": "No, gracias, estoy lleno."}], "register": "neutral", "situation": "comida", "notes": "Pide tu plato con «I'll have…» o pide más tiempo.", "voice": "en-US-BrianNeural"},
    {"id": "a2-food.qa.how-would-you-like-it", "question": "How would you like your steak?", "questionEs": "¿Cómo quiere el filete?", "accepted": [{"text": "Medium rare, please.", "es": "Poco hecho, por favor."}, {"text": "Well done, please.", "es": "Muy hecho, por favor."}], "distractors": [{"text": "Very good, thank you.", "es": "Muy bien, gracias."}, {"text": "Yes, I like it.", "es": "Sí, me gusta."}], "register": "neutral", "situation": "comida", "notes": "Te preguntan el punto de la carne: rare, medium o well done.", "voice": "en-US-AvaNeural"},
    {"id": "a2-food.qa.something-to-drink", "question": "Can I get you something to drink?", "questionEs": "¿Le traigo algo de beber?", "accepted": [{"text": "Just water, thanks.", "es": "Solo agua, gracias."}, {"text": "A soda, please.", "es": "Un refresco, por favor."}], "distractors": [{"text": "I'm not hungry.", "es": "No tengo hambre."}, {"text": "Yes, I can.", "es": "Sí, puedo."}], "register": "neutral", "situation": "comida", "notes": "Te ofrecen bebida: di cuál quieres.", "voice": "en-US-AndrewNeural"},
    {"id": "a2-food.qa.any-allergies", "question": "Any allergies I should know about?", "questionEs": "¿Alguna alergia que deba saber?", "accepted": [{"text": "Yes, I'm allergic to nuts.", "es": "Sí, soy alérgico a los frutos secos."}, {"text": "No, none.", "es": "No, ninguna."}], "distractors": [{"text": "Yes, I know.", "es": "Sí, lo sé."}, {"text": "No, I'm not hungry.", "es": "No, no tengo hambre."}], "register": "neutral", "situation": "comida", "notes": "Di a qué eres alérgico, o que no tienes ninguna alergia.", "voice": "en-US-EmmaNeural"},
    {"id": "a2-food.qa.how-is-everything", "question": "How is everything?", "questionEs": "¿Qué tal todo?", "accepted": [{"text": "Everything's great, thanks.", "es": "Todo está muy bueno, gracias."}, {"text": "This is delicious!", "es": "¡Esto está buenísimo!"}], "distractors": [{"text": "I'm fine, and you?", "es": "Bien, ¿y tú?"}, {"text": "Everything, please.", "es": "Todo, por favor."}], "register": "neutral", "situation": "comida", "notes": "El camarero pregunta por la comida, no por ti: di qué tal está.", "voice": "en-US-BrianNeural"},
    {"id": "a2-food.qa.together-or-separate", "question": "Will that be together or separate?", "questionEs": "¿Juntos o por separado?", "accepted": [{"text": "Separate, please.", "es": "Por separado, por favor."}, {"text": "Together, please.", "es": "Junto, por favor."}], "distractors": [{"text": "Yes, please.", "es": "Sí, por favor."}, {"text": "It's for here.", "es": "Es para tomar aquí."}], "register": "neutral", "situation": "comida", "notes": "Te preguntan si pagáis todo junto o cada uno lo suyo.", "voice": "en-US-AvaNeural"},
    {"id": "a2-food.qa.what-size", "question": "What size would you like?", "questionEs": "¿De qué tamaño lo quiere?", "accepted": [{"text": "A large, please.", "es": "Grande, por favor."}, {"text": "Medium, please.", "es": "Mediano, por favor."}], "distractors": [{"text": "A number three.", "es": "El número tres."}, {"text": "Yes, a big one is.", "es": "Sí, uno grande es."}], "register": "neutral", "situation": "comida", "notes": "Elige tamaño: small, medium o large.", "voice": "en-US-AndrewNeural"}
