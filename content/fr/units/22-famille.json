  "phrases": [
    { "id": "famille.tu-as-des-freres-et-soeurs", "text": "Tu as des frères et sœurs?", "es": "¿Tienes hermanos?", "literal": "¿Tienes hermanos y hermanas?", "explanation": "Entre amigos, cuando empezáis a conoceros. «frères» y «sœurs» suenan «frer» y «sör», con la «s» final muda: tü a dé FRER é SÖR?", "register": "tu", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.jai-un-frere-et-une-soeur", "text": "J'ai un frère et une sœur.", "es": "Tengo un hermano y una hermana.", "explanation": "Para responder a «Tu as des frères et sœurs?». «sœur» se dice con labios redondos, como una «e» con morritos: SÖR.", "register": "neutral", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.je-suis-fils-unique", "text": "Je suis fils unique.", "es": "Soy hijo único.", "notes": "Si eres mujer: «Je suis fille unique».", "explanation": "Si no tienes hermanos. En «fils» la «l» no suena y la «s» sí: FIS ü-NIK.", "register": "neutral", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.mes-parents-habitent-a-madrid", "text": "Mes parents habitent à Madrid.", "es": "Mis padres viven en Madrid.", "notes": "«Parents» son los padres; los parientes son «la famille».", "explanation": "Al hablar de tu familia. La terminación «-ent» de «habitent» no suena: mé pa-RAN a-BIT a ma-DRI.", "register": "neutral", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.cest-ma-mere-sur-la-photo", "text": "Regarde, c'est ma mère sur la photo.", "es": "Mira, esta de la foto es mi madre.", "explanation": "Al enseñar fotos en el móvil a un amigo. «Regarde» suena «r'GARD» y «mère», «mer»: se ma MER.", "register": "tu", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.ma-grand-mere-a-quatre-vingt-dix-ans", "text": "Ma grand-mère a quatre-vingt-dix ans.", "es": "Mi abuela tiene noventa años.", "notes": "La edad va con «avoir»: «elle a 90 ans».", "explanation": "Para hablar de tus abuelos. «grand» es nasal y la «d» no suena: gran-MER a ka-tr'van-DI-ZAN.", "register": "neutral", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.ma-famille-me-manque", "text": "Ma famille me manque.", "es": "Echo de menos a mi familia.", "literal": "Mi familia me falta.", "notes": "Al revés que en español: lo que echas de menos es el sujeto.", "explanation": "Cuando vives lejos de casa. «manque» es nasal: ma fa-MIY m'MANK.", "register": "neutral", "situation": "familia", "tags": ["familia"] },
    { "id": "famille.tu-es-marie", "text": "Tu es marié?", "es": "¿Estás casado?", "notes": "A una mujer: «Tu es mariée?», que suena igual.", "explanation": "Entre amigos o compañeros de confianza. «es» suena «e»: tü E ma-RIÉ?", "register": "tu", "situation": "familia", "tags": ["pareja"] },
    { "id": "famille.je-suis-marie", "text": "Oui, je suis marié.", "es": "Sí, estoy casado.", "notes": "Si eres mujer, «mariée»: suena igual.", "explanation": "Para responder sobre tu pareja. «marié» acaba en «é» cerrada: ma-RIÉ.", "register": "neutral", "situation": "familia", "tags": ["pareja"] },
    { "id": "famille.je-suis-celibataire", "text": "Non, je suis célibataire.", "es": "No, estoy soltero.", "notes": "Igual para hombre y mujer.", "explanation": "Si no tienes pareja. Acento al final, como siempre en francés: sé-li-ba-TER.", "register": "neutral", "situation": "familia", "tags": ["pareja"] },
    { "id": "famille.ma-copine-sappelle-laura", "text": "Ma copine s'appelle Laura.", "es": "Mi novia se llama Laura.", "notes": "«Ma copine» puede ser «mi novia» o «mi amiga»: el contexto lo aclara.", "explanation": "Al hablar de tu pareja con amigos. «copine» suena «ko-PIN», sin nasal porque va seguida de vocal.", "register": "neutral", "situation": "familia", "tags": ["pareja"] },
    { "id": "famille.vous-avez-des-enfants", "text": "Vous avez des enfants?", "es": "¿Tiene hijos?", "explanation": "Te lo preguntará un vecino o alguien mayor. Dos ligaduras: vu-za-VÉ dé-zan-FAN?", "register": "vous", "situation": "familia", "tags": ["hijos", "registro"] },
    { "id": "famille.jai-deux-enfants", "text": "J'ai deux enfants, un garçon et une fille.", "es": "Tengo dos hijos, un niño y una niña.", "explanation": "Para hablar de tus hijos. Liga «deux‿enfants» con «z»: dö-zan-FAN; «garçon» suena «gar-SON».", "register": "neutral", "situation": "familia", "tags": ["hijos"] },
    { "id": "famille.je-nai-pas-denfants", "text": "Non, je n'ai pas d'enfants.", "es": "No, no tengo hijos.", "notes": "Tras una negación, «des» pasa a «de»: «pas d'enfants».", "explanation": "Para responder que no tienes hijos. «n'ai» suena «ne» y todo va de seguido: sh'ne pa dan-FAN.", "register": "neutral", "situation": "familia", "tags": ["hijos"] },
    { "id": "famille.ma-soeur-attend-un-bebe", "text": "Ma sœur attend un bébé.", "es": "Mi hermana está esperando un bebé.", "explanation": "Para dar una buena noticia de la familia. «attend» es nasal y la «d» no suena: a-TAN an bé-BÉ.", "register": "neutral", "situation": "familia", "tags": ["hijos"] },
    { "id": "famille.je-te-presente-pablo", "text": "Je te présente mon ami Pablo.", "es": "Te presento a mi amigo Pablo.", "notes": "Sin «a» delante de la persona: «je te présente Pablo».", "explanation": "Para presentar a un amigo a otro. Liga «mon‿ami»: mo-na-MI PA-blo.", "register": "tu", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.je-vous-presente-ma-collegue", "text": "Je vous présente ma collègue, Camille.", "es": "Le presento a mi compañera, Camille.", "explanation": "En el trabajo o con alguien a quien tratas de usted. «Camille» suena «ka-MIY», con «ll» como «y».", "register": "vous", "situation": "familia", "tags": ["amigos", "registro"] },
    { "id": "famille.voici-julien-mon-coloc", "text": "Voici Julien, mon coloc.", "es": "Este es Julien, mi compañero de piso.", "notes": "«Coloc» es la forma corta y coloquial de «colocataire».", "explanation": "Para presentar a alguien que está contigo. «Voici» suena «vua-SI» y «Julien», «shü-LIAN».", "register": "neutral", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.tu-connais-julien", "text": "Tu connais Julien?", "es": "¿Conoces a Julien?", "notes": "Sin «a» delante de la persona: «connaître quelqu'un».", "explanation": "Antes de presentar a dos amigos. «connais» suena «ko-NE»: tü ko-NE shü-LIAN?", "register": "tu", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.ma-voisine-est-tres-sympa", "text": "Ma voisine est très sympa.", "es": "Mi vecina es muy maja.", "explanation": "Al hablar de la gente de tu edificio. «sympa» empieza nasal: san-PA; «voisine» suena «vua-ZIN».", "register": "neutral", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.on-se-connait-depuis-lecole", "text": "On se connaît depuis l'école.", "es": "Nos conocemos desde el colegio.", "notes": "«On» es «nosotros» en la lengua hablada; el verbo va como con «il».", "explanation": "Al contar de qué conoces a un amigo. «On» es nasal: on s'ko-NE d'püi lé-KOL.", "register": "neutral", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.cest-mon-meilleur-ami", "text": "C'est mon meilleur ami.", "es": "Es mi mejor amigo.", "notes": "Para una amiga: «C'est ma meilleure amie».", "explanation": "Para presentar a tu mejor amigo. «meilleur» suena «me-IÖR»: se mon me-iö-ra-MI.", "register": "neutral", "situation": "familia", "tags": ["amigos"] },
    { "id": "famille.il-est-comment-ton-frere", "text": "Il est comment, ton frère?", "es": "¿Cómo es tu hermano?", "notes": "Hablando, la persona va al final; para una chica: «Elle est comment?».", "explanation": "Para pedir que te describan a alguien. Liga «il‿est»: i-le ko-MAN, ton FRER?", "register": "tu", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-est-grand-et-brun", "text": "Il est grand et brun.", "es": "Es alto y moreno.", "notes": "«Grand» es alto, no «grande»; «brun» es de pelo oscuro.", "explanation": "Para describir a alguien. «grand» y «brun» son nasales y sin consonante final: il e GRAN e BRAN.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.elle-est-petite-et-blonde", "text": "Elle est petite et blonde.", "es": "Es bajita y rubia.", "notes": "En femenino suena la consonante final: «petite», «blonde».", "explanation": "Para describir a una mujer o una niña. Aquí la «t» y la «d» finales sí suenan: p'TIT e BLOND.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-a-les-cheveux-courts", "text": "Il a les cheveux courts.", "es": "Tiene el pelo corto.", "notes": "«Cheveux» va en plural: los pelos de la cabeza.", "explanation": "Para describir el pelo. «cheveux» suena «sh'VÖ» y «courts», «kur»: il a lé sh'vö KUR.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.elle-a-les-yeux-bleus", "text": "Elle a les yeux bleus.", "es": "Tiene los ojos azules.", "explanation": "Para describir los ojos. Liga «les‿yeux»: lé-ZIÖ, y «bleus» suena «blö».", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-porte-des-lunettes", "text": "Il porte des lunettes.", "es": "Lleva gafas.", "notes": "«Porter» = llevar puesto (gafas, ropa, barba).", "explanation": "Para dar un detalle fácil de reconocer. «lunettes» con «u» francesa: lü-NET.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-a-une-barbe", "text": "Il a une barbe.", "es": "Tiene barba.", "explanation": "Para describir a un hombre. Liga «a‿une» de un tirón: i-la-ün BARB.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-ressemble-a-son-pere", "text": "Il ressemble beaucoup à son père.", "es": "Se parece mucho a su padre.", "explanation": "Al ver a alguien con su familia o en una foto. «ressemble» suena «r'SANBL», nasal: r'sanbl bo-KU a son PER.", "register": "neutral", "situation": "familia", "tags": ["describir"] },
    { "id": "famille.il-est-sympa-ton-frere", "text": "Il est sympa, ton frère!", "es": "¡Qué majo es tu hermano!", "literal": "Es majo, tu hermano.", "explanation": "Para decirle algo bonito a un amigo sobre alguien de su familia. «sympa» es nasal: i-le san-PA.", "register": "tu", "situation": "familia", "tags": ["describir", "caracter"] },
    { "id": "famille.elle-est-tres-gentille", "text": "Ma mère est très gentille.", "es": "Mi madre es muy buena.", "literal": "Mi madre es muy amable.", "notes": "«Gentil» es amable, buena persona; no «gentil» en sentido español.", "explanation": "Para hablar bien de alguien. En femenino, «-ille» suena «iy»: shan-TIY.", "register": "neutral", "situation": "familia", "tags": ["caracter"] },
    { "id": "famille.elle-est-drole-et-bavarde", "text": "Elle est drôle et très bavarde.", "es": "Es graciosa y muy habladora.", "explanation": "Para describir el carácter de una amiga. «drôle» suena «drol», con «o» cerrada; «bavarde», «ba-VARD».", "register": "neutral", "situation": "familia", "tags": ["caracter"] },
    { "id": "famille.il-est-un-peu-timide", "text": "Il est un peu timide.", "es": "Es un poco tímido.", "explanation": "Para describir a alguien callado. «timide» suena «ti-MID», con acento al final.", "register": "neutral", "situation": "familia", "tags": ["caracter"] },
    { "id": "famille.tu-tentends-bien-avec-ta-soeur", "text": "Tu t'entends bien avec ta sœur?", "es": "¿Te llevas bien con tu hermana?", "explanation": "Entre amigos, al hablar de familia. «t'entends» es nasal y sin la «ds»: tü tan-TAN BIAN?", "register": "tu", "situation": "familia", "tags": ["caracter"] },
    { "id": "famille.on-sentend-tres-bien", "text": "Oui, on s'entend très bien.", "es": "Sí, nos llevamos muy bien.", "explanation": "Para responder que te llevas bien con alguien. «on s'entend» son dos nasales: on san-TAN tre BIAN.", "register": "neutral", "situation": "familia", "tags": ["caracter"] }
  ],
