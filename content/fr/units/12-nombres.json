  "phrases": [
    { "id": "nombres.deux-personnes", "text": "Deux personnes, s'il vous plaît.", "es": "Dos personas, por favor.", "notes": "Al entrar en un restaurante o pedir entradas.", "explanation": "Al camarero que te recibe en la puerta del restaurante. «deux» se dice con labios redondos, «dö», y la «x» no suena: dö per-SON.", "register": "vous", "situation": "numeros", "tags": ["numero"] },
    { "id": "nombres.tu-as-quel-age", "text": "Tu as quel âge?", "es": "¿Cuántos años tienes?", "literal": "¿Tienes qué edad?", "notes": "Con «vous» es delicado: no se pregunta la edad a un desconocido.", "explanation": "A un amigo, un compañero o un niño. «quel âge» va ligado: ke-LASH, con «sh» sonora.", "register": "tu", "situation": "numeros", "tags": ["edad"] },
    { "id": "nombres.jai-trente-deux-ans", "text": "J'ai trente-deux ans.", "es": "Tengo treinta y dos años.", "notes": "La edad va con «avoir» (tener), nunca con «être».", "explanation": "Para decir tu edad. «deux‿ans» se liga con una «z»: trant-dö-ZAN.", "register": "neutral", "situation": "numeros", "tags": ["edad"] },
    { "id": "nombres.cest-quoi-ton-numero", "text": "C'est quoi, ton numéro?", "es": "¿Cuál es tu número?", "explanation": "A un amigo o compañero para pedirle el móvil. «ton» es nasal y «numéro» lleva la «u» francesa: ton nü-mé-RO.", "register": "tu", "situation": "numeros", "tags": ["telefono"] },
    { "id": "nombres.mon-numero", "text": "C'est le zéro six, douze, trente-quatre, cinquante-six…", "es": "Es el cero seis, doce, treinta y cuatro, cincuenta y seis…", "notes": "En Francia el teléfono se dice de dos en dos cifras.", "explanation": "Al dar tu móvil: cifras de dos en dos (06 12 34 56…). «zéro» empieza con «z» zumbada: zé-RO sis.", "register": "neutral", "situation": "numeros", "tags": ["telefono"] },
    { "id": "nombres.cest-combien", "text": "C'est combien?", "es": "¿Cuánto es?", "explanation": "Señalando algo en el mercado o en una tienda. «com» y «bien» son nasales: se kom-BIAN?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.ca-coute-combien", "text": "Ça coûte combien?", "es": "¿Cuánto cuesta?", "explanation": "Para preguntar el precio de una cosa concreta. «coûte» suena «kut»: sa kut kom-BIAN?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.ca-fait-combien", "text": "Ça fait combien?", "es": "¿Cuánto es en total?", "notes": "Para la cuenta: «ça fait» = suma, hace.", "explanation": "Al final de la compra, cuando vas a pagar. «fait» suena «fe»: sa fe kom-BIAN?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.ca-fait-soixante-quinze", "text": "Ça fait soixante-quinze euros.", "es": "Son setenta y cinco euros.", "literal": "Eso hace sesenta-quince euros.", "notes": "75 = 60 + 15.", "explanation": "Lo que te dirá el cajero. «soixante» suena «suasant» y «quinze» es nasal: suasant-KANZ ö-RO.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "numero"] },
    { "id": "nombres.deux-euros-cinquante", "text": "Deux euros cinquante.", "es": "Dos euros con cincuenta.", "notes": "Los céntimos van detrás, sin «et»: como nuestro «dos cincuenta».", "explanation": "Precios del pan o del café. «deux‿euros» se liga con «z»: dö-zö-RO san-KANT.", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.quatre-vingt-dix-neuf-centimes", "text": "Quatre-vingt-dix-neuf centimes.", "es": "Noventa y nueve céntimos.", "literal": "Cuatro-veinte-diez-nueve céntimos.", "notes": "99 = 4 × 20 + 19.", "explanation": "El precio típico de oferta. Dilo por bloques: katr-van / dis-NÖF / san-TIM.", "register": "neutral", "situation": "numeros", "tags": ["pagar", "numero"] },
    { "id": "nombres.je-peux-payer-par-carte", "text": "Je peux payer par carte?", "es": "¿Puedo pagar con tarjeta?", "notes": "En francés se paga «par carte», no «avec».", "explanation": "Antes de pagar en una tienda pequeña o en el mercado. «payer» suena «pe-YÉ»: sh'pö pe-YÉ par KART?", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.en-especes", "text": "En espèces.", "es": "En efectivo.", "notes": "También se oye «en liquide».", "explanation": "Para responder cuando te preguntan cómo pagas. Se liga «en‿espèces»: an-nes-PES.", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.cest-un-peu-cher", "text": "C'est un peu cher.", "es": "Es un poco caro.", "explanation": "En el mercado o una tienda, cuando el precio te parece alto. «ch» suena «sh» y la «r» final sí suena: se-tan-pö SHER.", "register": "neutral", "situation": "numeros", "tags": ["pagar"] },
    { "id": "nombres.vous-avez-lheure", "text": "Excusez-moi, vous avez l'heure?", "es": "Perdone, ¿tiene hora?", "explanation": "Para preguntar la hora a un desconocido por la calle. «vous‿avez» se liga con «z»: vu-za-VÉ LÖR.", "register": "vous", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.il-est-quelle-heure", "text": "Il est quelle heure?", "es": "¿Qué hora es?", "notes": "Hablando se dice así; por escrito, «Quelle heure est-il?».", "explanation": "A un amigo o a quien tengas al lado. «quelle heure» va ligado: i-le ke-LÖR?", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.il-est-trois-heures", "text": "Il est trois heures.", "es": "Son las tres.", "literal": "Es tres horas.", "notes": "Siempre en singular «il est» y siempre con «heures».", "explanation": "Para decir la hora. «trois‿heures» se liga con «z»: i-le trua-ZÖR.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.huit-heures-et-demie", "text": "Il est huit heures et demie.", "es": "Son las ocho y media.", "explanation": "Para la hora y media. «huit‿heures» se liga con «t»: ui-TÖR e d'MI.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.dix-heures-moins-le-quart", "text": "Il est dix heures moins le quart.", "es": "Son las diez menos cuarto.", "notes": "«et quart» = y cuarto; «moins le quart» = menos cuarto.", "explanation": "Para el cuarto antes de la hora. «dix‿heures» se liga con «z»: di-ZÖR muan l'KAR.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.il-est-midi", "text": "Il est midi.", "es": "Son las doce del mediodía.", "explanation": "A las 12 h se dice «midi», no «douze heures». Se dice tal cual: i-le mi-DI.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.ca-ouvre-a-quelle-heure", "text": "Ça ouvre à quelle heure?", "es": "¿A qué hora abre?", "explanation": "Delante de una tienda, un museo o la farmacia. «ouvre» suena «uvr»: sa UVR a ke-LÖR?", "register": "neutral", "situation": "numeros", "tags": ["hora", "horarios"] },
    { "id": "nombres.ca-ferme-a-dix-neuf-heures", "text": "Ça ferme à dix-neuf heures.", "es": "Cierra a las siete de la tarde.", "literal": "Cierra a las diecinueve horas.", "notes": "Los horarios oficiales van en formato de 24 h.", "explanation": "Lo leerás en carteles y lo oirás en tiendas. «neuf heures» se liga con «v»: diz-nö-VÖR.", "register": "neutral", "situation": "numeros", "tags": ["hora", "horarios"] },
    { "id": "nombres.je-suis-en-retard", "text": "Je suis en retard, désolé!", "es": "¡Llego tarde, lo siento!", "explanation": "Al llegar tarde a una cita o mandar un mensaje. «en‿retard» se dice seguido: sh'swi-zan r'-TAR.", "register": "neutral", "situation": "numeros", "tags": ["hora"] },
    { "id": "nombres.a-tout-a-lheure", "text": "À tout à l'heure!", "es": "¡Hasta luego! (hoy mismo)", "notes": "Solo si os vais a ver otra vez el mismo día.", "explanation": "Al despedirte de alguien que verás en unas horas. «tout‿à» se liga con «t»: a-tu-ta-LÖR.", "register": "neutral", "situation": "numeros", "tags": ["hora", "despedida"] },
    { "id": "nombres.on-est-quel-jour", "text": "On est quel jour, aujourd'hui?", "es": "¿Qué día es hoy?", "literal": "¿Estamos qué día hoy?", "explanation": "Cuando pierdes la cuenta de los días. «aujourd'hui» se dice o-shur-DÜI, con «j» de «y» argentina.", "register": "neutral", "situation": "numeros", "tags": ["dias"] },
    { "id": "nombres.on-est-mardi", "text": "On est mardi.", "es": "Hoy es martes.", "literal": "Estamos martes.", "explanation": "Para responder qué día es. «On‿est» se liga con «n»: o-NE mar-DI.", "register": "neutral", "situation": "numeros", "tags": ["dias"] },
    { "id": "nombres.ferme-le-dimanche", "text": "Le magasin est fermé le dimanche.", "es": "La tienda cierra los domingos.", "notes": "«le» + día = todos los (lunes, domingos…); sin artículo = ese día concreto.", "explanation": "Muy útil: en Francia muchas tiendas cierran el domingo. «dimanche» es nasal: di-MANSH.", "register": "neutral", "situation": "numeros", "tags": ["dias", "horarios"] },
    { "id": "nombres.a-lundi", "text": "À lundi!", "es": "¡Hasta el lunes!", "explanation": "Al despedirte de compañeros el viernes. «lun» es nasal, casi «lan»: a lan-DI.", "register": "neutral", "situation": "numeros", "tags": ["dias", "despedida"] },
    { "id": "nombres.cest-le-quatorze-juillet", "text": "Aujourd'hui, c'est le quatorze juillet.", "es": "Hoy es catorce de julio.", "notes": "Fecha = «le» + número + mes, sin «de». El 14 de julio es la fiesta nacional.", "explanation": "Para decir la fecha. «juillet» suena «shüi-YÉ», con «j» de «y» argentina: ka-TORZ shüi-YÉ.", "register": "neutral", "situation": "numeros", "tags": ["fechas"] },
    { "id": "nombres.le-premier-janvier", "text": "Le premier janvier.", "es": "El uno de enero.", "notes": "El día 1 se dice «premier» (primero); los demás, con el número normal.", "explanation": "Para el primer día de cada mes. «premier» acaba en «-mié» y «janvier» empieza nasal: l'pr'-MIÉ shan-VIÉ.", "register": "neutral", "situation": "numeros", "tags": ["fechas"] },
    { "id": "nombres.mon-anniversaire", "text": "Mon anniversaire, c'est le douze mars.", "es": "Mi cumpleaños es el doce de marzo.", "notes": "En «mars» la «s» sí suena.", "explanation": "Para decir cuándo es tu cumpleaños. Liga «mon‿anniversaire»: mo-na-ni-ver-SER, y «mars» suena MARS.", "register": "neutral", "situation": "numeros", "tags": ["fechas"] }
  ],
