    { "id": "nombres.soixante-dix", "word": "soixante-dix", "es": "setenta", "notes": "70 = 60 + 10. En Bélgica y Suiza dicen «septante».", "situation": "numeros", "tags": ["numero"] },
    { "id": "nombres.soixante-et-onze", "word": "soixante et onze", "es": "setenta y uno", "notes": "71 = 60 + 11. Sigue igual: 72 = soixante-douze, 79 = soixante-dix-neuf.", "situation": "numeros", "tags": ["numero"] },
    { "id": "nombres.soixante-quinze", "word": "soixante-quinze", "es": "setenta y cinco", "notes": "75 = 60 + 15.", "example": "nombres.ca-fait-soixante-quinze", "situation": "numeros", "tags": ["numero"] },
    { "id": "nombres.quatre-vingts", "word": "quatre-vingts", "es": "ochenta", "notes": "80 = 4 × 20. Solo el 80 redondo lleva «s».", "situation": "numeros", "tags": ["numero"] },
    { "id": "nombres.quatre-vingt-un", "word": "quatre-vingt-un", "es": "ochenta y uno", "notes": "Aquí sin «et» ni «s». La «t» de «vingt» no suena: «katr-van-AN».", "situation": "numeros", "tags": ["numero"] },
