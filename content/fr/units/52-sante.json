    { "id": "sante.bras", "word": "bras", "article": "le", "gender": "m", "plural": "bras", "es": "el brazo", "notes": "La «s» no suena: «bra».", "situation": "salud", "tags": ["cuerpo"], "image": "fluent:flexed-biceps" },
    { "id": "sante.main", "word": "main", "article": "la", "gender": "f", "plural": "mains", "es": "la mano", "notes": "Nasal: suena «man».", "situation": "salud", "tags": ["cuerpo"], "image": "fluent:raised-hand" },
