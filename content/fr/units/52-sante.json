    { "id": "sante.rhume", "word": "rhume", "article": "le", "gender": "m", "plural": "rhumes", "es": "el resfriado", "notes": "«Je suis enrhumé» = estoy resfriado.", "situation": "salud", "tags": ["enfermedad"], "image": "fluent:sneezing-face" },
    { "id": "sante.toux", "word": "toux", "article": "la", "gender": "f", "plural": "toux", "es": "la tos", "notes": "La «x» no suena: «tu».", "situation": "salud", "tags": ["enfermedad"] },
