  "phrases": [
    { "id": "courses.il-faut-faire-les-courses", "text": "Il faut faire les courses.", "es": "Hay que hacer la compra.", "notes": "«Faire les courses» es hacer la compra; ir de tiendas es «faire du shopping».", "explanation": "En casa, organizando la semana. «courses» suena KURS, con la «r» en la garganta.", "register": "neutral", "situation": "compras", "tags": ["supermarche"] },
    { "id": "courses.on-na-plus-de-lait", "text": "On n'a plus de lait.", "es": "No nos queda leche.", "literal": "No tenemos más leche.", "notes": "«On» por «nosotros», muy habitual al hablar.", "explanation": "Mirando la nevera con tu compañero de piso. «plus» suena PLÜ, sin «s»: o-na PLÜ de LE.", "register": "neutral", "situation": "compras", "tags": ["supermarche"] },
    { "id": "courses.ou-sont-les-oeufs", "text": "Pardon, où sont les œufs?", "es": "Perdone, ¿dónde están los huevos?", "explanation": "A un empleado del súper. En plural la «f» no suena y se liga: u son lé-ZÖ?", "register": "neutral", "situation": "compras", "tags": ["supermarche"] },
    { "id": "courses.cest-au-rayon-frais", "text": "C'est au rayon frais, au fond.", "es": "Está en la sección de frescos, al fondo.", "explanation": "Así te indican dónde está algo. «rayon» suena re-YON y «fond», FON, nasal y sin «d».", "register": "neutral", "situation": "compras", "tags": ["supermarche"], "voice": "fr-FR-HenriNeural" },
    { "id": "courses.vous-voulez-un-sac", "text": "Vous voulez un sac?", "es": "¿Quiere una bolsa?", "explanation": "Te lo preguntan en la caja; las bolsas se pagan. «voulez» suena vu-LÉ y «sac», SAK.", "register": "vous", "situation": "compras", "tags": ["supermarche"], "voice": "fr-FR-DeniseNeural" },
    { "id": "courses.non-merci-jai-mon-sac", "text": "Non merci, j'ai mon sac.", "es": "No, gracias, traigo mi bolsa.", "literal": "No, gracias, tengo mi bolsa.", "explanation": "En la caja, si llevas tu bolsa. «mon» es nasal: mon SAK.", "register": "neutral", "situation": "compras", "tags": ["supermarche"] },
    { "id": "courses.vous-avez-la-carte-du-magasin", "text": "Vous avez la carte du magasin?", "es": "¿Tiene la tarjeta de cliente?", "literal": "¿Tiene la tarjeta de la tienda?", "explanation": "Te lo preguntan en casi todas las cajas. «magasin» suena ma-ga-ZAN, nasal al final.", "register": "vous", "situation": "compras", "tags": ["supermarche"], "voice": "fr-FR-DeniseNeural" },
    { "id": "courses.vous-voulez-le-ticket", "text": "Vous voulez le ticket?", "es": "¿Quiere el tique?", "explanation": "En la caja, al pagar con tarjeta. «ticket» suena ti-KÉ, sin la «t» final.", "register": "vous", "situation": "compras", "tags": ["supermarche"], "voice": "fr-FR-DeniseNeural" },

    { "id": "courses.quest-ce-que-je-vous-mets", "text": "Qu'est-ce que je vous mets?", "es": "¿Qué le pongo?", "literal": "¿Qué le meto?", "explanation": "Lo dice el vendedor del mercado. Suena kes-ke-sh'vu MÉ?, sin la «t» de «mets».", "register": "vous", "situation": "compras", "tags": ["marche"], "voice": "fr-FR-HenriNeural" },
    { "id": "courses.un-kilo-de-pommes", "text": "Un kilo de pommes, s'il vous plaît.", "es": "Un kilo de manzanas, por favor.", "notes": "Tras una cantidad, solo «de»: «un kilo de pommes».", "explanation": "Así se pide por peso. «pommes» suena POM, sin la «es».", "register": "vous", "situation": "compras", "tags": ["marche"] },
    { "id": "courses.elles-sont-a-combien-les-fraises", "text": "Elles sont à combien, les fraises?", "es": "¿A cuánto están las fresas?", "explanation": "Para preguntar el precio en el puesto. «fraises» suena FREZ, con «s» sonora.", "register": "neutral", "situation": "compras", "tags": ["marche"] },
    { "id": "courses.trois-euros-la-barquette", "text": "Trois euros la barquette.", "es": "Tres euros la bandeja.", "explanation": "Así dicen los precios en el mercado. Se liga «trois‿euros»: trua-zö-RO la bar-KET.", "register": "neutral", "situation": "compras", "tags": ["marche"], "voice": "fr-FR-HenriNeural" },
    { "id": "courses.je-peux-gouter", "text": "Je peux goûter?", "es": "¿Puedo probar?", "explanation": "En el mercado suelen dejarte probar fruta o queso. «goûter» suena gu-TÉ.", "register": "neutral", "situation": "compras", "tags": ["marche"] },
    { "id": "courses.elles-sont-bien-mures", "text": "Elles sont bien mûres?", "es": "¿Están bien maduras?", "explanation": "Para elegir la fruta. «mûres» suena MÜR, con la «u» francesa.", "register": "neutral", "situation": "compras", "tags": ["marche"] },
    { "id": "courses.cest-bio", "text": "C'est bio?", "es": "¿Es ecológico?", "notes": "«Bio» es lo ecológico en Francia.", "explanation": "En el mercado o en el súper. Suena se BIO.", "register": "neutral", "situation": "compras", "tags": ["marche"] },

    { "id": "courses.quel-fromage-vous-me-conseillez", "text": "Quel fromage vous me conseillez?", "es": "¿Qué queso me recomienda?", "explanation": "En la quesería, donde te aconsejan encantados. «fromage» suena fro-MASH, con la «g» como la «y» argentina.", "register": "vous", "situation": "compras", "tags": ["fromagerie"] },
    { "id": "courses.deux-cents-grammes-de-comte", "text": "Deux cents grammes de comté, s'il vous plaît.", "es": "Doscientos gramos de comté, por favor.", "notes": "El comté es un queso curado muy popular.", "explanation": "Para pedir queso por peso. En «cents» no suenan ni la «t» ni la «s»: dö san GRAM.", "register": "vous", "situation": "compras", "tags": ["fromagerie"] },
    { "id": "courses.un-morceau-comme-ca", "text": "Un morceau comme ça?", "es": "¿Un trozo así?", "explanation": "El quesero te enseña con el cuchillo cuánto va a cortar. «morceau» suena mor-SO.", "register": "neutral", "situation": "compras", "tags": ["fromagerie"], "voice": "fr-FR-HenriNeural" },
    { "id": "courses.un-peu-moins", "text": "Un peu moins, s'il vous plaît.", "es": "Un poco menos, por favor.", "notes": "Un poco más: «un peu plus».", "explanation": "Para que corte un trozo más pequeño. «moins» es nasal: MUAN.", "register": "vous", "situation": "compras", "tags": ["fromagerie"] },
    { "id": "courses.vous-en-voulez-combien", "text": "Vous en voulez combien?", "es": "¿Cuánto quiere?", "explanation": "Te lo pregunta el dependiente. Se liga «vous‿en»: vu-zan vu-LÉ kom-BIAN?", "register": "vous", "situation": "compras", "tags": ["fromagerie"], "voice": "fr-FR-DeniseNeural" },
    { "id": "courses.quatre-tranches-de-jambon", "text": "Quatre tranches de jambon, s'il vous plaît.", "es": "Cuatro lonchas de jamón york, por favor.", "notes": "«Jambon» a secas es jamón cocido; el serrano es «jambon cru».", "explanation": "En la charcutería o en el mostrador del súper. «tranches» suena TRANSH, nasal.", "register": "vous", "situation": "compras", "tags": ["fromagerie"] },
    { "id": "courses.une-douzaine-doeufs", "text": "Une douzaine d'œufs, s'il vous plaît.", "es": "Una docena de huevos, por favor.", "notes": "«Un œuf» suena con «f»; «des œufs», sin ella.", "explanation": "Así se compran los huevos. «d'œufs» es una sílaba: DÖ.", "register": "vous", "situation": "compras", "tags": ["fromagerie"] },

    { "id": "courses.je-peux-vous-aider", "text": "Bonjour, je peux vous aider?", "es": "Hola, ¿le puedo ayudar?", "explanation": "Te lo dice el dependiente al entrar en una tienda. «aider» suena e-DÉ.", "register": "vous", "situation": "compras", "tags": ["vetements"], "voice": "fr-FR-EloiseNeural" },
    { "id": "courses.non-merci-je-regarde", "text": "Non merci, je regarde.", "es": "No, gracias, solo estoy mirando.", "literal": "No, gracias, miro.", "explanation": "Para mirar tranquilo sin que te atiendan. «regarde» suena re-GARD.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.je-cherche-un-pull", "text": "Je cherche un pull.", "es": "Busco un jersey.", "explanation": "Para decir qué buscas. «cherche» suena SHERSH y «pull», PÜL, con la «u» francesa.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.quelle-taille-faites-vous", "text": "Quelle taille faites-vous?", "es": "¿Qué talla tiene?", "literal": "¿Qué talla hace usted?", "explanation": "Te lo pregunta el dependiente. «taille» suena TAY.", "register": "vous", "situation": "compras", "tags": ["vetements"], "voice": "fr-FR-EloiseNeural" },
    { "id": "courses.je-fais-du-quarante", "text": "Je fais du quarante.", "es": "Tengo la cuarenta.", "literal": "Hago del cuarenta.", "notes": "Para la talla y el número de pie se usa «faire du».", "explanation": "Para decir tu talla o tu número. «quarante» suena ka-RANT.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.vous-faites-quelle-pointure", "text": "Vous faites quelle pointure?", "es": "¿Qué número calza?", "notes": "Para los zapatos es «pointure», no «taille».", "explanation": "Te lo preguntan en la zapatería. «pointure» suena puan-TÜR.", "register": "vous", "situation": "compras", "tags": ["vetements"], "voice": "fr-FR-EloiseNeural" },
    { "id": "courses.vous-lavez-en-noir", "text": "Vous l'avez en noir?", "es": "¿Lo tiene en negro?", "notes": "Otros colores: «en blanc», «en bleu», «en rouge».", "explanation": "Para pedir otro color. «noir» suena NUAR.", "register": "vous", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.cest-en-solde", "text": "C'est en solde?", "es": "¿Está rebajado?", "explanation": "Para preguntar si tiene descuento. Se liga «c'est‿en»: se-tan SOLD?", "register": "neutral", "situation": "compras", "tags": ["vetements"] },

    { "id": "courses.je-peux-lessayer", "text": "Je peux l'essayer?", "es": "¿Me lo puedo probar?", "explanation": "Con la prenda en la mano, al dependiente. «essayer» suena e-se-YÉ.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.ou-sont-les-cabines", "text": "Où sont les cabines d'essayage?", "es": "¿Dónde están los probadores?", "explanation": "En una tienda de ropa grande. «essayage» suena e-se-YASH.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.cest-trop-petit", "text": "C'est trop petit.", "es": "Me queda pequeño.", "literal": "Es demasiado pequeño.", "notes": "Grande: «c'est trop grand».", "explanation": "Al salir del probador. «trop» suena TRO, sin la «p».", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.vous-avez-la-taille-au-dessus", "text": "Vous avez la taille au-dessus?", "es": "¿Tiene una talla más?", "literal": "¿Tiene la talla de encima?", "notes": "Una talla menos: «la taille en dessous».", "explanation": "Si te queda pequeño. «dessus» suena de-SÜ.", "register": "vous", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.il-me-va-bien-ce-pull", "text": "Il me va bien, ce pull?", "es": "¿Me queda bien este jersey?", "notes": "«Quedar bien» es «aller bien»: «il me va».", "explanation": "Para preguntarle a quien te acompaña. Suena il me va BIAN, se PÜL?", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.il-te-va-tres-bien", "text": "Il te va très bien!", "es": "¡Te queda muy bien!", "explanation": "Para animar a un amigo en el probador. Suena il te va tre BIAN.", "register": "tu", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.je-le-prends", "text": "Je le prends.", "es": "Me lo llevo.", "literal": "Lo cojo.", "explanation": "Para decidir la compra. «prends» suena PRAN, nasal y sin «ds».", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.je-vais-reflechir", "text": "Je vais réfléchir.", "es": "Me lo voy a pensar.", "explanation": "La forma educada de irte sin comprar. «réfléchir» suena ré-flé-SHIR.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.je-peux-lechanger", "text": "Je peux l'échanger si ça ne va pas?", "es": "¿Lo puedo cambiar si no me queda bien?", "explanation": "Antes de pagar, por si acaso. «échanger» suena é-shan-SHÉ, la segunda «sh» sonora.", "register": "neutral", "situation": "compras", "tags": ["vetements"] },
    { "id": "courses.gardez-bien-le-ticket", "text": "Gardez bien le ticket.", "es": "Guarde bien el tique.", "explanation": "Te lo dicen en la caja para que puedas cambiarlo. «gardez» suena gar-DÉ.", "register": "vous", "situation": "compras", "tags": ["vetements"], "voice": "fr-FR-EloiseNeural" }
  ],
