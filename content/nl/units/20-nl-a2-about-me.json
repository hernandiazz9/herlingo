      "register": "u",
      "situation": "presentarse"
    },
    {
      "id": "nl-a2-about-me.mijn-achternaam-is-diaz",
      "text": "Mijn achternaam is Díaz.",
      "es": "Mi apellido es Díaz.",
      "notes": "En los formularios: «voornaam» (nombre) y «achternaam» (apellido).",
      "explanation": "Para dar tu apellido en una oficina. Después lo deletreas: «De, ie, aa, zet».",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
