      "id": "nl-a2-about-me.ik-ben-hernan",
      "text": "Hoi, ik ben Hernán.",
      "es": "Hola, soy Hernán.",
      "notes": "Los holandeses se presentan con el nombre de pila al dar la mano.",
      "explanation": "La forma más normal de presentarte, dando la mano. «ik» con «i» corta: joi, ik BEN er-NAN.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "nl-a2-about-me.ik-heet-hernan",
      "text": "Ik heet Hernán.",
      "es": "Me llamo Hernán.",
      "notes": "«heten» = llamarse; no es reflexivo: «ik heet», no «ik me heet».",
      "explanation": "Para decir tu nombre en una oficina o una clase. «heet» con «h» aspirada y «ee» larga: ik JEET.",
      "register": "neutral",
      "situation": "presentarse"
    },
    {
      "id": "nl-a2-about-me.hoe-heet-je",
      "text": "Hoe heet je?",
      "es": "¿Cómo te llamas?",
      "explanation": "A un compañero, un vecino o alguien en una fiesta. Suena ju JEET ye?",
      "register": "tu",
      "situation": "presentarse"
    },
    {
      "id": "nl-a2-about-me.hoe-heet-u",
      "text": "Hoe heet u?",
      "es": "¿Cómo se llama usted?",
      "explanation": "A una persona mayor o en una ventanilla. La «u» final, «i» con labios redondos: ju JEET Ü?",
      "register": "u",
      "situation": "presentarse"
    },
    {
      "id": "nl-a2-about-me.wat-is-uw-achternaam",
      "text": "Wat is uw achternaam?",
      "es": "¿Cuál es su apellido?",
