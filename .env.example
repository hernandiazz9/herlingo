# Liga (docs/league.md). Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both are public by design (inlined in the static build). Leave them empty and Liga is hidden.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local fake Supabase (npm run league:local, docs/league.md "Try it locally"):
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1sb2NhbCIsInJvbGUiOiJhbm9uIiwiaWF0IjoxNzU5Mjc2ODAwLCJleHAiOjIwNzQ2MzY4MDB9.FfEJQzIr-ouIQUV-QdqXK1uTVmzliNYK45h9VtsY77E

# Prepárate (AI coach) server settings. Copy to .env.local for `npm run dev:coach`;
# in production set them as Vercel environment variables. Never commit real values.
# See docs/coach.md.

# Anthropic API key. Empty in local dev = fake mode (canned data, no network).
ANTHROPIC_API_KEY=
# 1 = canned data for every endpoint, even with a key.
COACH_FAKE=

# Comma-separated name:code pairs, e.g. hernan:some-long-code,amigo:another-code
# (local dev defaults to hernan:dev-owner,invitado:dev-guest when empty).
COACH_ACCESS_CODES=
# Name of the entry above that may change the monthly cap.
COACH_OWNER=

# Spend ledger (Upstash Redis REST). Empty = in-memory ledger (lost on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: initial monthly cap in USD (default 5; the owner can change it from the app),
# generations per day per code (default 10; interview steps per day = 11 x this),
# voice lines per day per code (default 2000), quick routes (Modo rápido) per day per code
# (default 20; their own counter), time zone of days and months (default Europe/Madrid).
COACH_MONTHLY_CAP_USD=
COACH_DAILY_LIMIT=
COACH_TTS_DAILY_LIMIT=
COACH_ROUTE_DAILY_LIMIT=
COACH_TIMEZONE=
