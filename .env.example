# Prepárate (AI coach) server settings. Copy to .env.local for `npm run dev:coach`;
# in production set them as Vercel environment variables. Never commit real values.
# See docs/coach.md.

# Anthropic API key. Empty in local dev = fake mode (canned data, no network).
ANTHROPIC_API_KEY=
# 1 = canned data for every endpoint, even with a key.
COACH_FAKE=

# Comma-separated name:code pairs, e.g. hernan:some-long-code,amigo:another-code
# (local dev defaults to hernan:dev-owner,invitado:dev-guest when empty).
COACH_ACCESS_CODES=
# Name of the entry above that may change the monthly cap.
COACH_OWNER=

# Spend ledger (Upstash Redis REST). Empty = in-memory ledger (lost on restart).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: initial monthly cap in USD (default 5; the owner can change it from the app),
# generations per day per code (default 10), time zone of days and months (default Europe/Madrid).
COACH_MONTHLY_CAP_USD=
COACH_DAILY_LIMIT=
COACH_TIMEZONE=
