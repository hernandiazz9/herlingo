{
  "name": "lang-lern",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "predev": "npm run content:build",
    "dev": "next dev",
    "prebuild": "npm run content:build",
    "build": "next build",
    "postbuild": "tsx scripts/pwa/build.ts",
    "start": "tsx scripts/serve.ts",
    "lint": "eslint .",
    "pretypecheck": "npm run content:build",
    "typecheck": "next typegen && tsc --noEmit",
    "content:check": "tsx scripts/content.ts check",
    "content:build": "tsx scripts/content.ts build",
    "audio": "tsx scripts/audio/generate.ts",
    "images": "tsx scripts/images/generate.ts",
    "pwa:icons": "tsx scripts/pwa/icons.ts",
    "db:check": "tsx scripts/db/check.ts",
    "league:local": "tsx scripts/league-local/local.ts",
    "league:seed": "tsx scripts/league-local/seed.ts",
    "league:local:check": "tsx scripts/league-local/check.ts",
    "verify": "npm run lint && npm run content:check && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
